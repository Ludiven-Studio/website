---
// The site's menu, in the page's language. Wide screens show it in one row with the daily challenge (French pages),
// the language and the theme; narrower ones fold it under a button. It stays a <nav> right under .backgrounds:
// the games' fullscreen hides it by that selector.
import ThemeToggle from './ThemeToggle.astro';
import { getImage } from 'astro:assets';
import logo from '../assets/LudivenStudioLogo.png';
import { DAILY, HOME, LANGS, LANG_NAMES, NAV, type Lang, type NavLink } from '../data/siteNav';

interface Props {
	lang?: Lang;
	/** Every language version of the page. */
	alternates?: Partial<Record<Lang, string>> | undefined;
	/** The page in the other language, for two-language pages. */
	altLang?: string | undefined;
	/** The homepage: the stage starts right under the menu. */
	scene?: boolean;
}

const { lang = 'fr', alternates, altLang, scene = false } = Astro.props;
const t = NAV[lang];
const fr = lang === 'fr';
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const logoImg = await getImage({ src: logo, width: 160, format: 'webp' });

// Where each language goes: this page in that language, else that language's homepage.
const versions: Partial<Record<Lang, string>> =
	alternates ?? (altLang ? { [lang]: path, [lang === 'fr' ? 'en' : 'fr']: altLang } : { [lang]: path });
const langHref = (l: Lang): string => versions[l] ?? HOME[l];

const exact = (l: NavLink): boolean => !l.href.startsWith('mailto:') && path === l.href;
const lit = (l: NavLink): boolean => exact(l) || (!!l.also && l.also.test(path));
---

<nav class:list={['sn', { 'sn-scene': scene }]} aria-label={t.nav} data-sn>
	<div class="sn-bar">
		<a class="sn-brand" href={HOME[lang]}>
			<img src={logoImg.src} alt="" width="160" height="120" />
			<span class="sn-name">Ludiven Studio</span>
		</a>

		<ul class="sn-links">
			{
				t.links.map((l) => (
					<li>
						<a href={l.href} class:list={{ 'is-lit': lit(l) }} aria-current={exact(l) ? 'page' : undefined}>
							{l.label}
						</a>
					</li>
				))
			}
		</ul>

		<div class="sn-tools">
			{
				fr && (
					<a class="sn-daily" href={DAILY.href} data-daily aria-current={path === DAILY.href ? 'page' : undefined}>
						<svg class="sn-flame" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
							<path d="M12 3c1 3 4 5 4 9a4 4 0 0 1-8 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-5 0-8z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						<span class="sn-daily-label">{DAILY.label}</span>
						<span class="sn-streak" data-streak hidden></span>
					</a>
				)
			}

			<details class="sn-lang" data-lang>
				<summary aria-label={`${t.language} : ${LANG_NAMES[lang]}`}>
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
						<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" />
						<path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" fill="none" stroke="currentColor" stroke-width="1.8" />
					</svg>
					<span aria-hidden="true">{lang.toUpperCase()}</span>
				</summary>
				<ul class="sn-lang-list">
					{
						LANGS.map((l) => (
							<li>
								{l === lang ? (
									<span aria-current="true" lang={l}>
										{LANG_NAMES[l]}
									</span>
								) : (
									<a href={langHref(l)} hreflang={l} lang={l}>
										{LANG_NAMES[l]}
									</a>
								)}
							</li>
						))
					}
				</ul>
			</details>

			<span class="sn-theme"><ThemeToggle /></span>

			<button type="button" class="sn-menu" aria-expanded="false" aria-controls="sn-panel" data-menu hidden>
				<span class="sr-only">{t.menu}</span>
				<svg class="sn-open" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				</svg>
				<svg class="sn-close" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				</svg>
			</button>
		</div>
	</div>

	<div class="sn-panel" id="sn-panel" data-panel hidden>
		<ul class="sn-panel-links">
			{
				t.links.map((l, i) => (
					<>
						<li>
							<a href={l.href} class:list={{ 'is-lit': lit(l) }} aria-current={exact(l) ? 'page' : undefined}>
								{l.label}
							</a>
						</li>
						{fr && i === 1 && (
							<li>
								<a href={DAILY.href} class:list={['sn-panel-daily', { 'is-lit': path === DAILY.href }]} aria-current={path === DAILY.href ? 'page' : undefined}>
									{DAILY.label}
									<span class="sn-streak" data-streak hidden></span>
								</a>
							</li>
						)}
					</>
				))
			}
		</ul>
		<div class="sn-panel-foot">
			<ul class="sn-panel-langs" aria-label={t.language}>
				{
					LANGS.map((l) => (
						<li>
							{l === lang ? (
								<span aria-current="true" lang={l} title={LANG_NAMES[l]}>
									{l.toUpperCase()}
								</span>
							) : (
								<a href={langHref(l)} hreflang={l} lang={l} title={LANG_NAMES[l]} aria-label={LANG_NAMES[l]}>
									{l.toUpperCase()}
								</a>
							)}
						</li>
					))
				}
			</ul>
			<ThemeToggle />
		</div>
	</div>

	<noscript>
		<ul class="sn-noscript">
			{
				t.links.map((l) => (
					<li>
						<a href={l.href}>{l.label}</a>
					</li>
				))
			}
		</ul>
	</noscript>
</nav>

<script>
	import { globalStreak } from '../lib/streak';
	import { DAILY } from '../data/siteNav';

	// The daily streak, wherever the page shows it: the menu, its panel and the phone tab bar.
	const count = globalStreak().count;
	if (count > 0) {
		document.querySelectorAll<HTMLElement>('[data-streak]').forEach((el) => {
			el.textContent = DAILY.streak(count);
			el.hidden = false;
		});
		document.querySelectorAll<HTMLElement>('[data-streak-count]').forEach((el) => {
			el.textContent = String(count);
			el.hidden = false;
		});
		document.querySelectorAll<HTMLElement>('[data-daily]').forEach((el) => {
			el.dataset.alive = String(count);
			el.setAttribute('aria-label', DAILY.streakLabel(count));
		});
	}

	const nav = document.querySelector<HTMLElement>('[data-sn]');
	const button = nav?.querySelector<HTMLButtonElement>('[data-menu]');
	const panel = nav?.querySelector<HTMLElement>('[data-panel]');
	if (nav && button && panel) {
		const setOpen = (open: boolean): void => {
			button.setAttribute('aria-expanded', String(open));
			panel.hidden = !open;
		};
		button.hidden = false;
		button.addEventListener('click', () => setOpen(panel.hidden));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !panel.hidden) {
				setOpen(false);
				button.focus();
			}
		});
		document.addEventListener('click', (e) => {
			if (!panel.hidden && !nav.contains(e.target as Node)) setOpen(false);
		});
		// The wide menu has no panel: close it when the screen widens.
		window.matchMedia('(min-width: 64em)').addEventListener('change', (e) => e.matches && setOpen(false));
	}

	// The language list closes like a menu: on a click elsewhere or on Escape.
	const langMenu = nav?.querySelector<HTMLDetailsElement>('[data-lang]');
	if (langMenu) {
		document.addEventListener('click', (e) => {
			if (langMenu.open && !langMenu.contains(e.target as Node)) langMenu.open = false;
		});
		langMenu.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && langMenu.open) {
				langMenu.open = false;
				langMenu.querySelector('summary')?.focus();
			}
		});
	}
</script>

<style>
	.sn {
		position: relative;
		z-index: 9999;
		margin-bottom: 2.5rem;
		font-family: var(--font-brand);
		color: var(--sc-ink);
	}
	.sn.sn-scene {
		margin-bottom: 0.5rem;
	}

	.sn-bar {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		max-width: 76rem;
		margin-inline: auto;
		padding: 0.75rem 1rem;
	}

	.sn-brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-right: auto;
		color: var(--sc-ink);
		text-decoration: none;
		font-weight: 600;
		font-size: 1.0625rem;
		line-height: 1.1;
	}
	.sn-brand img {
		width: 3.4rem;
		height: auto;
	}

	.sn-links {
		display: none;
	}

	.sn-tools {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	/* On a phone the menu shows the daily challenge only as the streak it keeps: the tab bar has the rest. */
	.sn-daily {
		display: none;
		align-items: center;
		gap: 0.4rem;
		height: 2.75rem;
		padding: 0 0.9rem;
		border: 1px solid var(--sc-line);
		border-radius: 999rem;
		color: var(--sc-ink);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.sn-daily[data-alive] {
		display: flex;
	}
	.sn-daily[data-alive] .sn-daily-label,
	.sn-daily .sn-streak {
		display: none;
	}
	.sn-daily[data-alive]::after {
		content: attr(data-alive);
		font-weight: 700;
	}
	.sn-flame {
		color: var(--sc-flame);
		flex: none;
	}

	.sn-lang,
	.sn-theme {
		display: none;
	}

	.sn-menu {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--sc-line);
		border-radius: 50%;
		background: none;
		color: var(--sc-ink);
		cursor: pointer;
	}
	.sn-menu[hidden] {
		display: none;
	}
	.sn-menu .sn-close,
	.sn-menu[aria-expanded='true'] .sn-open {
		display: none;
	}
	.sn-menu[aria-expanded='true'] .sn-close {
		display: block;
	}

	.sn-panel {
		position: absolute;
		left: 0.75rem;
		right: 0.75rem;
		top: calc(100% - 0.25rem);
		padding: 0.75rem;
		border: 1px solid var(--sc-line);
		border-radius: 1.25rem;
		background: var(--sc-surface);
		box-shadow: 0 18px 50px rgb(14 11 31 / 0.3);
	}
	.sn-panel[hidden] {
		display: none;
	}
	.sn-panel-links {
		display: flex;
		flex-direction: column;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.sn-panel-links a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.8rem 0.9rem;
		border-radius: 0.8rem;
		color: var(--sc-ink);
		font-size: 1.125rem;
		font-weight: 500;
		text-decoration: none;
	}
	.sn-panel-links a.is-lit {
		background: var(--sc-surface-2);
		font-weight: 600;
	}
	.sn-panel-links .sn-streak {
		padding: 0.1rem 0.6rem;
		border-radius: 999rem;
		background: var(--sc-gold);
		color: var(--sc-gold-ink);
		font-family: var(--font-body);
		font-size: 0.875rem;
		font-weight: 700;
	}
	.sn-panel-links .sn-streak[hidden] {
		display: none;
	}
	.sn-panel-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 0.5rem;
		padding: 0.75rem 0.4rem 0.25rem;
		border-top: 1px solid var(--sc-line);
	}
	.sn-panel-langs {
		display: flex;
		gap: 0.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.sn-panel-langs a,
	.sn-panel-langs span {
		display: grid;
		place-items: center;
		min-width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.7rem;
		color: var(--sc-ink-2);
		font-weight: 600;
		text-decoration: none;
	}
	.sn-panel-langs span {
		background: var(--sc-surface-2);
		color: var(--sc-ink);
	}

	.sn-noscript {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		list-style: none;
		margin: 0 auto;
		padding: 0 1rem 0.75rem;
		max-width: 76rem;
	}

	.sn a:focus-visible,
	.sn summary:focus-visible,
	.sn-menu:focus-visible {
		outline: 3px solid var(--sc-accent);
		outline-offset: 2px;
	}

	@media (min-width: 64em) {
		.sn {
			margin-bottom: 3rem;
		}
		.sn.sn-scene {
			margin-bottom: 0.5rem;
		}
		.sn-bar {
			gap: 1rem;
			padding: 1.1rem 1.5rem;
		}
		.sn-brand {
			margin-right: 0.25rem;
		}
		.sn-brand img {
			width: 4.25rem;
		}
		.sn-name {
			display: none;
		}

		.sn-links {
			display: flex;
			gap: 0.2rem;
			list-style: none;
			margin: 0 auto 0 0;
			padding: 0;
		}
		.sn-links a {
			display: block;
			padding: 0.55rem 0.85rem;
			border-radius: 999rem;
			color: var(--sc-ink-2);
			font-weight: 500;
			text-decoration: none;
			white-space: nowrap;
			transition: background-color 0.15s ease, color 0.15s ease;
		}
		.sn-links a:hover {
			color: var(--sc-ink);
			background: var(--sc-surface-2);
		}
		.sn-links a.is-lit {
			color: var(--sc-ink);
			background: var(--sc-surface-2);
			font-weight: 600;
		}

		.sn-daily,
		.sn-daily[data-alive] {
			display: flex;
			gap: 0.5rem;
			padding: 0 0.45rem 0 0.9rem;
		}
		.sn-daily:not([data-alive]) {
			padding-right: 0.9rem;
		}
		.sn-daily[data-alive]::after {
			content: none;
		}
		.sn-daily[data-alive] .sn-daily-label {
			display: inline;
		}
		.sn-daily .sn-streak {
			display: inline-block;
			padding: 0.15rem 0.6rem;
			border-radius: 999rem;
			background: var(--sc-gold);
			color: var(--sc-gold-ink);
			font-family: var(--font-body);
			font-size: 0.875rem;
			font-weight: 700;
		}
		.sn-daily .sn-streak[hidden] {
			display: none;
		}
		.sn-daily:hover,
		.sn-daily[aria-current='page'] {
			border-color: var(--sc-accent);
		}

		.sn-lang {
			display: block;
			position: relative;
		}
		.sn-lang summary {
			display: flex;
			align-items: center;
			gap: 0.35rem;
			height: 2.75rem;
			padding: 0 0.8rem;
			border: 1px solid var(--sc-line);
			border-radius: 999rem;
			color: var(--sc-ink);
			font-weight: 600;
			font-size: 0.9375rem;
			cursor: pointer;
			list-style: none;
		}
		.sn-lang summary::-webkit-details-marker {
			display: none;
		}
		.sn-lang[open] summary,
		.sn-lang summary:hover {
			border-color: var(--sc-accent);
		}
		.sn-lang-list {
			position: absolute;
			right: 0;
			top: calc(100% + 0.4rem);
			min-width: 11rem;
			list-style: none;
			margin: 0;
			padding: 0.4rem;
			border: 1px solid var(--sc-line);
			border-radius: 1rem;
			background: var(--sc-surface);
			box-shadow: 0 18px 50px rgb(14 11 31 / 0.25);
		}
		.sn-lang-list a,
		.sn-lang-list span {
			display: block;
			padding: 0.55rem 0.8rem;
			border-radius: 0.6rem;
			color: var(--sc-ink);
			font-family: var(--font-body);
			text-decoration: none;
		}
		.sn-lang-list a:hover {
			background: var(--sc-surface-2);
		}
		.sn-lang-list span {
			font-weight: 700;
			background: var(--sc-surface-2);
		}

		.sn-theme {
			display: flex;
		}

		.sn-menu,
		.sn-menu[hidden],
		.sn-panel,
		.sn-panel[hidden],
		.sn-noscript {
			display: none;
		}
	}

	@media (min-width: 80em) {
		.sn-name {
			display: inline;
			font-size: 1.25rem;
		}
		.sn-brand {
			margin-right: 0.75rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sn-links a {
			transition: none;
		}
	}
</style>
