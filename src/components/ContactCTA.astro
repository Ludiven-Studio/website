---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';

interface Props {
	lang?: 'fr' | 'en' | 'es' | 'de' | 'it' | undefined;
}

const { lang = 'fr' } = Astro.props;
const t = lang === 'en'
	? { heading: 'Got a project in mind?', cta: 'Get in touch' }
	: lang === 'es'
	? { heading: '¿Tienes un proyecto en mente?', cta: 'Escríbeme' }
	: lang === 'de'
	? { heading: 'Ein Projekt im Kopf?', cta: 'Schreib mir' }
	: lang === 'it'
	? { heading: 'Hai un progetto in mente?', cta: 'Scrivimi' }
	: { heading: 'Un projet en tête ?', cta: 'Contactez-moi' };
---

<aside>
	<h2>{t.heading}</h2>
	<CallToAction href="mailto:contact@ludiven-studio.fr">
		{t.cta}
		<Icon icon="paper-plane-tilt" size="1.2em" />
	</CallToAction>
</aside>

<style>
	/* A night card, as the homepage's daily challenge. */
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		width: calc(100% - 2rem);
		max-width: 73rem;
		margin-inline: auto;
		padding: 3rem 1.5rem;
		border-radius: 1.75rem;
		background: var(--sc-night-surface);
	}

	h2 {
		font-size: var(--text-xl);
		text-align: center;
		max-width: 15ch;
		color: #fff;
	}

	aside :global(a) {
		background: var(--sc-gold);
		color: var(--sc-gold-ink);
	}

	@media (min-width: 50em) {
		aside {
			padding: 4rem 4.5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
		}

		h2 {
			font-size: var(--text-3xl);
			text-align: left;
		}
	}
</style>
