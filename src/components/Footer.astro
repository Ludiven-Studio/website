---
// The site's footer, in the page's language. It stays a <footer> right under .backgrounds: the games' fullscreen
// hides it by that selector.
import Icon from './Icon.astro';
import { MAIL, NAV, SOCIALS, type Lang } from '../data/siteNav';

interface Props {
	lang?: Lang;
}

const { lang = 'fr' } = Astro.props;
const t = NAV[lang];
const year = new Date().getFullYear();
---

<footer class="sf">
	<div class="sf-in">
		<p class="sf-copy">
			<span>&copy; {year} Ludiven Studio</span>
			<a href={`mailto:${MAIL}`}>{MAIL}</a>
		</p>
		<ul class="sf-links" aria-label={t.footerLabel}>
			{
				t.footer.map((l) => (
					<li>
						<a href={l.href} hreflang={!l.href.startsWith('mailto:') && lang !== 'fr' && !l.href.startsWith(`/${lang}/`) ? 'fr' : undefined}>
							{l.label}
						</a>
					</li>
				))
			}
		</ul>
		<ul class="sf-socials">
			{
				SOCIALS.map((s) => (
					<li>
						<a href={s.href} target="_blank" rel="noopener" aria-label={t.follow(s.label)}>
							<Icon icon={s.icon} size="1.25em" />
							<span>{s.label}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>

<style>
	.sf {
		margin-top: auto;
		padding: 2.5rem 0 2.75rem;
		border-top: 1px solid var(--sc-line);
		color: var(--sc-muted);
		font-size: var(--text-sm);
	}

	.sf-in {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		max-width: 76rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
		text-align: center;
	}

	.sf a {
		color: var(--sc-ink-2);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color 0.15s ease;
	}
	.sf a:hover,
	.sf a:focus-visible {
		text-decoration-color: currentColor;
	}

	.sf-copy {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.4rem 1rem;
	}

	.sf-links,
	.sf-socials {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.sf-socials a {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
	}

	@media (min-width: 64em) {
		.sf {
			padding: 2.25rem 0;
		}
		.sf-in {
			padding-inline: 1.5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
			text-align: left;
		}
		.sf-links {
			order: 3;
			flex-basis: 100%;
			justify-content: flex-start;
		}
	}
</style>
