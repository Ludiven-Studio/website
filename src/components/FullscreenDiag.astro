---
// Throwaway instrument: the fullscreen overlay vanishes on an iPhone and nothing here
// reproduces it, so measure the real page on the device. Dormant unless the URL carries
// ?diag — a normal visitor never sees it. Delete with /jeux/diagnostic once the bug is understood.
interface Props {
	always?: boolean;
}
const { always = false } = Astro.props;
---

<!-- Outside .game-page on purpose: it has to survive the overlay disappearing. -->
<div class="dg-panel" data-always={always ? '1' : '0'}>
	<p class="dg-help">L'écran passe en plein écran 1,5 s puis revient tout seul.</p>
	<button type="button" id="dg-run">Test plein écran</button>
	<button type="button" id="dg-run-scrolled">Test après avoir défilé</button>
	<button type="button" id="dg-run-noart">Test sans le décor de fond</button>
	<button type="button" id="dg-copy">Copier le résultat</button>
	<pre id="dg-out">—</pre>
</div>

<style>
	.dg-panel {
		display: none;
		position: relative;
		z-index: 50;
		padding: 1rem;
		flex-direction: column;
		gap: 0.5rem;
		align-items: flex-start;
	}
	.dg-panel.on {
		display: flex;
	}
	.dg-panel button {
		font: inherit;
		font-size: 1rem;
		padding: 10px 16px;
		border-radius: 10px;
		border: 2px solid var(--gray-500);
		background: var(--gray-999);
		color: var(--gray-0);
	}
	.dg-help {
		margin: 0;
		color: var(--gray-200);
	}
	/* Hidden while the test runs, or this panel would keep the body from collapsing and the
	   measurement would not match an untouched game page. The result is read after the auto-exit. */
	:global(html.gf-full) .dg-panel {
		display: none;
	}
	#dg-out {
		white-space: pre-wrap;
		word-break: break-all;
		font-size: 12px;
		line-height: 1.35;
		color: var(--gray-0);
		background: var(--gray-999);
		border: 1px solid var(--gray-700);
		border-radius: 8px;
		padding: 8px;
		width: 100%;
		margin: 0;
	}
</style>

<script>
	const panel = document.querySelector('.dg-panel') as HTMLElement | null;
	if (panel && (panel.dataset.always === '1' || location.search.includes('diag'))) {
		panel.classList.add('on');
		const out = document.getElementById('dg-out')!;
		const rect = (sel: string) => {
			const el = document.querySelector(sel) as HTMLElement | null;
			if (!el) return `${sel}: absent`;
			const b = el.getBoundingClientRect();
			const s = getComputedStyle(el);
			return `${sel}: ${Math.round(b.x)},${Math.round(b.y)} ${Math.round(b.width)}x${Math.round(b.height)} pos=${s.position} disp=${s.display} vis=${s.visibility} op=${s.opacity} blend=${s.mixBlendMode} z=${s.zIndex}`;
		};
		// The island itself is display:contents, so its own rect is always 0x0 — measure what it
		// rendered instead, or the report reads like a dead island on a perfectly healthy page.
		const island = () => {
			// Direct child of .game-page = the game. The nested ones (challenge banner, wallet) and
			// the cocoin toast that follows the footer are not what we are watching.
			const el = document.querySelector('.game-page > astro-island') as HTMLElement | null;
			if (!el) return 'island: absent';
			const kid = el.firstElementChild as HTMLElement | null;
			if (!kid) return `island: ${el.childElementCount} enfant`;
			const b = kid.getBoundingClientRect();
			const s = getComputedStyle(kid);
			return `island > ${kid.tagName}.${String(kid.className).slice(0, 20)}: ${Math.round(b.x)},${Math.round(b.y)} ${Math.round(b.width)}x${Math.round(b.height)} pos=${s.position} disp=${s.display} vis=${s.visibility} op=${s.opacity}`;
		};
		const snap = (tag: string) => {
			const vv = window.visualViewport;
			const de = document.documentElement;
			const pt = (x: number, y: number) => {
				const el = document.elementFromPoint(x, y);
				return el ? el.tagName + '.' + String(el.className).slice(0, 26) : 'rien';
			};
			return [
				`[${tag}]`,
				`inner ${innerWidth}x${innerHeight} scrollY=${Math.round(scrollY)}`,
				vv ? `visual ${Math.round(vv.width)}x${Math.round(vv.height)} offTop=${Math.round(vv.offsetTop)} pageTop=${Math.round(vv.pageTop)}` : 'visual: absent',
				`html ${de.clientWidth}x${de.clientHeight} scroll=${de.scrollWidth}x${de.scrollHeight}`,
				`body ${document.body.clientWidth}x${document.body.clientHeight}`,
				rect('.game-page'),
				rect('.gf-exit'),
				rect('.game-art'),
				island(),
				`haut=${pt(innerWidth / 2, 60)} centre=${pt(innerWidth / 2, innerHeight / 2)} bas=${pt(innerWidth / 2, innerHeight - 60)}`,
			].join('\n');
		};

		const run = (scrollFirst: boolean, killArt: boolean) => {
			const btn = document.querySelector('.gf-btn') as HTMLButtonElement | null;
			if (!btn) { out.textContent = 'bouton plein écran absent'; return; }
			const art = document.querySelector('.game-art') as HTMLElement | null;
			if (killArt && art) art.style.display = 'none';
			if (scrollFirst) scrollTo(0, 400);
			setTimeout(() => {
				const before = snap('avant');
				btn.click();
				setTimeout(() => {
					const during = snap('pendant');
					btn.click();
					setTimeout(() => {
						if (killArt && art) art.style.display = '';
						out.textContent = `${navigator.userAgent}\nkillArt=${killArt} scrolled=${scrollFirst}\n\n${before}\n\n${during}\n\n${snap('après')}`;
					}, 300);
				}, 1500);
			}, scrollFirst ? 400 : 0);
		};

		document.getElementById('dg-run')!.addEventListener('click', () => run(false, false));
		document.getElementById('dg-run-scrolled')!.addEventListener('click', () => run(true, false));
		document.getElementById('dg-run-noart')!.addEventListener('click', () => run(false, true));
		document.getElementById('dg-copy')!.addEventListener('click', () => {
			void navigator.clipboard?.writeText(out.textContent || '');
		});
	}
</script>
