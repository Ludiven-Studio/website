---
// Behaviour only — the page renders the fold and an empty `[data-fav-grid]` list so
// the grid keeps the page's own styles. This fills that list with copies of the favorite
// cards: every game stays in its category too.
---

<script>
	const KEY = 'ludiven-favorites';

	const grid = document.querySelector<HTMLElement>('[data-fav-grid]');
	const fold = grid?.closest('details');
	if (grid && fold) {
		const li = new Map<string, HTMLElement>();
		document.querySelectorAll<HTMLElement>('.game-card-wrap[data-game-id]').forEach((wrap) => {
			const id = wrap.dataset.gameId;
			const item = wrap.closest('li');
			// The shortcut sections hold copies too: the category's card is the one to take.
			if (!id || !item || li.has(id) || wrap.closest('[data-fold-extra]')) return;
			li.set(id, item);
		});

		const read = (): string[] => {
			try {
				const v = JSON.parse(localStorage.getItem(KEY) || '[]');
				return Array.isArray(v) ? v : [];
			} catch {
				return [];
			}
		};

		const apply = () => {
			const favs = read().filter((id) => li.has(id));
			// The category's card carries the live pips and heart state at this moment.
			grid.replaceChildren(...favs.map((id) => li.get(id)!.cloneNode(true)));
			fold.hidden = favs.length === 0;
			// The défi page rewrites these with its own "3/12 faits" right after, on the event below.
			const meta = fold.querySelector('[data-fold-meta]');
			if (meta) meta.textContent = `${favs.length} jeu${favs.length > 1 ? 'x' : ''}`;
			document.dispatchEvent(new Event('favorites-applied'));
		};

		apply();
		// The heart writes localStorage from its own click listener; run after it.
		document.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('.fav-toggle')) setTimeout(apply, 0);
		});
		window.addEventListener('storage', (e) => {
			if (e.key === KEY) apply();
		});
	}
</script>
