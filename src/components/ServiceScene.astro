---
// Small looping illustration of a service in use. Pure SVG + CSS, 8 s cycle.
// Reduced motion freezes each scene on a telling frame (--freeze).
interface Props {
	scene: 'courses' | 'rencontres' | 'tournoi';
}

const { scene } = Astro.props;

const items = [
	{ label: 'Pain', w: 19 },
	{ label: 'Lait', w: 17 },
	{ label: 'Tomates', w: 35 },
	{ label: 'Café', w: 21 },
	{ label: 'Pâtes', w: 25 },
];
// Per phone: which rows animate, and with which keyframes.
const phones = [
	{ x: 40, anim: { 2: 'a', 4: 'd' } as Record<number, string> },
	{ x: 194, anim: { 2: 'b', 4: 'c' } as Record<number, string> },
];
const rowY = (i: number) => 58 + i * 20;

const pins = [
	{ x: 80, y: 72, color: '#e11d48' },
	{ x: 175, y: 100, color: '#7611a6' },
	{ x: 258, y: 58, color: '#f59e0b' },
];
---

<div class:list={['scene', `scene-${scene}`]} aria-hidden="true">
	{scene === 'courses' && (
		<svg viewBox="0 0 320 180">
			<rect width="320" height="180" fill="#e6f5ec" />
			<path d="M130 66 Q160 22 190 66" class="trail" />
			<path d="M190 100 Q160 144 130 100" class="trail" />
			<text x="160" y="87" text-anchor="middle" class="live">en direct</text>
			{phones.map((p) => {
				const sx = p.x + 5;
				return (
					<g>
						<rect x={p.x} y="18" width="86" height="150" rx="12" fill="#1f2937" />
						<rect x={sx} y="28" width="76" height="132" rx="6" fill="#fff" />
						<rect x={sx} y="28" width="76" height="16" rx="6" fill="#16a34a" />
						<rect x={sx} y="38" width="76" height="6" fill="#16a34a" />
						<text x={sx + 6} y="39.5" class="phone-title">🛒 Courses</text>
						{items.map((it, i) => {
							const c = rowY(i);
							const k = p.anim[i];
							const done = i === 1;
							return (
								<g>
									<rect x={sx + 5} y={c - 5} width="10" height="10" rx="2" fill="#fff" stroke="#9ca3af" />
									<g class={k ? `chk chk-${k}` : undefined} opacity={k || done ? undefined : 0}>
										<rect x={sx + 5} y={c - 5} width="10" height="10" rx="2" fill="#16a34a" />
										<path d={`M${sx + 7.5} ${c} l2 2 l3.5 -4`} fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
									</g>
									<text x={sx + 20} y={c + 3.2} class:list={['item', { 'item-done': done }]}>{it.label}</text>
									{(k || done) && (
										<line x1={sx + 19} y1={c} x2={sx + 21 + it.w} y2={c} class:list={['strike', k && `strike-${k}`]} />
									)}
								</g>
							);
						})}
					</g>
				);
			})}
			<circle cx="50" cy="98" r="9" class="tap tap-a" />
			<circle cx="204" cy="138" r="9" class="tap tap-c" />
			<path d="M130 66 Q160 22 190 66" pathLength="100" class="packet packet-a" />
			<path d="M190 100 Q160 144 130 100" pathLength="100" class="packet packet-c" />
		</svg>
	)}

	{scene === 'rencontres' && (
		<svg viewBox="0 0 320 180">
			<rect width="320" height="180" fill="#eaf2df" />
			<ellipse cx="45" cy="150" rx="40" ry="22" fill="#d3e7bd" />
			<ellipse cx="290" cy="140" rx="45" ry="30" fill="#d3e7bd" />
			<path d="M-5 140 C60 115 95 160 160 142 S255 108 325 126" fill="none" stroke="#a5d0ec" stroke-width="10" stroke-linecap="round" />
			<g fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round">
				<path d="M-5 50 L325 82" />
				<path d="M112 -5 L140 185" />
				<path d="M228 -5 C218 60 250 120 240 185" />
			</g>
			<g fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" opacity="0.8">
				<path d="M140 120 L230 112" />
				<path d="M30 0 L60 60" />
			</g>
			{pins.map((p, i) => (
				<g transform={`translate(${p.x} ${p.y})`}>
					<ellipse rx="6" ry="2" fill="#000" opacity="0.18" class={`shade shade-${i + 1}`} />
					<circle r="5" fill="none" stroke={p.color} stroke-width="2" class={`ring ring-${i + 1}`} />
					<g class={`pin pin-${i + 1}`}>
						<path d="M0 0 C-7 -10 -10 -15 -10 -20 A10 10 0 1 1 10 -20 C10 -15 7 -10 0 0Z" fill={p.color} />
						<circle cy="-20" r="4" fill="#fff" />
					</g>
				</g>
			))}
			<g class="bubble">
				<rect x="121" y="20" width="108" height="34" rx="8" fill="#fff" class="bubble-box" />
				<path d="M168 53 L175 62 L182 53Z" fill="#fff" />
				<text x="130" y="33.5" class="bubble-title">Dim. 15h · Doublette</text>
				<text x="130" y="46.5" class="bubble-count count-before">3/4 joueurs</text>
				<text x="130" y="46.5" class="bubble-count count-after">Complet ✓</text>
				{[0, 1, 2, 3].map((n) => (
					<circle cx={196 + n * 8} cy="43" r="3" fill={n < 3 ? '#7611a6' : '#16a34a'} class={n === 3 ? 'joiner' : undefined} />
				))}
				<circle cx="220" cy="43" r="3" fill="none" stroke="#c4b5d0" stroke-width="1" />
			</g>
		</svg>
	)}

	{scene === 'tournoi' && (
		<svg viewBox="0 0 320 180">
			<defs>
				<radialGradient id="ss-steel" cx="35%" cy="30%" r="70%">
					<stop offset="0" stop-color="#f1f5f9" />
					<stop offset="0.45" stop-color="#94a3b8" />
					<stop offset="1" stop-color="#334155" />
				</radialGradient>
				<radialGradient id="ss-gold" cx="35%" cy="30%" r="70%">
					<stop offset="0" stop-color="#fffbeb" />
					<stop offset="0.5" stop-color="#facc15" />
					<stop offset="1" stop-color="#b45309" />
				</radialGradient>
			</defs>
			<rect width="320" height="180" fill="#8b5a2b" />
			<rect x="6" y="6" width="308" height="168" rx="4" fill="#dcc196" />
			<g fill="#c9a875" opacity="0.7">
				<circle cx="40" cy="60" r="1.5" /><circle cx="90" cy="130" r="1.2" /><circle cx="150" cy="70" r="1.4" />
				<circle cx="270" cy="110" r="1.3" /><circle cx="230" cy="150" r="1.5" /><circle cx="120" cy="100" r="1" />
				<circle cx="60" cy="155" r="1.2" /><circle cx="285" cy="60" r="1.1" />
			</g>
			<g class="banner">
				<rect x="62" y="12" width="196" height="26" rx="5" fill="#7611a6" />
				<text x="160" y="29.5" text-anchor="middle" class="banner-text">Tournoi de la Saint-Jean</text>
			</g>
			<g class="sponsor sponsor-1">
				<rect x="14" y="56" width="44" height="30" rx="4" fill="#fff" />
				<path d="M36 61 L45 64 L45 71 Q45 78 36 81 Q27 78 27 71 L27 64Z" fill="#2563eb" />
				<text x="36" y="74" text-anchor="middle" class="logo-text">ASB</text>
			</g>
			<g class="sponsor sponsor-2">
				<rect x="14" y="94" width="44" height="30" rx="4" fill="#fff" />
				<circle cx="36" cy="105" r="6" fill="#f97316" />
				<text x="36" y="119.5" text-anchor="middle" class="logo-small">Fournil</text>
			</g>
			<circle cx="200" cy="90" r="4.5" fill="url(#ss-gold)" />
			<g><ellipse cx="183" cy="112" rx="8" ry="3" fill="#000" opacity="0.15" /><circle cx="181" cy="106" r="8" fill="url(#ss-steel)" /></g>
			<g><ellipse cx="232" cy="80" rx="8" ry="3" fill="#000" opacity="0.15" /><circle cx="230" cy="74" r="8" fill="url(#ss-steel)" /></g>
			<circle cx="205" cy="100" r="6" class="dust" />
			<g class="throw">
				<ellipse cx="2" cy="6" rx="8" ry="3" fill="#000" opacity="0.15" />
				<g class="loft"><circle r="8" fill="url(#ss-steel)" /></g>
			</g>
			<g class="point">
				<rect x="162" y="56" width="48" height="18" rx="9" fill="#16a34a" />
				<text x="186" y="68.5" text-anchor="middle" class="point-text">Point !</text>
			</g>
			<g>
				<rect x="248" y="138" width="60" height="28" rx="5" fill="#1f2937" />
				<text x="278" y="157" text-anchor="middle" class="score score-before">12 – 11</text>
				<text x="278" y="157" text-anchor="middle" class="score score-after">13 – 11</text>
			</g>
		</svg>
	)}
</div>

<style>
	.scene {
		--freeze: -4s;
		aspect-ratio: 16 / 9;
		border-radius: 0.6rem;
		overflow: hidden;
		border: 1px solid var(--gray-800);
	}

	.scene svg {
		display: block;
		width: 100%;
		height: 100%;
		font-family: inherit;
	}

	.scene * {
		animation-duration: 8s;
		animation-iteration-count: infinite;
		animation-timing-function: ease-in-out;
		transform-box: fill-box;
	}

	@media (prefers-reduced-motion: reduce) {
		.scene * {
			animation-play-state: paused !important;
			animation-delay: var(--freeze) !important;
		}
	}

	/* — Courses: a tick on one phone shows up on the other — */
	.phone-title { font-size: 8px; font-weight: 700; fill: #fff; }
	.item { font-size: 9px; fill: #374151; }
	.item-done { fill: #9ca3af; }
	.strike { stroke: #6b7280; stroke-width: 1; transform-origin: left; }
	.trail { fill: none; stroke: #16a34a; stroke-width: 1.5; stroke-dasharray: 2 4; opacity: 0.35; }
	.live { font-size: 8px; font-weight: 700; fill: #16a34a; letter-spacing: 0.04em; animation-name: ss-blink; }
	.packet {
		fill: none;
		stroke: #16a34a;
		stroke-width: 7;
		stroke-linecap: round;
		stroke-dasharray: 1 200;
		stroke-dashoffset: 2;
	}
	.packet-a { animation-name: ss-packet-a; }
	.packet-c { animation-name: ss-packet-c; }
	.tap { fill: #16a34a; opacity: 0; transform-origin: center; }
	.tap-a { animation-name: ss-tap-a; }
	.tap-c { animation-name: ss-tap-c; }
	.chk-a { animation-name: ss-on-a; }
	.chk-b { animation-name: ss-on-b; }
	.chk-c { animation-name: ss-on-c; }
	.chk-d { animation-name: ss-on-d; }
	.strike-a { animation-name: ss-strike-a; }
	.strike-b { animation-name: ss-strike-b; }
	.strike-c { animation-name: ss-strike-c; }
	.strike-d { animation-name: ss-strike-d; }

	@keyframes ss-blink { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
	@keyframes ss-tap-a {
		0%, 12% { opacity: 0; transform: scale(0.4); }
		15% { opacity: 0.45; transform: scale(1); }
		23%, 100% { opacity: 0; transform: scale(1.7); }
	}
	@keyframes ss-tap-c {
		0%, 55% { opacity: 0; transform: scale(0.4); }
		58% { opacity: 0.45; transform: scale(1); }
		66%, 100% { opacity: 0; transform: scale(1.7); }
	}
	@keyframes ss-packet-a { 0%, 19% { stroke-dashoffset: 2; } 38%, 100% { stroke-dashoffset: -101; } }
	@keyframes ss-packet-c { 0%, 62% { stroke-dashoffset: 2; } 81%, 100% { stroke-dashoffset: -101; } }
	@keyframes ss-on-a { 0%, 14% { opacity: 0; } 16%, 93% { opacity: 1; } 98%, 100% { opacity: 0; } }
	@keyframes ss-on-b { 0%, 37% { opacity: 0; } 39%, 93% { opacity: 1; } 98%, 100% { opacity: 0; } }
	@keyframes ss-on-c { 0%, 57% { opacity: 0; } 59%, 93% { opacity: 1; } 98%, 100% { opacity: 0; } }
	@keyframes ss-on-d { 0%, 80% { opacity: 0; } 82%, 93% { opacity: 1; } 98%, 100% { opacity: 0; } }
	@keyframes ss-strike-a { 0%, 15% { transform: scaleX(0); } 20%, 93% { transform: scaleX(1); opacity: 1; } 98%, 100% { opacity: 0; } }
	@keyframes ss-strike-b { 0%, 38% { transform: scaleX(0); } 43%, 93% { transform: scaleX(1); opacity: 1; } 98%, 100% { opacity: 0; } }
	@keyframes ss-strike-c { 0%, 58% { transform: scaleX(0); } 63%, 93% { transform: scaleX(1); opacity: 1; } 98%, 100% { opacity: 0; } }
	@keyframes ss-strike-d { 0%, 81% { transform: scaleX(0); } 86%, 93% { transform: scaleX(1); opacity: 1; } 98%, 100% { opacity: 0; } }

	/* — Rencontres: games pop up on the map, one fills up — */
	.scene-rencontres { --freeze: -6s; }
	.pin, .shade, .ring { transform-origin: center bottom; }
	.ring { transform-origin: center; opacity: 0; }
	.pin-1, .shade-1 { animation-name: ss-drop-1; }
	.pin-2, .shade-2 { animation-name: ss-drop-2; }
	.pin-3, .shade-3 { animation-name: ss-drop-3; }
	.ring-1 { animation-name: ss-ring-1; }
	.ring-2 { animation-name: ss-ring-2; }
	.ring-3 { animation-name: ss-ring-3; }
	.bubble { transform-origin: 50% 100%; animation-name: ss-bubble; }
	.bubble-box { filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.18)); }
	.bubble-title { font-size: 8.5px; font-weight: 700; fill: #1f2937; }
	.bubble-count { font-size: 8.5px; font-weight: 700; }
	.count-before { fill: #7611a6; animation-name: ss-before; }
	.count-after { fill: #16a34a; opacity: 0; animation-name: ss-after; }
	.joiner { transform-origin: center; animation-name: ss-join; }

	@keyframes ss-drop-1 {
		0%, 4% { opacity: 0; transform: translateY(-40px); }
		10% { opacity: 1; transform: translateY(0); }
		12% { transform: translateY(-5px); }
		14%, 93% { opacity: 1; transform: translateY(0); }
		99%, 100% { opacity: 0; transform: translateY(0); }
	}
	@keyframes ss-drop-2 {
		0%, 12% { opacity: 0; transform: translateY(-40px); }
		18% { opacity: 1; transform: translateY(0); }
		20% { transform: translateY(-5px); }
		22%, 93% { opacity: 1; transform: translateY(0); }
		99%, 100% { opacity: 0; transform: translateY(0); }
	}
	@keyframes ss-drop-3 {
		0%, 20% { opacity: 0; transform: translateY(-40px); }
		26% { opacity: 1; transform: translateY(0); }
		28% { transform: translateY(-5px); }
		30%, 93% { opacity: 1; transform: translateY(0); }
		99%, 100% { opacity: 0; transform: translateY(0); }
	}
	@keyframes ss-ring-1 { 0%, 10% { opacity: 0; transform: scale(1); } 11% { opacity: 0.8; } 24%, 100% { opacity: 0; transform: scale(4); } }
	@keyframes ss-ring-2 { 0%, 18% { opacity: 0; transform: scale(1); } 19% { opacity: 0.8; } 32%, 100% { opacity: 0; transform: scale(4); } }
	@keyframes ss-ring-3 { 0%, 26% { opacity: 0; transform: scale(1); } 27% { opacity: 0.8; } 40%, 100% { opacity: 0; transform: scale(4); } }
	@keyframes ss-bubble {
		0%, 36% { opacity: 0; transform: scale(0.3); }
		41% { opacity: 1; transform: scale(1.05); }
		44%, 92% { opacity: 1; transform: scale(1); }
		97%, 100% { opacity: 0; transform: scale(0.9); }
	}
	@keyframes ss-before { 0%, 60% { opacity: 1; } 63%, 100% { opacity: 0; } }
	@keyframes ss-after { 0%, 61% { opacity: 0; } 64%, 100% { opacity: 1; } }
	@keyframes ss-join {
		0%, 56% { opacity: 0; transform: translateY(-14px) scale(0.4); }
		61% { opacity: 1; transform: translateY(0) scale(1.3); }
		64%, 100% { opacity: 1; transform: translateY(0) scale(1); }
	}

	/* — Tournoi: club colours go up, a boule takes the point — */
	.scene-tournoi { --freeze: -6s; }
	.banner-text { font-size: 11.5px; font-weight: 800; fill: #fff; letter-spacing: 0.01em; }
	.logo-text { font-size: 7px; font-weight: 800; fill: #fff; }
	.logo-small { font-size: 7.5px; font-weight: 700; fill: #9a3412; }
	.banner { animation-name: ss-banner; }
	.sponsor-1 { animation-name: ss-sponsor-1; }
	.sponsor-2 { animation-name: ss-sponsor-2; }
	.throw { animation-name: ss-throw; animation-timing-function: linear; }
	.loft { animation-name: ss-loft; animation-timing-function: linear; transform-origin: center; }
	.dust { fill: #f5e6c8; opacity: 0; transform-origin: center; animation-name: ss-dust; }
	.point { transform-origin: center; animation-name: ss-point; }
	.point-text { font-size: 9.5px; font-weight: 800; fill: #fff; }
	.score { font-size: 13px; font-weight: 800; fill: #fff; font-variant-numeric: tabular-nums; }
	.score-before { animation-name: ss-before; }
	.score-after { opacity: 0; animation-name: ss-after; }

	@keyframes ss-banner {
		0%, 3% { opacity: 0; transform: translateY(-36px); }
		10%, 94% { opacity: 1; transform: translateY(0); }
		100% { opacity: 0; transform: translateY(0); }
	}
	@keyframes ss-sponsor-1 {
		0%, 10% { opacity: 0; transform: translateX(-60px); }
		16%, 94% { opacity: 1; transform: translateX(0); }
		100% { opacity: 0; }
	}
	@keyframes ss-sponsor-2 {
		0%, 14% { opacity: 0; transform: translateX(-60px); }
		20%, 94% { opacity: 1; transform: translateX(0); }
		100% { opacity: 0; }
	}
	@keyframes ss-throw {
		0%, 26% { opacity: 0; transform: translate(70px, 200px); }
		27% { opacity: 1; transform: translate(80px, 182px); }
		42% { transform: translate(196px, 106px); }
		47% { transform: translate(203px, 101px); }
		50%, 94% { opacity: 1; transform: translate(205px, 100px); }
		99%, 100% { opacity: 0; transform: translate(205px, 100px); }
	}
	@keyframes ss-loft {
		0%, 27% { transform: translateY(0) scale(1); }
		34% { transform: translateY(-34px) scale(1.35); }
		42%, 100% { transform: translateY(0) scale(1); }
	}
	@keyframes ss-dust {
		0%, 41% { opacity: 0; transform: scale(0.5); }
		43% { opacity: 0.9; transform: scale(1); }
		52%, 100% { opacity: 0; transform: scale(2.6); }
	}
	@keyframes ss-point {
		0%, 52% { opacity: 0; transform: scale(0.4); }
		56% { opacity: 1; transform: scale(1.12); }
		59%, 92% { opacity: 1; transform: scale(1); }
		97%, 100% { opacity: 0; transform: scale(1); }
	}
</style>
