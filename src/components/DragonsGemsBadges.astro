---
// The store badges of Dragon Gems Swipe. Until a store lists the game, its badge is shown faded, with no
// link, under « coming soon »; once STORES has its URL it becomes the usual link.
import { STORES, copy, typo, type Lang } from '../data/dragonsGems';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const play = `/assets/badges/google-play-${lang}.png`;
// No localized App Store badge on file for de/it: Apple allows the English one everywhere.
const apple = `/assets/badges/app-store-${lang === 'de' || lang === 'it' ? 'en' : lang}.svg`;
const badges = [
	{ href: STORES.play, src: play, cls: 'badge-play', alt: 'Google Play' },
	{ href: STORES.apple, src: apple, cls: 'badge-appstore', alt: 'App Store' },
];
const soon = badges.some((b) => !b.href);
---

<div class="dg-badges">
	<div class="store-badges">
		{badges.map((b) => (b.href ? (
			<a href={b.href} target="_blank" rel="noopener"><img class={b.cls} src={b.src} alt={b.alt} /></a>
		) : (
			<span class="dg-soon">
				<img class={b.cls} src={b.src} alt={`${b.alt} — ${t.soon}`} />
				<span class="dg-soon-tag" aria-hidden="true">{t.soonShort}</span>
			</span>
		)))}
	</div>
	{soon && <p class="dg-soon-note">{typo(lang, t.soon)}</p>}
</div>

<style>
	.dg-badges .store-badges {
		justify-content: flex-start;
		margin-top: 0;
	}

	/* The badge faded, its « coming soon » tag on top at full strength. */
	.dg-soon {
		position: relative;
		display: block;
		flex: none;
	}

	.dg-soon img {
		opacity: 0.45;
		filter: grayscale(1);
	}

	.dg-soon-tag {
		position: absolute;
		top: -0.55rem;
		right: -0.5rem;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		background: var(--accent-regular);
		color: #fff;
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1.3;
		white-space: nowrap;
		box-shadow: var(--shadow-sm);
	}

	.dg-soon-note {
		margin-top: 0.6rem;
		color: var(--gray-400);
		font-size: var(--text-sm);
		font-weight: 600;
	}

	:global(.closing) .dg-badges .store-badges {
		justify-content: center;
	}
</style>
