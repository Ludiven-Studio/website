---
// Only /work and /services exist in English, so this is a per-page link, not a site-wide switch.
interface Props {
	lang: 'fr' | 'en';
	href: string; // the same page in the other language
}

const { lang, href } = Astro.props;
---

<a class="lang-switch" href={href} hreflang={lang === 'fr' ? 'en' : 'fr'}>
	{lang === 'fr' ? 'Read in English' : 'Lire en français'}
</a>

<style>
	.lang-switch {
		align-self: flex-start;
		padding: 0.3rem 0.8rem;
		border: 1px solid var(--gray-800);
		border-radius: 999rem;
		background-color: var(--gray-999_40);
		color: var(--gray-300);
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		text-decoration: none;
		transition: color var(--theme-transition), background-color var(--theme-transition);
	}

	.lang-switch:hover,
	.lang-switch:focus {
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
	}
</style>
