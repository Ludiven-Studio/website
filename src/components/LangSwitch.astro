---
// Only a few pages exist in other languages, so this is a per-page link, not a site-wide switch.
// Two-language pages pass `lang` + `href`; pages with more pass `links` (the other versions).
type Lang = 'fr' | 'en' | 'es';

interface Props {
	lang: Lang;
	href?: string; // the same page in the other language
	links?: { lang: Lang; href: string }[];
}

// Each label is written in its own language: it is read by someone who does not speak the page's.
const LABEL: Record<Lang, string> = { fr: 'Lire en français', en: 'Read in English', es: 'Leer en español' };

const { lang, href, links } = Astro.props;
const all = links ?? (href ? [{ lang: lang === 'fr' ? 'en' : 'fr', href }] as { lang: Lang; href: string }[] : []);
---

<div class="lang-switches">
	{all.map((l) => (
		<a class="lang-switch" href={l.href} hreflang={l.lang} lang={l.lang}>{LABEL[l.lang]}</a>
	))}
</div>

<style>
	.lang-switches {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-self: flex-start;
	}

	.lang-switch {
		padding: 0.3rem 0.8rem;
		border: 1px solid var(--gray-800);
		border-radius: 999rem;
		background-color: var(--gray-999_40);
		color: var(--gray-300);
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		text-decoration: none;
		transition: color var(--theme-transition), background-color var(--theme-transition);
	}

	.lang-switch:hover,
	.lang-switch:focus {
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
	}
</style>
