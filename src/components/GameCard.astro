---
import Icon from './Icon.astro';
import type { iconPaths } from './IconPaths';

interface Props {
	title: string;
	pitch: string;
	icon: keyof typeof iconPaths;
	href?: string;
	status?: 'play' | 'soon';
	id?: string;
	favorite?: boolean;
	image?: string;
	daily?: boolean; // false for games without a daily challenge (e.g. multiplayer)
	compact?: boolean; // drop the image + pitch → a small tile (used on the daily page)
}

const { title, pitch, icon, href, status = 'play', id, favorite = false, image, daily = true, compact = false } = Astro.props;
const playable = status === 'play' && href;
const Tag = playable ? 'a' : 'div';
const showFavorite = favorite && playable && id;
// Convention: a generated screenshot at /assets/jeux/<id>.jpg. onerror removes it if absent.
const media = image ?? (playable && id ? `/assets/jeux/${id}.jpg` : undefined);
// Compact tiles show the very same key art, in a small crisp copy: the full card is
// ~180 kB, and art/<id>.jpg is blurred at export time (cf. scripts/game-tiles.mjs).
const tile = compact && playable && id ? `/assets/jeux/tile/${id}.jpg` : undefined;
// Search haystack, accent-stripped so "melee" finds "Mots Mêlés". Built here rather
// than read from the DOM because compact tiles don't render the pitch.
const COMBINING = new RegExp('[\\u0300-\\u036f]', 'g');
const searchText = [title, pitch, id]
	.filter(Boolean)
	.join(' ')
	.normalize('NFD')
	.replace(COMBINING, '')
	.toLowerCase();
---

<div class:list={['game-card-wrap', { 'has-fav': showFavorite }]} data-game-id={id} data-search={searchText}>
	<Tag
		class:list={['game-card', { soon: !playable, compact }]}
		{...playable ? { href } : { 'aria-disabled': 'true' }}
	>
		{(compact ? tile : media) && (
			<div class="game-card-media">
				<img src={compact ? tile : media} alt="" loading="lazy" onerror="this.parentElement.remove()" />
			</div>
		)}
		{
			compact ? (
				!playable && <span class="badge soon">Bientôt</span>
			) : (
				<div class="game-card-top">
					<Icon icon={icon} color="var(--accent-regular)" size="2.5rem" gradient />
					<span class:list={['badge', { soon: !playable }]}>{playable ? 'Jouer' : 'Bientôt'}</span>
				</div>
			)
		}
		<h3>{title}</h3>
		{
			compact ? (
				// The title rides the art as a plaque, so the panel below is free for the
				// record itself. Levels belong on the catalogue, not on the daily tile.
				<div class="tile-info">
					<div class="chip-row">
						{playable && id && daily && <span class="daily-chip" data-game-id={id} data-short hidden />}
						{playable && id && daily && <span class="streak-badge" data-game-id={id} hidden />}
					</div>
					{playable && id && daily && <span class="tile-note" hidden />}
				</div>
			) : (
				<Fragment>
					{playable && id && daily && <span class="daily-chip" data-game-id={id} hidden />}
					{playable && id && daily && <span class="streak-badge" data-game-id={id} hidden />}
					{playable && id && <span class="level-badge" data-game-id={id} hidden />}
					<p>{pitch}</p>
				</Fragment>
			)
		}
	</Tag>
	{
		showFavorite && (
			<button
				type="button"
				class="fav-toggle"
				data-game-id={id}
				aria-pressed="false"
				aria-label={`Mettre ${title} en favori`}
			>
				<svg viewBox="0 0 256 256" width="22" height="22" aria-hidden="true">
					<path d="M128 216S28 160 28 92a52 52 0 0 1 100-20h0a52 52 0 0 1 100 20c0 68-100 124-100 124Z" />
				</svg>
			</button>
		)
	}
</div>

<style>
	.game-card-wrap {
		position: relative;
		height: 100%;
	}

	.game-card-wrap.has-fav .game-card {
		/* keep room so a long pitch never slides under the heart */
		padding-bottom: 3.25rem;
	}

	.fav-toggle {
		position: absolute;
		bottom: 1rem;
		right: 1rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.35rem;
		border: none;
		border-radius: 999rem;
		background: transparent;
		color: var(--gray-400);
		cursor: pointer;
		line-height: 0;
		transition:
			color var(--theme-transition),
			transform var(--theme-transition);
	}

	.fav-toggle svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 18;
		stroke-linejoin: round;
	}

	.fav-toggle:hover,
	.fav-toggle:focus-visible {
		color: var(--accent-regular);
		transform: scale(1.12);
	}

	.fav-toggle.is-fav {
		color: var(--accent-regular);
	}

	.fav-toggle.is-fav svg {
		fill: currentColor;
	}

	.game-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		gap: 0.75rem;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		padding: 1.75rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		color: inherit;
		transition:
			transform var(--theme-transition),
			border-color var(--theme-transition),
			box-shadow var(--theme-transition);
	}

	a.game-card:hover,
	a.game-card:focus-visible {
		transform: translateY(-4px);
		border-color: var(--accent-regular);
		box-shadow: var(--shadow-md);
	}

	.game-card.soon {
		opacity: 0.55;
		cursor: default;
	}

	/* Compact tile: full-bleed key art, then a two-line caption. */
	.game-card.compact {
		position: relative;
		overflow: hidden;
		gap: 0;
		padding: 0;
		border-radius: 1.1rem;
		background-color: var(--gray-999);
	}

	.game-card.compact .game-card-media {
		border-radius: 0;
		flex: none;
		transition: filter var(--theme-transition);
	}

	.game-card.compact .game-card-media img {
		transition: transform var(--theme-transition);
	}

	a.game-card.compact:hover .game-card-media img,
	a.game-card.compact:focus-visible .game-card-media img {
		transform: scale(1.06);
	}

	/* Plaque over the art: the scenes are prompted with their ground plane at the
	   bottom, so the top strip is sky and the title always lands on quiet pixels. */
	.game-card.compact h3 {
		position: absolute;
		top: 0.4rem;
		left: 0.4rem;
		max-width: calc(100% - 0.8rem);
		margin: 0;
		padding: 0.18rem 0.45rem;
		border-radius: 0.55rem;
		font-size: var(--text-base);
		line-height: 1.15;
		color: #fff;
		background: rgba(18, 14, 28, 0.58);
		backdrop-filter: blur(6px);
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
	}

	/* Only a done tile carries the corner check — give the plaque room just then. */
	:global(.is-done) .game-card.compact h3 {
		max-width: calc(100% - 2.6rem);
	}

	.game-card.compact .badge.soon {
		align-self: flex-start;
		margin: 0.55rem 0.7rem 0;
	}

	.tile-info {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.5rem 0.6rem 0.6rem;
	}

	.chip-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem;
	}

	.tile-note {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: 11px;
		line-height: 1.3;
		color: var(--gray-400);
	}

	.tile-note[hidden] {
		display: none;
	}

	.chip-row .daily-chip {
		display: block;
		min-width: 0;
		max-width: 100%;
		font-size: 12px;
		padding: 3px 8px;
		line-height: 1.4;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* Done today: the art steps back and a check takes the corner, so the caption can
	   keep its full contrast instead of fading away with the tile. */
	:global(.is-done) .game-card.compact .game-card-media {
		filter: grayscale(0.85) brightness(0.7);
	}

	:global(.is-done) .game-card.compact::after {
		content: '✓';
		position: absolute;
		top: 0.45rem;
		right: 0.45rem;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 999rem;
		display: grid;
		place-items: center;
		font-weight: 700;
		font-size: 0.85rem;
		color: var(--accent-text-over);
		background: var(--accent-regular);
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
	}

	.game-card-media {
		border-radius: 0.75rem;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		background: var(--gray-800);
	}

	.game-card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.game-card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.badge {
		font-family: var(--font-brand);
		font-weight: 500;
		font-size: var(--text-sm);
		line-height: 1;
		padding: 0.4rem 0.85rem;
		border-radius: 999rem;
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
		white-space: nowrap;
	}

	.badge.soon {
		color: var(--gray-300);
		background-color: transparent;
		border: 1px solid var(--gray-700);
	}

	.game-card h3 {
		font-size: var(--text-lg);
		margin: 0;
	}

	.daily-chip {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--font-brand);
		font-weight: 500;
		font-size: var(--text-sm);
		line-height: 1;
		padding: 0.3rem 0.7rem;
		border-radius: 999rem;
		border: 1px solid var(--gray-700);
		color: var(--gray-300);
	}

	.daily-chip.progress {
		border-color: var(--accent-regular);
		color: var(--accent-regular);
	}

	.daily-chip.done {
		border-color: var(--accent-regular);
		background-color: var(--accent-regular);
		color: var(--accent-text-over);
	}

	.streak-badge {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		gap: 3px;
		font-family: var(--font-brand);
		font-weight: 800;
		font-size: 12px;
		line-height: 1;
		padding: 3px 9px;
		border-radius: 999rem;
		color: #f5a623;
		background: rgba(245, 166, 35, 0.12);
		border: 1px solid rgba(245, 166, 35, 0.4);
	}

	.level-badge {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		gap: 3px;
		font-family: var(--font-brand);
		font-weight: 700;
		font-size: 12px;
		line-height: 1;
		padding: 3px 9px;
		border-radius: 999rem;
		color: var(--accent-regular);
		background: var(--accent-overlay);
		border: 1px solid var(--accent-regular);
	}

	/* [hidden] must win over the display above, else empty badges show as blank pills. */
	.daily-chip[hidden],
	.streak-badge[hidden],
	.level-badge[hidden] {
		display: none;
	}

	.game-card p {
		color: var(--gray-400);
		margin: 0;
		font-size: var(--text-base);
	}

	@media (min-width: 50em) {
		.game-card h3 {
			font-size: var(--text-xl);
		}
	}
</style>

<script>
	import { fetchDailyTops, leaderboardEnabled } from '../lib/leaderboard';
	import { fetchDailyTopsSecure } from '../lib/scores';
	import { DAILY_LB } from '../data/dailyLb';
	import { formatScore } from '../lib/scoreFormat';
	import { gameStreak } from '../lib/streak';
	import { challengeDay, dayBefore } from '../lib/day';
	import { hasUnlock } from '../lib/wallet';
	import { LEVEL_COUNT } from '../lib/progression';

	// Favorites toggle — persisted in localStorage, shared key with the home page.
	const KEY = 'ludiven-favorites';

	const read = (): string[] => {
		try {
			return JSON.parse(localStorage.getItem(KEY) || '[]');
		} catch {
			return [];
		}
	};

	const sync = () => {
		const favs = read();
		document.querySelectorAll<HTMLButtonElement>('.fav-toggle').forEach((btn) => {
			const on = favs.includes(btn.dataset.gameId || '');
			btn.classList.toggle('is-fav', on);
			btn.setAttribute('aria-pressed', String(on));
		});
	};

	document.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.fav-toggle');
		if (!btn) return;
		e.preventDefault();
		const id = btn.dataset.gameId;
		if (!id) return;
		const favs = read();
		const i = favs.indexOf(id);
		if (i >= 0) favs.splice(i, 1);
		else favs.push(id);
		localStorage.setItem(KEY, JSON.stringify(favs));
		sync();
	});

	sync();

	// Daily challenge status — same localStorage key as each game's daily run.
	const syncDaily = () => {
		const day = challengeDay();
		document.querySelectorAll<HTMLElement>('.daily-chip').forEach((chip) => {
			const id = chip.dataset.gameId;
			if (!id) return;
			let started = false;
			let done = false;
			try {
				const raw = localStorage.getItem(`ludiven-dailyrun-${id}-${day}`);
				if (raw) {
					started = true;
					done = JSON.parse(raw)?.done === true;
				}
			} catch {
				/* ignore */
			}
			// Player's best-of-day record (some games log it under `${id}-t`).
			let rec: { m?: string; t?: string } | null = null;
			try {
				const raw = localStorage.getItem(`ludiven-dayrec-${id}-${day}`) || localStorage.getItem(`ludiven-dayrec-${id}-t-${day}`);
				if (raw) rec = JSON.parse(raw);
			} catch {
				/* ignore */
			}
			const recTxt = rec?.t ? `${rec.t}${rec.m === 'score' ? ' pts' : ''}` : '';
			// Compact tiles split the record: the value in the chip, who holds it below.
			const short = chip.hasAttribute('data-short');
			const note = short ? chip.closest('.game-card')?.querySelector<HTMLElement>('.tile-note') : null;
			const setNote = (txt: string) => {
				if (!note) return;
				note.textContent = txt;
				note.hidden = !txt;
			};
			// "joueur" rather than "participant": the note has to hold on one line.
			const holder = (name: string, players: number) =>
				`${name}${players ? ` · ${players} joueur${players > 1 ? 's' : ''}` : ''}`;
			chip.classList.toggle('done', done);
			chip.classList.toggle('progress', started && !done);
			// Tag the card so pages (e.g. the daily page) can reorder / dim by status.
			const wrap = chip.closest('.game-card-wrap');
			wrap?.classList.toggle('daily-done', done);
			wrap?.classList.toggle('daily-todo', !done);
			wrap?.dispatchEvent(new CustomEvent('daily-status', { bubbles: true, detail: { id, done, started } }));
			// Community record of the day (Supabase), shown even for games not yet played.
			const cfg = DAILY_LB[id];
			const top = cfg ? tops[cfg.lbId || id] : undefined;
			if (top) {
				const nb = top.players || 0;
				const val = formatScore(cfg!.fmt, top.value);
				const who = `${val ? `${val} · ` : ''}${top.name}`;
				chip.title = `Record du jour : ${who}${nb ? ` · ${nb} participant${nb > 1 ? 's' : ''}` : ''}`;
				chip.textContent = short
					? `🏆 ${val || top.name}`
					: `${done ? '✓ ' : ''}🏆 ${who}${nb ? ` · ${nb} participant${nb > 1 ? 's' : ''}` : ''}`;
				setNote(holder(top.name, nb));
			} else if (done || started) {
				const mark = done ? '✓' : '⏳';
				chip.textContent = short
					? recTxt
						? `${mark} ${recTxt}`
						: `${mark} ${done ? 'Fait' : 'En cours'}`
					: done
						? recTxt
							? `✓ Record du jour : ${recTxt}`
							: '✓ Défi du jour fait'
						: recTxt
							? `⏳ En cours · ${recTxt}`
							: '⏳ Défi en cours';
				setNote(recTxt ? 'Ton record du jour' : '');
			} else {
				// No record yet today (the daily board resets each morning): fall back to
				// yesterday's record, else invite to be the first.
				const ytop = cfg ? yTops[cfg.lbId || id] : undefined;
				if (ytop) {
					const nb = ytop.players || 0;
					chip.title = `Record d'hier${nb ? ` · ${nb} participant${nb > 1 ? 's' : ''}` : ''}`;
					const val = formatScore(cfg!.fmt, ytop.value);
					chip.textContent = short
						? `🏆 Hier ${val || ytop.name}`
						: `🏆 Hier : ${val ? `${val} · ` : ''}${ytop.name}${nb ? ` · ${nb} participant${nb > 1 ? 's' : ''}` : ''}`;
					setNote(holder(ytop.name, nb));
				} else {
					chip.title = "Personne n'a encore joué le défi du jour";
					chip.textContent = short ? '🏆 Sois le premier' : "🏆 Sois le premier aujourd'hui !";
					setNote('');
				}
			}
			chip.hidden = false;
		});
	};

	// Per-game daily streak badge (🔥 N consecutive days).
	const syncStreak = () => {
		document.querySelectorAll<HTMLElement>('.streak-badge').forEach((badge) => {
			const id = badge.dataset.gameId;
			if (!id) return;
			const s = gameStreak(id);
			if (s.count > 0) {
				badge.textContent = `🔥 ${s.count}`;
				badge.title = `${s.count} jour${s.count > 1 ? 's' : ''} d'affilée${s.atRisk ? ' · joue aujourd\'hui pour la garder' : ''}`;
				badge.hidden = false;
			} else {
				badge.hidden = true;
			}
		});
	};

	// Per-game levels progress badge (🎯 current level), read from the local progression
	// mirror. Hidden for games with no levels or no progress yet. The Expert pack doubles
	// the cap, so "Fini" must not fire at 100 on a game that now goes to 200.
	const syncLevels = () => {
		document.querySelectorAll<HTMLElement>('.level-badge').forEach((badge) => {
			const id = badge.dataset.gameId;
			if (!id) return;
			let stars: Record<string, number> = {};
			try {
				const raw = localStorage.getItem(`ludiven-progress-${id}`);
				if (raw) stars = JSON.parse(raw)?.stars ?? {};
			} catch {
				/* ignore */
			}
			const cleared = Object.keys(stars).map(Number).filter((n) => stars[n] >= 1);
			if (cleared.length === 0) {
				// Not played yet → invite to start at level 1.
				badge.textContent = '🎯 Niveau 1';
				badge.title = 'Commence les niveaux';
				badge.hidden = false;
				return;
			}
			const maxCleared = Math.max(...cleared);
			if (maxCleared >= LEVEL_COUNT * (hasUnlock(id) ? 2 : 1)) {
				const total = cleared.reduce((a, n) => a + (stars[n] || 0), 0);
				badge.textContent = `🎯 Fini · ${total}★`;
			} else {
				badge.textContent = `🎯 Niveau ${maxCleared + 1}`;
			}
			badge.title = 'Ta progression en mode Niveaux';
			badge.hidden = false;
		});
	};

	// Community daily records (one Supabase request), then refresh the chips.
	let tops: Record<string, { name: string; value: number; players: number }> = {};
	let yTops: Record<string, { name: string; value: number; players: number }> = {};
	const loadTops = async () => {
		if (!leaderboardEnabled()) return;
		try {
			tops = await fetchDailyTops();
		} catch {
			/* ignore */
		}
		syncDaily();
		// Some cards without a record today → fetch yesterday's tops for the fallback.
		const missing = Array.from(document.querySelectorAll<HTMLElement>('.daily-chip')).some((chip) => {
			const id = chip.dataset.gameId;
			const cfg = id ? DAILY_LB[id] : undefined;
			return cfg ? !tops[cfg.lbId || id!] : false;
		});
		if (!missing) return;
		const yday = dayBefore(challengeDay());
		yTops = await fetchDailyTopsSecure(yday);
		syncDaily();
	};

	syncDaily();
	syncStreak();
	syncLevels();
	loadTops();
	// Refresh when returning to the page (tab focus, and back-nav restored from bfcache).
	document.addEventListener('visibilitychange', () => {
		if (!document.hidden) {
			syncDaily();
			syncStreak();
			syncLevels();
		}
	});
	window.addEventListener('pageshow', () => {
		syncDaily();
		syncStreak();
		syncLevels();
	});
</script>
