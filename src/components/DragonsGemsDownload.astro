---
// The Dragon Gems Swipe download page, in five languages: the store badges (a store that does not list the game yet
// says so), then the web game.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import AppStage from './AppStage.astro';
import MoreApps from './MoreApps.astro';
import DragonsGemsBadges from './DragonsGemsBadges.astro';
import { HOME_GAMES } from '../data/homeGames';
import ShareButton from './ShareButton.astro';
import { APP_NAME, DOWNLOAD_PATHS, ICON, LANDING_PATHS, WEB_GAME, copy, ogImage, screens, typo, type Lang } from '../data/dragonsGems';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const ty = (s: string) => typo(lang, s);
const stage = HOME_GAMES.find((g) => g.id === 'dragons-gems')!.art;
const shots = screens(lang);
const options = [
	{ href: WEB_GAME, icon: 'eclats' as const, title: t.playWeb, note: t.playWebNote },
];
---

<BaseLayout title={t.dl.title} description={t.description} image={ogImage(lang)} lang={lang} alternates={DOWNLOAD_PATHS}>
	<div>
		<AppStage lang={lang} name={APP_NAME} icon={ICON} kicker={t.dl.kicker} lead={ty(t.dl.lead)} art={{ ...stage, src: stage.src[lang] }}>
			<DragonsGemsBadges lang={lang} />
			<p class="waiting">{ty(t.dl.waiting)}</p>
			<div class="options">
				{options.map((o) => (
					<a class="option" href={o.href}>
						<Icon icon={o.icon} color="var(--sc-gold)" size="1.8rem" />
						<span>
							<strong>{o.title}</strong>
							<small>{ty(o.note)}</small>
						</span>
					</a>
				))}
			</div>
			<div class="as-actions">
				<a class="sc-link" href={LANDING_PATHS[lang]}>{t.dl.back} <Icon icon="arrow-right" size="1em" /></a>
				<ShareButton id="dragons-gems" title={APP_NAME} lang={lang} />
			</div>
		</AppStage>
	</div>

	<main class="wrapper">
		<div class="dg-dl stack gap-12">
			<section class="stack gap-6">
				<h2>{t.dl.screensTitle}</h2>
				<div class="shots">
					{shots.map((src, i) => <img src={src} alt={ty(t.shotsAlt[i] ?? '')} width="540" height="1170" loading="lazy" decoding="async" />)}
				</div>
			</section>

			<MoreApps lang={lang} current="dragons-gems" />
		</div>
	</main>
</BaseLayout>

<style>
	.dg-dl {
		padding-block: 1rem 4rem;
	}

	h2 {
		font-size: var(--text-xl);
		color: var(--sc-ink);
		text-align: center;
	}

	.waiting {
		color: var(--sc-night-muted);
		font-weight: 600;
	}

	.options {
		display: grid;
		gap: 0.75rem;
	}

	.option {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--sc-night-line);
		border-radius: 1rem;
		background-color: var(--sc-night-surface-2);
		color: inherit;
		text-decoration: none;
		transition: transform 0.15s ease, border-color 0.15s ease;
	}

	.option:hover,
	.option:focus-visible {
		transform: translateY(-2px);
		border-color: var(--sc-gold);
	}

	.option span {
		display: grid;
		gap: 0.15rem;
	}

	.option strong {
		color: var(--sc-night-ink);
	}

	.option small {
		color: var(--sc-night-muted);
		font-size: var(--text-sm);
	}

	.shots {
		display: grid;
		gap: 1.25rem;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
	}

	.shots img {
		width: 100%;
		height: auto;
		border-radius: 1.25rem;
		border: 1px solid var(--sc-line);
		box-shadow: var(--sc-shadow);
	}

	@media (prefers-reduced-motion: reduce) {
		.option {
			transition: none;
		}

		.option:hover,
		.option:focus-visible {
			transform: none;
		}
	}

	@media (min-width: 50em) {
		.shots {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
