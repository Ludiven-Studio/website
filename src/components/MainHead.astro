---
import '../styles/global.css';
import { UMAMI_WEBSITE_ID, SUPABASE_URL } from '../data/site';
import { getImage } from 'astro:assets';
import logo from '../assets/LudivenStudioLogo.png';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	image?: string | undefined; // root-relative or absolute og image (defaults to the studio logo)
	type?: string | undefined; // og:type (website | article)
	noindex?: boolean | undefined; // keep this page out of search engines
	lang?: 'fr' | 'en' | 'es' | undefined;
	altLang?: string | undefined; // path of the same page in the other language
	/** Every language version of the page, when there are more than two. Wins over altLang. */
	alternates?: Partial<Record<'fr' | 'en' | 'es', string>> | undefined;
}

const {
	title = 'Ludiven Studio',
	description = 'Ludiven Studio — création d\'applications et de jeux qui ont du sens et facilitent le quotidien',
	image,
	type = 'website',
	noindex = false,
	lang = 'fr',
	altLang,
	alternates,
} = Astro.props;

// GitHub Pages sends no headers, so the policy rides in a <meta> (no frame-ancestors there).
// 'unsafe-inline' scripts: the theme script and Astro's small hoisted scripts are inline. The
// gain is elsewhere: no foreign script host, and nowhere to send stolen data.
// Checked page by page with scripts/check-csp.mjs — run it after adding any outside host.
const supabaseWs = SUPABASE_URL.replace(/^https:/, 'wss:');
const csp = [
	"default-src 'self'",
	"script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cloud.umami.is",
	"style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
	"font-src 'self' data: https://fonts.gstatic.com",
	"img-src 'self' data: blob: https://*.tile.openstreetmap.org",
	`connect-src 'self' data: blob: ${SUPABASE_URL} ${supabaseWs} https://cloud.umami.is https://api-gateway.umami.dev https://api.web3forms.com https://*.tile.openstreetmap.org`,
	"media-src 'self' data: blob:",
	"worker-src 'self' blob:",
	"object-src 'none'",
	"base-uri 'self'",
	"form-action 'self' https://api.web3forms.com",
].join('; ');

const siteName = 'Ludiven Studio';
const canonical = new URL(Astro.url.pathname, Astro.site);
// Custom images are our 1200×630 game previews; only the logo fallback keeps its own ratio.
let ogW = Math.min(1200, logo.width);
let ogH = Math.round((logo.height / logo.width) * ogW);
let ogImage: string;
if (image) {
	ogW = 1200;
	ogH = 630;
	ogImage = new URL(image, Astro.site).href;
} else {
	const ogGen = await getImage({ src: logo, width: ogW, format: 'png' });
	ogImage = new URL(ogGen.src, Astro.site).href;
}
---

<meta charset="UTF-8" />
<meta http-equiv="Content-Security-Policy" content={csp} />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonical} />
{
	alternates && (
		<>
			{Object.entries(alternates).map(([l, p]) => <link rel="alternate" hreflang={l} href={new URL(p, Astro.site)} />)}
			<link rel="alternate" hreflang="x-default" href={new URL(alternates.fr ?? Astro.url.pathname, Astro.site)} />
		</>
	)
}
{
	!alternates && altLang && (
		<>
			<link rel="alternate" hreflang={lang} href={canonical} />
			<link rel="alternate" hreflang={lang === 'fr' ? 'en' : 'fr'} href={new URL(altLang, Astro.site)} />
			<link rel="alternate" hreflang="x-default" href={lang === 'fr' ? canonical : new URL(altLang, Astro.site)} />
		</>
	)
}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === 'en' ? 'en_GB' : lang === 'es' ? 'es_ES' : 'fr_FR'} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(ogW)} />
<meta property="og:image:height" content={String(ogH)} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{/* Tab favicon wears the "LS" monogram; the wordmark only stays readable at home-screen size. */}
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=3" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />

<!-- PWA: home-screen shortcut (icon + name + standalone). -->
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#090b11" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="Ludiven" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,700;1,400&family=Rubik:wght@500;600&display=swap"
	rel="stylesheet"
/>
{
	UMAMI_WEBSITE_ID && (
		<script
			is:inline
			defer
			src="https://cloud.umami.is/script.js"
			data-website-id={UMAMI_WEBSITE_ID}
			data-domains="www.ludiven-studio.fr"
			data-exclude-search="true"
		/>
	)
}
<script is:inline>
	// This code is inlined in the head to make dark mode instant & blocking.
	const getThemePreference = () => {
		if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
			return localStorage.getItem('theme');
		}
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	};
	const isDark = getThemePreference() === 'dark';
	document.documentElement.classList[isDark ? 'add' : 'remove']('theme-dark');

	if (typeof localStorage !== 'undefined') {
		// Watch the document element and persist user preference when it changes.
		const observer = new MutationObserver(() => {
			const isDark = document.documentElement.classList.contains('theme-dark');
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		});
		observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
	}
</script>
