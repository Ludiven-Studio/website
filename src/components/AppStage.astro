---
// The head of an app's page: its night stage, like a slide of the homepage. The art fades in on the right of a
// desk and sits on top of a phone; the name, the pitch and the slot (badges, buttons) on the left or below.
// A breadcrumb leads back to the games of the homepage in the page's language.
import { HOME, type Lang } from '../data/siteNav';

interface Props {
	lang: Lang;
	name: string;
	icon: string;
	kicker: string;
	tagline?: string | undefined;
	lead?: string | undefined;
	art: { src: string; w: number; h: number; desk: string; phone: string };
	/** The art is what the page is about: a name for it, or empty when the title says it all. */
	alt?: string;
}

const CRUMB: Record<Lang, string> = { fr: 'Jeux', en: 'Games', es: 'Juegos', de: 'Spiele', it: 'Giochi' };
const { lang, name, icon, kicker, tagline, lead, art, alt = '' } = Astro.props;
---

<nav class="as-crumb" aria-label={lang === 'fr' ? "Fil d'Ariane" : 'Breadcrumb'}>
	<a href={HOME[lang]}>{CRUMB[lang]}</a>
	<span aria-hidden="true">›</span>
	<span aria-current="page">{name}</span>
</nav>

<header class="as" style={`--pos-desk: ${art.desk}; --pos-phone: ${art.phone}`}>
	<div class="as-art">
		<img src={art.src} alt={alt} width={art.w} height={art.h} fetchpriority="high" decoding="async" />
	</div>
	<div class="as-head">
		<div class="as-id">
			<img class="as-icon" src={icon} alt="" width="72" height="72" />
			<p class="as-kicker">{kicker}</p>
		</div>
		<h1 class="as-title">{name}</h1>
	</div>
	<div class="as-rest">
		{tagline && <p class="as-tagline">{tagline}</p>}
		{lead && <p class="as-lead">{lead}</p>}
		<slot />
	</div>
</header>

<style>
	.as-crumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		max-width: 76rem;
		margin: 0 auto 0.75rem;
		padding-inline: 1.25rem;
		color: var(--sc-muted);
		font-size: var(--text-sm);
	}
	.as-crumb a {
		color: var(--sc-link);
		font-weight: 600;
		text-decoration: none;
	}
	.as-crumb a:hover {
		text-decoration: underline;
	}

	/* A night scene in both themes. */
	.as {
		display: grid;
		grid-template-areas: 'art' 'rest';
		background: var(--sc-night-surface);
		color: var(--sc-night-ink);
	}

	.as-art {
		grid-area: art;
		position: relative;
		aspect-ratio: 13 / 9;
		overflow: hidden;
		background: var(--sc-night-surface-2);
	}
	.as-art img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--pos-phone);
	}
	.as-art::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgb(26 21 51 / 0) 35%, rgb(26 21 51 / 0.95) 100%);
	}

	.as-head {
		grid-area: art;
		align-self: end;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.6rem;
		padding: 0 1.25rem 1rem;
	}
	.as-id {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.as-icon {
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 22%;
		box-shadow: 0 6px 18px rgb(0 0 0 / 0.35);
	}
	.as-kicker {
		padding: 0.2rem 0.75rem;
		border-radius: 999rem;
		background: var(--sc-gold);
		color: var(--sc-gold-ink);
		font-weight: 700;
		font-size: 0.8125rem;
		line-height: 1.4;
	}
	.as-title {
		font-family: var(--font-brand);
		font-weight: 600;
		font-size: 2.375rem;
		line-height: 1.05;
		color: #fff;
	}

	.as-rest {
		grid-area: rest;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		padding: 0.75rem 1.25rem 1.75rem;
	}
	.as-tagline {
		color: var(--sc-gold);
		font-family: var(--font-brand);
		font-weight: 600;
		font-size: 1.125rem;
	}
	.as-lead {
		max-width: 38rem;
		color: var(--sc-night-muted);
		font-size: 1.0625rem;
		line-height: 1.55;
	}

	/* What the pages put in the slot: badges and links, on the night. */
	.as-rest :global(.store-badges) {
		--badge-h: 2.75rem;
		--soon-bg: var(--sc-gold);
		--soon-ink: var(--sc-gold-ink);
		justify-content: flex-start;
		margin-top: 0.4rem;
	}
	.as-rest :global(.sc-link) {
		color: var(--sc-night-link);
	}
	.as-rest :global(.share-btn) {
		border-color: var(--sc-night-line);
		color: var(--sc-night-muted);
	}
	.as-rest :global(.share-btn:hover) {
		border-color: var(--sc-night-link);
		color: var(--sc-night-ink);
	}
	.as-rest :global(.dg-soon-note),
	.as-rest :global(.soon-note) {
		color: var(--sc-night-muted);
		text-align: left;
	}
	.as-rest :global(.as-actions) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.9rem 1.4rem;
	}
	.as-rest :global(a:focus-visible),
	.as-rest :global(button:focus-visible) {
		outline: 3px solid var(--sc-gold);
		outline-offset: 3px;
	}

	@media (min-width: 56em) {
		.as-crumb {
			padding-inline: 1.5rem;
		}
		.as {
			position: relative;
			max-width: 73rem;
			margin-inline: auto;
			grid-template-columns: minmax(0, 36rem) 1fr;
			grid-template-areas: 'head .' 'rest .';
			grid-template-rows: auto 1fr;
			min-height: 32rem;
			border-radius: 1.75rem;
			overflow: hidden;
		}
		.as-art {
			position: absolute;
			inset: 0 0 0 auto;
			width: 54%;
			aspect-ratio: auto;
			background: none;
			-webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 28%);
			mask-image: linear-gradient(90deg, transparent 0%, #000 28%);
		}
		.as-art img {
			object-position: var(--pos-desk);
		}
		.as-art::after {
			content: none;
		}
		.as-head {
			grid-area: head;
			align-self: auto;
			gap: 1rem;
			padding: 2.75rem 3rem 0;
		}
		.as-icon {
			width: 4.5rem;
			height: 4.5rem;
		}
		.as-kicker {
			font-size: 0.875rem;
		}
		.as-title {
			font-size: clamp(2.75rem, 4.4vw, 3.75rem);
			line-height: 1;
		}
		.as-rest {
			grid-area: rest;
			padding: 1rem 3rem 3rem;
		}
		.as-tagline {
			font-size: 1.375rem;
		}
		.as-lead {
			font-size: 1.125rem;
		}
		.as-rest :global(.store-badges) {
			--badge-h: 3rem;
		}
	}
</style>
