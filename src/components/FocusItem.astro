---
// Focused-work item: a small animated icon (pure SVG + CSS, 4 s loop) and its text, tinted by --accent.
export type FocusIconId = 'structure' | 'physics' | 'ui' | 'assets' | 'tools' | 'loc' | 'sound';

interface Props {
	icon: FocusIconId;
	title: string;
	body: string;
}

const { icon, title, body } = Astro.props;

const accents: Record<FocusIconId, string> = {
	structure: '#8b5cf6',
	physics: '#f97316',
	ui: '#0ea5e9',
	assets: '#10b981',
	tools: '#f43f5e',
	loc: '#eab308',
	sound: '#14b8a6',
};
const langs = ['FR', 'EN', 'ES'];
const bars = [0, 1, 2, 3, 4];
---

<div class="focus-item" style={`--accent:${accents[icon]}`}>
<span class:list={['fi', `fi-${icon}`]} aria-hidden="true">
	<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
		{icon === 'structure' && (
			<g>
				<rect x="18" y="6" width="12" height="9" rx="2.5" fill="currentColor" stroke="none" />
				<path d="M24 15v7M12 22h24M12 22v6M36 22v6" class="wire" pathLength="1" />
				<rect x="6" y="30" width="12" height="9" rx="2.5" class="node n1" />
				<rect x="30" y="30" width="12" height="9" rx="2.5" class="node n2" />
			</g>
		)}

		{icon === 'physics' && (
			<g>
				<path d="M6 41h36" />
				<g class="ball"><circle cx="24" cy="12" r="6" fill="currentColor" stroke="none" /></g>
				<ellipse cx="24" cy="42" rx="7" ry="1.6" fill="currentColor" stroke="none" class="shadow" />
			</g>
		)}

		{icon === 'ui' && (
			<g>
				<rect x="8" y="6" width="32" height="36" rx="5" />
				<rect x="13" y="12" width="22" height="6" rx="3" fill="currentColor" stroke="none" opacity="0.25" />
				<rect x="13" y="21" width="22" height="6" rx="3" fill="currentColor" stroke="none" opacity="0.25" />
				<rect x="13" y="30" width="22" height="6" rx="3" fill="currentColor" stroke="none" opacity="0.25" />
				<rect x="13" y="12" width="22" height="6" rx="3" fill="currentColor" stroke="none" class="pick" />
			</g>
		)}

		{icon === 'assets' && (
			<g>
				<path d="M10 22l14-7 14 7v14l-14 7-14-7z" />
				<path d="M10 22l14 7 14-7M24 29v14" />
				<g class="drop"><path d="M24 2v9M20 7.5l4 4 4-4" /></g>
			</g>
		)}

		{icon === 'tools' && (
			<g>
				<g class="bug">
					<ellipse cx="22" cy="24" rx="6" ry="8" fill="currentColor" stroke="none" />
					<path d="M16 20l-4-2M16 27l-4 2M28 20l4-2M28 27l4 2M20 16l-2-4M24 16l2-4" stroke-width="2" />
				</g>
				<g class="lens">
					<circle cx="26" cy="22" r="9" />
					<path d="M32.5 28.5L40 36" stroke-width="3.5" />
				</g>
			</g>
		)}

		{icon === 'loc' && (
			<g>
				<path d="M8 10h32a3 3 0 0 1 3 3v17a3 3 0 0 1-3 3H22l-8 7v-7H8a3 3 0 0 1-3-3V13a3 3 0 0 1 3-3z" />
				{langs.map((l, i) => (
					<text x="24" y="26" text-anchor="middle" class="lang" style={`--d:${i * -4 / 3}s`}>{l}</text>
				))}
			</g>
		)}

		{icon === 'sound' && (
			<g>
				{bars.map((i) => (
					<rect x={7 + i * 7.5} y="10" width="4.5" height="30" rx="2.25" fill="currentColor" stroke="none" class="bar" style={`--d:${i * -0.37}s`} />
				))}
			</g>
		)}
	</svg>
</span>
	<div>
		<h3>{title}</h3>
		<p>{body}</p>
	</div>
</div>

<style>
	.focus-item {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		height: 100%;
		padding: 1rem;
		border-radius: 1rem;
		background: color-mix(in srgb, var(--accent) 6%, transparent);
		border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.focus-item:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--accent) 45%, transparent);
	}

	.focus-item h3 {
		font-size: var(--text-md);
		color: var(--gray-0);
		margin-bottom: 0.25rem;
	}

	.focus-item p {
		color: var(--gray-400);
	}

	.fi {
		display: grid;
		place-items: center;
		flex: none;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 1rem;
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 14%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 28%, transparent);
	}

	.fi svg {
		width: 2.25rem;
		height: 2.25rem;
		overflow: visible;
	}

	.fi * {
		animation-duration: 4s;
		animation-iteration-count: infinite;
		animation-timing-function: ease-in-out;
		transform-box: fill-box;
		transform-origin: center;
	}

	@media (prefers-reduced-motion: reduce) {
		.fi * {
			animation: none !important;
		}
	}

	/* structure: the tree draws, then its leaves pop in */
	.wire { stroke-dasharray: 1; animation-name: fi-wire; }
	.node { animation-name: fi-node; }
	.n2 { animation-delay: 0.2s; }
	@keyframes fi-wire {
		0% { stroke-dashoffset: 1; }
		25%, 100% { stroke-dashoffset: 0; }
	}
	@keyframes fi-node {
		0%, 20% { transform: scale(0); }
		32%, 90% { transform: scale(1); opacity: 1; }
		100% { transform: scale(1); opacity: 0; }
	}

	/* physics: a ball bounces, squashes on landing */
	.ball { animation-name: fi-bounce; animation-duration: 1.2s; animation-timing-function: linear; transform-origin: 50% 100%; }
	.shadow { animation-name: fi-shadow; animation-duration: 1.2s; animation-timing-function: linear; }
	@keyframes fi-bounce {
		0% { transform: translateY(0); animation-timing-function: cubic-bezier(0.5, 0, 1, 0.6); }
		45% { transform: translateY(23px) scale(1, 1); }
		50% { transform: translateY(23px) scale(1.25, 0.75); animation-timing-function: cubic-bezier(0, 0.4, 0.5, 1); }
		55% { transform: translateY(23px) scale(1, 1); }
		100% { transform: translateY(0); }
	}
	@keyframes fi-shadow {
		0%, 100% { transform: scaleX(0.5); opacity: 0.15; }
		50% { transform: scaleX(1); opacity: 0.35; }
	}

	/* ui: the highlight walks down the menu, then clicks */
	.pick { animation-name: fi-pick; }
	@keyframes fi-pick {
		0%, 20% { transform: translateY(0); }
		30%, 50% { transform: translateY(9px); }
		60%, 75% { transform: translateY(18px) scale(1); }
		80% { transform: translateY(18px) scale(0.9); }
		85%, 92% { transform: translateY(18px) scale(1); }
		100% { transform: translateY(0); }
	}

	/* assets: an arrow drops into the box, the box nods */
	.drop { animation-name: fi-drop; }
	@keyframes fi-drop {
		0% { transform: translateY(-6px); opacity: 0; }
		15% { opacity: 1; }
		45% { transform: translateY(10px); opacity: 1; }
		55%, 100% { transform: translateY(12px); opacity: 0; }
	}

	/* tools: the lens sweeps over a bug that crawls away */
	.lens { animation-name: fi-lens; }
	.bug { animation-name: fi-bug; }
	@keyframes fi-lens {
		0%, 100% { transform: translate(-3px, 2px) rotate(-8deg); }
		50% { transform: translate(3px, -2px) rotate(8deg); }
	}
	@keyframes fi-bug {
		0%, 100% { transform: translate(0, 0); }
		25% { transform: translate(2px, -2px) rotate(10deg); }
		50% { transform: translate(-1px, 2px) rotate(-6deg); }
		75% { transform: translate(-2px, -1px) rotate(4deg); }
	}

	/* loc: the bubble cycles through languages */
	.lang {
		font-size: 12px;
		font-weight: 800;
		fill: currentColor;
		stroke: none;
		opacity: 0;
		animation-name: fi-lang;
		animation-delay: var(--d);
	}
	@keyframes fi-lang {
		0% { opacity: 0; transform: translateY(4px); }
		6%, 28% { opacity: 1; transform: translateY(0); }
		34%, 100% { opacity: 0; transform: translateY(-4px); }
	}
	@media (prefers-reduced-motion: reduce) {
		.lang:first-of-type { opacity: 1; }
	}

	/* sound: an equaliser */
	.bar { transform-origin: 50% 100%; animation-name: fi-eq; animation-duration: 1.1s; animation-delay: var(--d); }
	@keyframes fi-eq {
		0%, 100% { transform: scaleY(0.3); }
		50% { transform: scaleY(1); }
	}
	@media (prefers-reduced-motion: reduce) {
		.bar { transform: scaleY(0.6); }
	}
</style>
