---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import GameTutorial from '../components/GameTutorial.astro';
import CocoinBar from '../components/CocoinBar';
import CocoinToast from '../components/CocoinToast';
import DefiChallenge from '../components/DefiChallenge';
import { games } from '../data/games';
import { DAILY_LB } from '../data/dailyLb';

interface Props {
	title: string;
	description: string;
	heading: string;
	tagline: string;
	gameId: string;
}

const { title, description, heading, tagline, gameId } = Astro.props;
// Every listed game has a backdrop (scripts/comfy-thumbs.mjs writes it next to the card);
// the few unlisted pages don't.
const hasArt = games.some((g) => g.id === gameId);
const hasDaily = gameId in DAILY_LB;
---

<BaseLayout title={title} description={description}>
	<script>
		// Watch the game island and speak up when it dies, in either of the two ways it can.
		const page = document.querySelector('.game-page');
		const box = document.querySelector('.game-down') as HTMLElement | null;
		if (page && box) {
			const kids = [...page.children];
			// Only an island ABOVE the footer is the game: the cocoin toast is one too, it sits
			// below, and it is legitimately empty until a reward pops.
			const end = kids.findIndex((el) => el.classList.contains('game-foot'));
			const island = kids.find((el, i) => i < end && el.tagName === 'ASTRO-ISLAND');
			const btn = box.querySelector('button')!;
			let reloadOnly = false;
			const show = (crashed: boolean) => {
				if (box.classList.contains('on')) return;
				if (crashed) {
					reloadOnly = true;
					box.querySelector('.game-down-title')!.textContent = "Le jeu s'est interrompu.";
					box.querySelector('.game-down-hint')!.textContent = 'Une erreur inattendue a arrêté la partie.';
					btn.textContent = 'Recharger la page';
				}
				box.classList.add('on');
			};
			if (island) {
				// Never rendered. `load` has already waited for the whole module graph, so an
				// island still empty a few seconds later is dead, not slow.
				addEventListener('load', () => setTimeout(() => {
					if (!island.childElementCount) show(false);
				}, 4000));
				// Rendered, then emptied: React unmounts the whole root on an uncaught render or
				// effect error, so the island dropping back to zero children IS the crash. A throw
				// from a rAF callback leaves the DOM intact and is not caught here — an
				// ErrorBoundary would miss that one just the same.
				let mounted = false;
				const obs = new MutationObserver(() => {
					if (island.childElementCount) { mounted = true; return; }
					if (!mounted) return;
					obs.disconnect();
					show(true);
				});
				obs.observe(island, { childList: true });
			}
			btn.addEventListener('click', () => {
				if (reloadOnly) return location.reload();
				btn.disabled = true;
				btn.textContent = 'Nettoyage…';
				// Both, not just the caches: a worker whose install failed keeps serving the old
				// ones, so deleting the caches alone would leave it to fill them again.
				const caches$ = 'caches' in window
					? caches.keys().then((ks) => Promise.all(ks.map((k) => caches.delete(k))))
					: Promise.resolve();
				const sw$ = navigator.serviceWorker
					? navigator.serviceWorker.getRegistrations().then((rs) => Promise.all(rs.map((r) => r.unregister())))
					: Promise.resolve();
				Promise.all([caches$, sw$]).catch(() => {}).then(() => location.reload());
			});
		}
	</script>

	{hasArt && <div class="game-art" style={`--art: url('/assets/jeux/art/${gameId}.jpg')`} aria-hidden="true" />}
	<div class="wrapper game-page stack gap-4">
		{/* Kept to one line so the board is reachable without scrolling on a phone —
		    the pitch, the rules and the wallet wait below it. */}
		<header class="game-head">
			<a class="back" href="/jeux/">
				<Icon icon="arrow-left" size="1em" /> Tous les jeux
			</a>
			<h1>{heading}</h1>
			{hasDaily && <DefiChallenge client:load gameId={gameId} />}
		</header>

		<slot />

		{/* A game can fail to load outright — a cached chunk importing a hash the deploy removed —
		    or crash mid-play. Astro only console.errors the first, React says nothing about the
		    second, so the page just sits blank. This lives OUTSIDE the island on purpose: when the
		    island dies, it is all that is left. */}
		<div class="game-down">
			<p class="game-down-title">Le jeu n'a pas pu se charger.</p>
			<p class="game-down-hint">La version gardée en mémoire par ton navigateur est peut-être trop ancienne.</p>
			<button type="button">Vider le cache et réessayer</button>
			<a href="/jeux/">Retour aux jeux</a>
		</div>

		<footer class="game-foot stack gap-3">
			<p class="game-pitch">{tagline}</p>
			<GameTutorial gameId={gameId} />
			<CocoinBar client:load />
		</footer>

		{/* Outside .game-head on purpose: fullscreen hides the head, not the reward. */}
		<CocoinToast client:idle />
	</div>
</BaseLayout>

<style>
	/* Same key art as the game card, blurred behind the board: card and game share a scene. */
	.game-art {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		/* Bottom-anchored: the scenes are painted with their ground plane down there, so the
		   props end up around the board while the nav keeps the site gradient. */
		background: center bottom / cover no-repeat;
		/* The light page is bright pastel: a plain overlay washes the art out, multiply keeps
		   its colours. Dark pages need the opposite, the art is what lights them. */
		mix-blend-mode: multiply;
		opacity: 0.3;
		mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.6) 18%, #000 45%);
		-webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.6) 18%, #000 45%);
	}
	/* Loaded late like the other page backgrounds, so it never competes with the board. */
	:global(:root.loaded) .game-art {
		background-image: var(--art);
	}
	:global(:root.theme-dark) .game-art {
		mix-blend-mode: normal;
		opacity: 0.34;
	}
	@media (forced-colors: active) {
		.game-art {
			display: none;
		}
	}
	.game-page {
		align-items: center;
	}
	.game-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.35rem 0.9rem;
		width: 100%;
		text-align: center;
	}
	/* The challenge banner and the injected fullscreen button take their own line. */
	.game-head :global(.dc-banner),
	.game-head :global(.gf-btn) {
		flex-basis: 100%;
	}
	/* Hidden until the watchdog says otherwise. Centred on its own because fullscreen hides the
	   head and the footer, so this ends up alone on the screen. */
	.game-down {
		display: none;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		margin: auto;
		padding: 1.5rem 1.25rem;
		max-width: 34ch;
		text-align: center;
		border: 1px solid var(--gray-800);
		border-radius: 12px;
		background: var(--gray-999);
	}
	.game-down.on {
		display: flex;
	}
	.game-down-title {
		margin: 0;
		font-family: var(--font-brand);
		font-weight: 600;
		color: var(--gray-0);
	}
	.game-down-hint {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--gray-300);
	}
	.game-down button {
		font: inherit;
		font-weight: 600;
		font-size: var(--text-sm);
		padding: 8px 18px;
		border: none;
		border-radius: 999px;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		cursor: pointer;
	}
	.game-down a {
		font-size: var(--text-sm);
		color: var(--gray-300);
	}
	.game-foot {
		align-items: center;
		text-align: center;
		width: 100%;
		margin-top: 1.25rem;
	}
	.game-pitch {
		max-width: 60ch;
		margin: 0;
		color: var(--gray-300);
	}
	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--gray-300);
		text-decoration: none;
		font-family: var(--font-brand);
		font-weight: 500;
		font-size: var(--text-sm);
	}
	.back:hover,
	.back:focus-visible {
		color: var(--accent-regular);
	}
	.game-head h1 {
		font-size: var(--text-xl);
		margin: 0;
	}
	@media (min-width: 50em) {
		.game-head h1 {
			font-size: var(--text-2xl);
		}
	}
</style>
