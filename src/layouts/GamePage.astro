---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import GameTutorial from '../components/GameTutorial.astro';
import CocoinBar from '../components/CocoinBar';
import CocoinToast from '../components/CocoinToast';
import DefiChallenge from '../components/DefiChallenge';
import { games } from '../data/games';
import { DAILY_LB } from '../data/dailyLb';

interface Props {
	title: string;
	description: string;
	heading: string;
	tagline: string;
	gameId: string;
}

const { title, description, heading, tagline, gameId } = Astro.props;
// Every listed game has a backdrop (scripts/comfy-thumbs.mjs writes it next to the card);
// the few unlisted pages don't.
const hasArt = games.some((g) => g.id === gameId);
const hasDaily = gameId in DAILY_LB;
---

<BaseLayout title={title} description={description}>
	{hasArt && <div class="game-art" style={`--art: url('/assets/jeux/art/${gameId}.jpg')`} aria-hidden="true" />}
	<div class="wrapper game-page stack gap-8">
		<header class="game-head stack gap-2">
			<a class="back" href="/jeux/">
				<Icon icon="arrow-left" size="1em" /> Tous les jeux
			</a>
			<h1>{heading}</h1>
			<p>{tagline}</p>
			{hasDaily && <DefiChallenge client:load gameId={gameId} />}
			<GameTutorial gameId={gameId} />
			<CocoinBar client:load />
		</header>

		<slot />

		{/* Outside .game-head on purpose: fullscreen hides the head, not the reward. */}
		<CocoinToast client:idle />
	</div>
</BaseLayout>

<style>
	/* Same key art as the game card, blurred behind the board: card and game share a scene. */
	.game-art {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		/* Bottom-anchored: the scenes are painted with their ground plane down there, so the
		   props end up around the board while the nav keeps the site gradient. */
		background: center bottom / cover no-repeat;
		/* The light page is bright pastel: a plain overlay washes the art out, multiply keeps
		   its colours. Dark pages need the opposite, the art is what lights them. */
		mix-blend-mode: multiply;
		opacity: 0.3;
		mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.6) 18%, #000 45%);
		-webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.6) 18%, #000 45%);
	}
	/* Loaded late like the other page backgrounds, so it never competes with the board. */
	:global(:root.loaded) .game-art {
		background-image: var(--art);
	}
	:global(:root.theme-dark) .game-art {
		mix-blend-mode: normal;
		opacity: 0.34;
	}
	@media (forced-colors: active) {
		.game-art {
			display: none;
		}
	}
	.game-page {
		align-items: center;
	}
	.game-head {
		text-align: center;
		align-items: center;
	}
	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--gray-300);
		text-decoration: none;
		font-family: var(--font-brand);
		font-weight: 500;
		font-size: var(--text-sm);
	}
	.back:hover,
	.back:focus-visible {
		color: var(--accent-regular);
	}
	.game-head h1 {
		font-size: var(--text-3xl);
		margin-top: 0.5rem;
	}
	.game-head p {
		color: var(--gray-300);
	}
	@media (min-width: 50em) {
		.game-head h1 {
			font-size: var(--text-4xl);
		}
	}
</style>
