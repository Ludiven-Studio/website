---
// Learn about using Astro layouts:
// https://docs.astro.build/en/core-concepts/layouts/

// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GameFullscreen from '../components/GameFullscreen.astro';
import { games } from '../data/games';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	image?: string | undefined;
	type?: string | undefined;
	noindex?: boolean | undefined;
	lang?: 'fr' | 'en' | 'es' | 'de' | 'it' | undefined;
	altLang?: string | undefined; // path of the same page in the other language
	alternates?: Partial<Record<'fr' | 'en' | 'es' | 'de' | 'it', string>> | undefined;
	/** A game page outside /jeux/<id>/ (an event page): still gets the fullscreen chrome. */
	gameChrome?: boolean | undefined;
}

const { title, description, image, type, noindex, lang = 'fr', altLang, alternates, gameChrome } = Astro.props;

// Route-based structured data (JSON-LD): Organization + WebSite on the home page,
// VideoGame + BreadcrumbList on a game page — no per-page wiring needed.
const site = Astro.site!;
const path = Astro.url.pathname;
const pageUrl = new URL(path, site).href;
const isGamePage = /^\/jeux\/[^/]+\/?$/.test(path) && !/^\/jeux\/(defi|boutique)\/?$/.test(path); // a game page, not the index, the daily hub or the shop
// Matched game (if any) — reused for JSON-LD and the auto OG preview image.
const m = path.match(/^\/jeux\/([^/]+)\/?$/);
const g = m ? games.find((x) => x.id === m[1] || x.href === `/jeux/${m[1]}/`) : undefined;
// Portfolio pages get the same treatment at /assets/work/og/<slug>.jpg (npm run og:work).
// Guarded by existsSync so a slug with no baked file falls back to the studio logo
// instead of advertising a 404 to the crawlers.
const w = path.match(/^\/(?:en\/)?work\/([^/]+)\/?$/);
const workOg =
	w && existsSync(fileURLToPath(new URL(`../../public/assets/work/og/${w[1]}.jpg`, import.meta.url)))
		? `/assets/work/og/${w[1]}.jpg`
		: undefined;
// Every game gets a generated 1200×630 "in-situation" preview at /assets/jeux/og/<id>.jpg.
const ogImage = image ?? (g ? `/assets/jeux/og/${g.id}.jpg` : workOg);
let jsonLd: unknown[] | null = null;
if (path === '/' || path === '') {
	jsonLd = [
		{ '@context': 'https://schema.org', '@type': 'Organization', name: 'Ludiven Studio', url: site.href, logo: new URL('/apple-touch-icon.png', site).href, founder: { '@type': 'Person', name: 'Raphael Benedetto', jobTitle: 'Développeur Unity' } },
		{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Ludiven Studio', url: site.href, inLanguage: 'fr' },
	];
} else {
	if (g) {
		jsonLd = [
			{ '@context': 'https://schema.org', '@type': 'VideoGame', name: g.title, description: g.pitch, url: pageUrl, inLanguage: 'fr', genre: g.category ?? 'logique', applicationCategory: 'Game', operatingSystem: 'Web browser', author: { '@type': 'Organization', name: 'Ludiven Studio' }, offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' } },
			{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Accueil', item: site.href },
				{ '@type': 'ListItem', position: 2, name: 'Jeux', item: new URL('/jeux/', site).href },
				{ '@type': 'ListItem', position: 3, name: g.title, item: pageUrl },
			] },
		];
	}
}
---

<html lang={lang}>
	<head>
		<MainHead title={title} description={description} image={ogImage} type={type} noindex={noindex} lang={lang} altLang={altLang} alternates={alternates} />
		{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body>
		<div class="stack backgrounds">
			<Nav />
			<slot />
			<Footer />
		</div>

		{(isGamePage || gameChrome) && <GameFullscreen />}

		<script>
			// Add “loaded” class once the document has completely loaded.
			addEventListener('load', () => document.documentElement.classList.add('loaded'));

			// Register the service worker (offline play + faster repeat visits).
			// @vite-pwa/astro skips auto-injection when it doesn't manage the manifest,
			// so we register its generated sw.js ourselves.
			function updateBanner(reload: () => void) {
				const lang = document.documentElement.lang.slice(0, 2);
				const [text, action] =
					lang === 'es' ? ['Nueva versión disponible', 'Recargar']
					: lang === 'en' ? ['New version available', 'Reload']
					: lang === 'de' ? ['Neue Version verfügbar', 'Neu laden']
					: lang === 'it' ? ['Nuova versione disponibile', 'Ricarica']
					: ['Nouvelle version disponible', 'Recharger'];
				const bar = document.createElement('div');
				bar.className = 'sw-update';
				bar.setAttribute('role', 'status');
				bar.append(`${text} · `);
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.textContent = action;
				btn.addEventListener('click', reload);
				const close = document.createElement('button');
				close.type = 'button';
				close.className = 'sw-update-x';
				close.textContent = '✕';
				close.setAttribute('aria-label', 'OK');
				close.addEventListener('click', () => bar.remove());
				bar.append(btn, close);
				// Inside the game page: native fullscreen shows that element only.
				(document.querySelector('.game-page') ?? document.body).appendChild(bar);
			}

			if ('serviceWorker' in navigator) {
				addEventListener('load', () => {
					const sw = navigator.serviceWorker;
					// No controller on the very first visit → the first "controllerchange" is the
					// initial claim, not an update, so don't reload then.
					const hadController = !!sw.controller;
					let reloaded = false;
					sw.register('/sw.js').then((reg) => reg.update()).catch(() => {});
					// A new sw.js took control (skipWaiting + clientsClaim) → reload ONCE to pick up
					// the fresh assets, so a deploy applies without a manual cache clear.
					const reload = () => {
						if (reloaded) return;
						reloaded = true;
						location.reload();
					};
					sw.addEventListener('controllerchange', () => {
						if (reloaded || !hadController) return;
						if (!document.querySelector('.game-page')) return reload();
						// In a game the new worker lands ~30 s in on a phone (it precaches every game),
						// i.e. mid-match. Offer it, and take it when the page is put away. The timer
						// never fires if "hidden" is a navigation, which loads the new version anyway.
						document.addEventListener('visibilitychange', () => {
							if (document.visibilityState === 'hidden') setTimeout(reload, 300);
						});
						updateBanner(reload);
					});
					// Re-check for a new sw.js when a long-lived tab/PWA regains focus.
					document.addEventListener('visibilitychange', () => {
						if (document.visibilityState === 'visible') {
							sw.getRegistration().then((r) => r && r.update()).catch(() => {});
						}
					});
				});
			}
		</script>

		<style>
			/* Built by the script, so it carries no scope attribute. Top centre: the bottom belongs to
			   the games' pads and the corners to their HUD. */
			:global(.sw-update) {
				position: fixed; top: max(10px, env(safe-area-inset-top)); left: 50%; transform: translateX(-50%);
				z-index: 2147483647; display: flex; align-items: center; gap: 6px; max-width: calc(100vw - 24px);
				padding: 6px 6px 6px 14px; border-radius: 999px; background: var(--gray-999); color: var(--gray-0);
				border: 1.5px solid var(--accent-regular); box-shadow: var(--shadow-md);
				font: 600 13px/1.2 var(--font-body); white-space: nowrap;
			}
			:global(.sw-update button) {
				border: none; border-radius: 999px; padding: 5px 12px; cursor: pointer; font: inherit;
				background: var(--accent-regular); color: var(--accent-text-over);
			}
			:global(.sw-update button.sw-update-x) { background: transparent; color: var(--gray-300); padding: 5px 8px; }

			:root {
				--_placeholder-bg: linear-gradient(transparent, transparent);
				--bg-image-main: url('/assets/backgrounds/bg-main-light-800w.jpg');
				--bg-image-main-curves: url('/assets/backgrounds/bg-main-light.svg');
				--bg-image-subtle-1: var(--_placeholder-bg);
				--bg-image-subtle-2: var(--_placeholder-bg);
				--bg-image-footer: var(--_placeholder-bg);
				--bg-svg-blend-mode: overlay;
				--bg-blend-mode: darken;
				--bg-image-aspect-ratio: 2.25;
				--bg-scale: 1.68;
				--bg-aspect-ratio: calc(var(--bg-image-aspect-ratio) / var(--bg-scale));
				--bg-gradient-size: calc(var(--bg-scale) * 100%);
			}

			:root.theme-dark {
				--bg-image-main: url('/assets/backgrounds/bg-main-dark-800w.jpg');
				--bg-image-main-curves: url('/assets/backgrounds/bg-main-dark.svg');
				--bg-svg-blend-mode: darken;
				--bg-blend-mode: lighten;
			}

			/* These backgrounds are displayed below the fold, so we lazy load them
			   once the `.loaded` class has been set.  */
			:root.loaded {
				--bg-image-subtle-1: url('/assets/backgrounds/bg-subtle-1-light-800w.jpg');
				--bg-image-subtle-2: url('/assets/backgrounds/bg-subtle-2-light-800w.jpg');
				--bg-image-footer: url('/assets/backgrounds/bg-footer-light-800w.jpg');
			}
			:root.loaded.theme-dark {
				--bg-image-subtle-1: url('/assets/backgrounds/bg-subtle-1-dark-800w.jpg');
				--bg-image-subtle-2: url('/assets/backgrounds/bg-subtle-2-dark-800w.jpg');
				--bg-image-footer: url('/assets/backgrounds/bg-footer-dark-800w.jpg');
			}

			@media (min-width: 50em) {
				:root {
					--bg-scale: 1;
					--bg-image-main: url('/assets/backgrounds/bg-main-light-1440w.jpg');
				}
				:root.theme-dark {
					--bg-image-main: url('/assets/backgrounds/bg-main-dark-1440w.jpg');
				}

				:root.loaded {
					--bg-image-subtle-1: url('/assets/backgrounds/bg-subtle-1-light-1440w.jpg');
					--bg-image-subtle-2: url('/assets/backgrounds/bg-subtle-2-light-1440w.jpg');
					--bg-image-footer: url('/assets/backgrounds/bg-footer-light-1440w.jpg');
				}
				:root.loaded.theme-dark {
					--bg-image-subtle-1: url('/assets/backgrounds/bg-subtle-1-dark-1440w.jpg');
					--bg-image-subtle-2: url('/assets/backgrounds/bg-subtle-2-dark-1440w.jpg');
					--bg-image-footer: url('/assets/backgrounds/bg-footer-dark-1440w.jpg');
				}
			}

			.backgrounds {
				min-height: 100%;
				isolation: isolate;
				background:
					/*noise*/
					url('/assets/backgrounds/noise.png') top center/220px repeat,
					/*footer*/ var(--bg-image-footer) bottom center/var(--bg-gradient-size) no-repeat,
					/*header1*/ var(--bg-image-main-curves) top center/var(--bg-gradient-size) no-repeat,
					/*header2*/ var(--bg-image-main) top center/var(--bg-gradient-size) no-repeat,
					/*base*/ var(--gray-999);
				background-blend-mode: /*noise*/
					overlay,
					/*footer*/ var(--bg-blend-mode),
					/*header1*/ var(--bg-svg-blend-mode),
					/*header2*/ normal,
					/*base*/ normal;
			}
			@media (forced-colors: active) {
				/* Deactivate custom backgrounds for high contrast users. */
				.backgrounds {
					background: none;
					background-blend-mode: none;
					--bg-gradient-size: none;
				}
			}
		</style>
	</body>
</html>
