---
import BaseLayout from '../layouts/BaseLayout.astro';
import PetanqueLanding from '../components/PetanqueLanding.astro';
import { GAME } from '../data/petanqueGame';

const t = GAME.copy.fr;
---

<BaseLayout title={t.title} description={t.description} image={GAME.ogImages.fr} alternates={GAME.landingPaths}>
	<PetanqueLanding lang="fr" app={GAME} />
</BaseLayout>
