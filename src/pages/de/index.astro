---
// The homepage in another language: the games and apps on the night stage, and the studio. The mini-games and
// their daily challenge are in French, so they stay on the French homepage.
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeStage from '../../components/HomeStage.astro';
import HomeStudio from '../../components/HomeStudio.astro';
import { HOME } from '../../data/siteNav';
---

<BaseLayout
	scene
	lang="de"
	title="Ludiven Studio — Handyspiele, Pétanque-Apps und Unity-Entwicklung"
	description="Die Spiele und Apps von Ludiven Studio: Dragon Gems Swipe, Pétanque Game, Pétanque Meet und Pétanque Scan, bald auch Nino Rush. Unity-Entwickler seit 2010."
	alternates={HOME}
>
	<main class="home">
		<h1 class="sr-only">Ludiven Studio: Handyspiele, Pétanque-Apps und Unity-Entwicklung</h1>
		<div class="home-stage">
			<HomeStage lang="de" />
		</div>
		<HomeStudio lang="de" />
	</main>
</BaseLayout>

<style>
	.home {
		color: var(--sc-ink);
	}

	/* Phones: the stage runs to the screen's edges; wider screens give it the page's width. */
	@media (min-width: 56em) {
		.home-stage {
			max-width: 76rem;
			margin-inline: auto;
			padding-inline: 1.5rem;
		}
	}
</style>
