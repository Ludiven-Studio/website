---
// The homepage in another language: the games and apps on the night stage, and the studio. The mini-games and
// their daily challenge are in French, so they stay on the French homepage.
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeStage from '../../components/HomeStage.astro';
import HomeStudio from '../../components/HomeStudio.astro';
import { HOME } from '../../data/siteNav';
---

<BaseLayout
	scene
	lang="en"
	title="Ludiven Studio — Mobile games, pétanque apps and Unity development"
	description="The games and apps of Ludiven Studio: Dragon Gems Swipe, Pétanque Game, Pétanque Meet and Pétanque Scan, with Nino Rush coming soon. Unity developer since 2010."
	alternates={HOME}
>
	<main class="home">
		<h1 class="sr-only">Ludiven Studio: mobile games, pétanque apps and Unity development</h1>
		<div class="home-stage">
			<HomeStage lang="en" />
		</div>
		<HomeStudio lang="en" />
	</main>
</BaseLayout>

<style>
	.home {
		color: var(--sc-ink);
	}

	/* Phones: the stage runs to the screen's edges; wider screens give it the page's width. */
	@media (min-width: 56em) {
		.home-stage {
			max-width: 76rem;
			margin-inline: auto;
			padding-inline: 1.5rem;
		}
	}
</style>
