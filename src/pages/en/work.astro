---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

import ContactCTA from '../../components/ContactCTA.astro';
import PortfolioPreview from '../../components/PortfolioPreview.astro';
import Hero from '../../components/Hero.astro';
import Grid from '../../components/Grid.astro';

const projects = (await getCollection('work-en')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
	title="Projects & case studies | Ludiven Studio"
	description="The projects and collaborations behind Ludiven Studio — Unity apps, games and VR experiences."
	lang="en"
	altLang="/work/"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Projects & case studies"
				tagline="From my studio and freelance years through to Ludiven Studio — each project states the role I held and the company involved"
				align="start"
			/>
			<Grid variant="offset">
				{
					projects.map((project) => (
						<li>
							<PortfolioPreview project={project} base="/en/work" />
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA lang="en" />
	</div>
</BaseLayout>
