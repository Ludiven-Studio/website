		max-width: 68ch;
		margin-inline: auto;
		color: var(--sc-ink-2);
		font-size: var(--text-md);
		line-height: 1.6;
	}
	.legal h2 {
		font-size: var(--text-xl);
		color: var(--sc-ink);
	}
	.legal ul {
		padding-left: 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.legal a {
		color: var(--sc-link);
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
