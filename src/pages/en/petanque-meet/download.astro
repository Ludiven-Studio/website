---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LangSwitch from '../../../components/LangSwitch.astro';
import StoreBadges from '../../../components/StoreBadges.astro';
import { MEET_STORES } from '../../../data/petanqueMeet';
---

<BaseLayout
	title="Download Pétanque Meet for Android and iPhone | Ludiven Studio"
	description="The Pétanque Meet app on Google Play and the App Store: the pétanque games and tournaments near you, on your phone."
	lang="en"
	altLang="/petanque-meet/telecharger/"
>
	<div class="wrapper download-page stack gap-6">
		<LangSwitch lang="en" href="/petanque-meet/telecharger/" />
		<header class="stack gap-2">
			<h1>Pétanque Meet on your phone</h1>
			<p class="lead">The pétanque games and tournaments near you. Post your game, join other people's, follow the tournaments.</p>
		</header>

		<section class="card">
			<div class="app">
				<img class="icon" src="/assets/petanque-meet/icon.webp" alt="" width="72" height="72" />
				<p><strong>Pétanque Meet</strong><br />The app is free, on Android and iPhone.</p>
			</div>
			<StoreBadges playStore={MEET_STORES.en.play} appStore={MEET_STORES.en.apple} lang="en" />
		</section>

		<p class="muted">
			The map of games and tournaments is also open <a href="/en/petanque-meet/">in the browser</a>.
			<br /><a href="/petanque-meet/confidentialite/" hreflang="fr">What is stored</a> ·
			<a href="/petanque-meet/cgu/" hreflang="fr">Terms</a> (in French)
		</p>
	</div>
</BaseLayout>

<style>
	.download-page {
		max-width: 40rem;
		margin-inline: auto;
	}
	.download-page h1 {
		font-size: var(--text-3xl);
	}
	.lead,
	.muted {
		color: var(--gray-300);
	}
	.card {
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gray-999_40);
	}
	.app {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	/* Under the icon, aligned with it. */
	.card :global(.store-badges) {
		justify-content: flex-start;
		gap: 1rem;
		margin-top: 1.25rem;
	}
	.app p {
		margin: 0;
		line-height: 1.5;
	}
	.app strong {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		color: var(--gray-0);
	}
	.icon {
		flex: none;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 22%;
		box-shadow: 0 1px 4px rgba(9, 11, 17, 0.18);
	}
</style>
