---
// The homepage: the studio's games and apps on the night stage, then the daily challenge, the browser mini-games
// and the studio. The other languages have the stage and the studio (src/pages/<lang>/index.astro).
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeStage from '../components/HomeStage.astro';
import HomeStudio from '../components/HomeStudio.astro';
import { games, type GameTile } from '../data/games';
import { HOME } from '../data/siteNav';
import { fr } from '../data/homeGames';
import { POPULAR_DAYS, topPlayed } from '../lib/popular';

const playable = games.filter((g) => g.status === 'play' && g.href);
// The most played games lead (read once per build, as on /jeux/), the newest fill in; a visitor's favorites take
// their place (the script below).
const byId = new Map(playable.map((g) => [g.id, g]));
const top = (await topPlayed([...byId.keys()], 4, POPULAR_DAYS)).map((id) => byId.get(id)!);
const newest = [...playable].sort((a, b) => b.added.localeCompare(a.added));
const lead = [...new Set([...top, ...newest])].slice(0, 4);
const tile = (g: GameTile): string => `/assets/jeux/tile/${g.id}.jpg`;
const full = (g: GameTile): string => `/assets/jeux/${g.id}.jpg`;
---

<BaseLayout
	scene
	title="Ludiven Studio — Jeux mobiles, applis de pétanque et développement Unity"
	description="Les jeux et applis de Ludiven Studio (Dragon Gems Swipe, Pétanque Game, Meet et Scan), des mini-jeux gratuits avec un défi chaque jour, et le développement Unity depuis 2010."
	alternates={HOME}
>
	<main class="home">
		<h1 class="sr-only">{fr('Ludiven Studio : jeux mobiles, applis de pétanque, mini-jeux et développement Unity')}</h1>

		<div class="home-stage">
			<HomeStage lang="fr" />
		</div>

		<section class="home-wrap daily" aria-labelledby="daily-title">
			<span class="daily-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="30" height="30">
					<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
					<circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="2" />
					<circle cx="12" cy="12" r="1.6" fill="currentColor" />
				</svg>
			</span>
			<div class="daily-text">
				<h2 id="daily-title">Ton défi du jour</h2>
				<p class="daily-streak" data-daily-streak hidden></p>
				<p>Un nouveau défi chaque jour sur {playable.length} mini-jeux gratuits, sans pub ni compte.</p>
			</div>
			<a class="daily-cta" href="/jeux/defi/">Jouer le défi</a>
		</section>

		<section class="home-wrap mini" aria-labelledby="mini-title">
			<div class="mini-head">
				<h2 id="mini-title">Mini-jeux du navigateur</h2>
				<a class="mini-all" href="/jeux/">Les {playable.length} mini-jeux</a>
			</div>
			<ul class="mini-grid" data-mini>
				{
					playable.map((g) => (
						<li data-game-id={g.id} hidden={!lead.includes(g)} data-lead={lead.includes(g) ? lead.indexOf(g) : undefined}>
							<a class="mini-card" href={g.href}>
								<img
									src={tile(g)}
									srcset={`${tile(g)} 400w, ${full(g)} 1200w`}
									sizes="(min-width: 64em) 18rem, 50vw"
									alt=""
									width="400"
									height="250"
									loading="lazy"
									decoding="async"
									onerror="this.remove()"
								/>
								<span class="mini-body">
									<strong>{g.title}</strong>
									<span class="mini-pitch">{g.pitch}</span>
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<HomeStudio lang="fr" />
	</main>
</BaseLayout>

<script>
	import { globalStreak } from '../lib/streak';

	const NBSP = String.fromCharCode(160);
	const days = (n: number): string => `${n} jour${n > 1 ? 's' : ''}`;

	// A returning player reads the streak at stake, or the one kept today.
	const streakLine = document.querySelector<HTMLElement>('[data-daily-streak]');
	const st = globalStreak();
	if (streakLine && st.count > 0) {
		streakLine.textContent = st.atRisk
			? `Ta série de ${days(st.count)} est en jeu${NBSP}: joue un défi aujourd'hui${NBSP}!`
			: `Série en cours${NBSP}: ${days(st.count)}. Défi du jour fait, un autre${NBSP}?`;
		streakLine.hidden = false;
	}

	// The visitor's favorites lead the mini-games, then the build's pick fills the row up to four.
	const SHOW = 4;
	let favs: string[] = [];
	try {
		const raw: unknown = JSON.parse(localStorage.getItem('ludiven-favorites') || '[]');
		favs = Array.isArray(raw) ? raw.filter((x): x is string => typeof x === 'string') : [];
	} catch {
		favs = [];
	}
	const list = document.querySelector<HTMLElement>('[data-mini]');
	if (list && favs.length) {
		const items = Array.from(list.querySelectorAll<HTMLElement>('[data-game-id]'));
		const byId = new Map(items.map((li) => [li.dataset.gameId ?? '', li]));
		const lead = items
			.filter((li) => li.dataset.lead !== undefined)
			.sort((a, b) => Number(a.dataset.lead) - Number(b.dataset.lead));
		const picked = [...favs.map((id) => byId.get(id)).filter((li): li is HTMLElement => !!li), ...lead]
			.filter((li, i, all) => all.indexOf(li) === i)
			.slice(0, SHOW);
		items.forEach((li) => (li.hidden = true));
		picked.forEach((li) => {
			li.hidden = false;
			list.appendChild(li);
		});
	}
</script>

<style>
	.home {
		color: var(--sc-ink);
	}

	.home-wrap {
		max-width: 76rem;
		margin-inline: auto;
	}

	/* Phones: the stage runs to the screen's edges; wider screens give it the page's width. */
	@media (min-width: 56em) {
		.home-stage {
			max-width: 76rem;
			margin-inline: auto;
			padding-inline: 1.5rem;
		}
	}

	.daily {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.25rem;
		margin: 1.75rem 1rem 0;
		padding: 1.25rem;
		border: 1px solid var(--sc-line);
		border-radius: 1.4rem;
		background: var(--sc-surface);
		box-shadow: var(--sc-shadow);
	}
	.daily-icon {
		display: grid;
		place-items: center;
		flex: none;
		width: 3rem;
		height: 3rem;
		border-radius: 0.9rem;
		background: var(--sc-surface-2);
		color: var(--sc-flame);
	}
	.daily-text {
		flex: 1 1 14rem;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		color: var(--sc-muted);
	}
	.daily h2 {
		color: var(--sc-ink);
		font-family: var(--font-brand);
		font-weight: 600;
		font-size: 1.375rem;
	}
	.daily-streak {
		color: var(--sc-flame);
		font-weight: 700;
	}
	.daily-cta {
		flex: 1 1 100%;
		padding: 0.8rem 1.75rem;
		border-radius: 999rem;
		background: var(--sc-gold);
		color: var(--sc-gold-ink);
		font-family: var(--font-brand);
		font-weight: 600;
		font-size: 1.125rem;
		text-align: center;
		text-decoration: none;
		transition: filter 0.15s ease;
	}
	.daily-cta:hover {
		filter: brightness(1.06);
	}

	.mini {
		margin-top: 3rem;
		padding-inline: 1rem;
	}
	.mini-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1rem;
	}
	.mini h2 {
		color: var(--sc-ink);
		font-family: var(--font-brand);
		font-weight: 600;
		font-size: 1.75rem;
	}
	.mini-all {
		color: var(--sc-link);
		font-weight: 700;
		text-decoration: none;
	}
	.mini-all:hover {
		text-decoration: underline;
	}

	.mini-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}
	.mini-grid li[hidden] {
		display: none;
	}
	.mini-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--sc-line);
		border-radius: 1.1rem;
		background: var(--sc-surface);
		color: var(--sc-ink);
		text-decoration: none;
		transition: border-color 0.15s ease, transform 0.15s ease;
	}
	.mini-card:hover {
		border-color: var(--sc-accent);
		transform: translateY(-2px);
	}
	.mini-card img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		background: var(--sc-surface-2);
	}
	.mini-body {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0.75rem 0.85rem 0.9rem;
	}
	.mini-body strong {
		font-family: var(--font-brand);
		font-weight: 600;
		font-size: 1rem;
		line-height: 1.25;
	}
	.mini-pitch {
		display: none;
		color: var(--sc-muted);
		font-size: 0.9375rem;
		line-height: 1.45;
	}

	.home a:focus-visible {
		outline: 3px solid var(--sc-accent);
		outline-offset: 3px;
	}

	@media (min-width: 40em) {
		.daily {
			margin-inline: 1.5rem;
			padding: 1.5rem 1.75rem;
		}
		.daily-cta {
			flex: none;
		}
		.mini {
			padding-inline: 1.5rem;
		}
	}

	@media (min-width: 56em) {
		.daily {
			margin: 3.5rem auto 0;
			max-width: 73rem;
			padding: 1.75rem 2rem;
			gap: 1.5rem;
		}
		.daily-icon {
			width: 3.75rem;
			height: 3.75rem;
			border-radius: 1.1rem;
		}
		.daily h2 {
			font-size: 1.75rem;
		}
		.mini {
			margin-top: 4.5rem;
		}
		.mini h2 {
			font-size: 2.125rem;
		}
		.mini-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 1.25rem;
			margin-top: 1.5rem;
		}
		.mini-body {
			padding: 0.9rem 1rem 1.1rem;
		}
		.mini-body strong {
			font-size: 1.1875rem;
		}
		.mini-pitch {
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mini-card,
		.daily-cta {
			transition: none;
		}
		.mini-card:hover {
			transform: none;
		}
	}
</style>
