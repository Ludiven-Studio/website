---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import { MEET_STORES } from '../../data/petanqueMeet';
---

<BaseLayout
	title="Télécharger Pétanque Meet sur Android et iPhone | Ludiven Studio"
	description="L'appli Pétanque Meet sur le Play Store et l'App Store : les parties et les concours de pétanque autour de chez toi, sur ton téléphone."
	altLang="/en/petanque-meet/download/"
>
	<div class="wrapper download-page stack gap-6">
		<LangSwitch lang="fr" href="/en/petanque-meet/download/" />
		<header class="stack gap-2">
			<h1>Pétanque Meet sur ton téléphone</h1>
			<p class="lead">Les parties et les concours de pétanque autour de chez toi. Publie ta partie, rejoins celle des autres, suis les concours.</p>
		</header>

		<section class="card">
			<div class="app">
				<img class="icon" src="/assets/petanque-meet/icon.webp" alt="" width="72" height="72" />
				<p><strong>Pétanque Meet</strong><br />L'appli est gratuite, sur Android et iPhone.</p>
			</div>
			<StoreBadges playStore={MEET_STORES.fr.play} appStore={MEET_STORES.fr.apple} lang="fr" />
		</section>

		<p class="muted">
			La carte des parties et des concours se consulte aussi <a href="/petanque-meet/">dans le navigateur</a>.
			<br /><a href="/petanque-meet/confidentialite/">Ce qui est stocké</a> · <a href="/petanque-meet/cgu/">Conditions</a>
		</p>
	</div>
</BaseLayout>

<style>
	.download-page {
		max-width: 40rem;
		margin-inline: auto;
	}
	.download-page h1 {
		font-size: var(--text-3xl);
	}
	.lead,
	.muted {
		color: var(--gray-300);
	}
	.card {
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gray-999_40);
	}
	.app {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	/* Under the icon, aligned with it. */
	.card :global(.store-badges) {
		justify-content: flex-start;
		gap: 1rem;
		margin-top: 1.25rem;
	}
	.app p {
		margin: 0;
		line-height: 1.5;
	}
	.app strong {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		color: var(--gray-0);
	}
	.icon {
		flex: none;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 22%;
		box-shadow: 0 1px 4px rgba(9, 11, 17, 0.18);
	}
</style>
