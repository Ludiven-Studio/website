---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Unlisted: noindex, out of the sitemap and of the offline precache (astro.config.mjs).
// Main's next version under the .beta id, signed with the test key. The APK is a GitHub prerelease asset
// (petanque-meet-beta); 1.0.1-1.0.4 were in Supabase.
const BETA = {
	version: '1.1.0',
	label: 'beta8',
	date: '2026-11-21',
	size: 35732911,
	android: '7.1',
	sha256: 'b91f6f806c2a0faecf9a6d082f28e33a99226c0d415dd14a5cace030eb714530',
	url: 'https://github.com/Ludiven-Studio/website/releases/download/petanque-meet-beta/petanque-meet-1.1.0-beta8.apk',
};
const date = new Date(BETA.date).toLocaleDateString('fr-FR', { dateStyle: 'medium' });
const size = `${(BETA.size / 1e6).toFixed(1).replace('.', ',')} Mo`;
---

<BaseLayout
	title={`Pétanque Meet β — version ${BETA.version} | Ludiven Studio`}
	description={`Version bêta Android de Pétanque Meet ${BETA.version}, pour les testeurs.`}
	noindex
>
	<div class="wrapper beta-page stack gap-6">
		<header class="stack gap-2">
			<h1>Pétanque Meet&nbsp;β</h1>
			<p class="lead">
				La prochaine version, {BETA.version}, à tester avant sa sortie sur les stores. Elle s'appelle
				« Pétanque Meet β » et s'installe à côté de l'appli du Play Store, sans toucher à ses données.
			</p>
		</header>

		<section class="card stack gap-3">
			<a class="download" href={BETA.url}>Télécharger Pétanque Meet&nbsp;β&nbsp;{BETA.version}</a>
			<p class="muted">Build {BETA.label} · {date} · {size} · Android {BETA.android} ou plus récent</p>
			<p class="muted sha">SHA-256 : <code>{BETA.sha256}</code></p>
		</section>

		<section class="card stack gap-3">
			<h2>Nouveautés</h2>
			<p>Pétanque Meet β 1.1.0 : la version qui partira sur les stores, avec des corrections de fiabilité.</p>
			<ul>
				<li>
					Nouveau : chaque envoi au serveur (rejoindre, quitter, publier, modifier, annuler, signaler…) affiche une fenêtre
					d'attente avec « Annuler ». Si le réseau ne répond pas en 20 secondes, elle propose « Réessayer ». Une réponse qui
					arrive après un « Annuler » est quand même prise en compte, sans doublon.
				</li>
				<li>
					Concours : si la connexion coupe pendant la publication, l'appli vérifie et te dit que le concours semble en ligne, au
					lieu de te laisser le publier deux fois.
				</li>
				<li>« Modifier » juste après avoir publié un concours ouvre bien le formulaire.</li>
				<li>
					Se déconnecter ne fait plus disparaître les parties rejointes, et les rappels des concours suivis par l'ancien compte
					s'arrêtent.
				</li>
				<li>Un rappel touché pendant qu'une fenêtre est ouverte s'ouvre ensuite au lieu d'être perdu.</li>
				<li>Une recherche de partenaire fermée ne réapparaît plus sur la fiche du concours.</li>
				<li>Annuler une partie ne crée plus de doublon quand on la renvoie après une coupure.</li>
				<li>Des données enregistrées abîmées ne bloquent plus le lancement (session, lieux enregistrés).</li>
				<li>Affiches, bannière « Nos applis » et carte plus robustes.</li>
			</ul>
		</section>

		<section class="card stack gap-3">
			<h2>Pour tester sans attendre</h2>
			<p>
				Cette bêta n'a pas de réglage testeur : elle est construite comme la version des stores, donc les rappels se déclenchent
				pour de vrai.
			</p>
			<ul>
				<li>
					Avis du jeudi : enregistre un lieu près d'un concours prévu le samedi ou le dimanche qui suit, avant 19 h un jeudi, puis
					réponds « Oui, chaque jeudi ». L'avis arrive à 19 h. Il compte les concours à la distance du filtre « Autour de mes
					lieux » (30 km par défaut, jusqu'à 50 km dans Filtres). S'il n'y a aucun concours ce week-end dans ce rayon, il n'y a
					pas d'avis ce jeudi.
				</li>
				<li>
					Rappel de concours : suis un concours qui commence demain. Tu reçois un rappel ce soir à 19 h, puis un autre 2 h avant
					le jet du but. Un concours qui commence dans moins de 2 h n'en donne plus.
				</li>
				<li>
					Rappel de partie : pose une partie qui commence dans 1 h 30 ; le rappel arrive 1 h avant, et le toucher ouvre la
					partie. Annule-la ensuite : elle se voit sur la carte publique.
				</li>
				<li>
					Accepte les notifications quand l'appli les demande. Si tu les as refusées : réglages du téléphone &gt; Pétanque Meet β
					&gt; Notifications.
				</li>
				<li>
					Les deux réglages sont dans Compte &gt; Notifications : « Concours suivis » (Oui par défaut) et « Concours du week-end »
					(Non tant que tu n'as pas dit oui).
				</li>
			</ul>
		</section>

		<section class="card notice stack gap-3">
			<h2>À savoir avant d'installer</h2>
			<ul>
				<li>
					<strong>Ce sont les vraies parties.</strong> Une partie, une inscription ou un signalement fait dans la β est public, sur la
					carte et sur le site. Supprime ce que tu crées pour tester.
				</li>
				<li>
					<strong>Pas de vraies pubs.</strong> La β n'en affiche jamais : la fenêtre des pubs s'ouvre comme dans l'appli du store, mais
					quelle que soit ta réponse, c'est notre bannière pour nos autres applis qui s'affiche.
				</li>
				<li>
					<strong>Connexion Google.</strong> Elle marche, avec ton compte habituel. Si l'appli du Play Store est aussi sur ton
					téléphone, Android demande quelle appli ouvrir au retour de la connexion : choisis « Pétanque Meet β ». Si la connexion
					échoue, recommence.
				</li>
				<li>
					<strong>Pas de mise à jour par le Play Store.</strong> Une nouvelle bêta se télécharge sur cette page.
				</li>
			</ul>
		</section>

		<section class="stack gap-2">
			<h2>Installer sur Android</h2>
			<ol>
				<li>Ouvre cette page sur le téléphone et touche « Télécharger ».</li>
				<li>
					Ouvre le fichier téléchargé. Si Android bloque, autorise ton navigateur à installer des applis inconnues, puis réessaie.
					Play Protect peut aussi prévenir que l'appli lui est inconnue : choisis de l'installer quand même.
				</li>
				<li>L'icône « Pétanque Meet β » apparaît à côté de celle de Pétanque Meet.</li>
			</ol>
			<p class="muted">Pour l'enlever : appui long sur « Pétanque Meet β », puis Désinstaller. L'appli du store reste telle quelle.</p>
		</section>
	</div>
</BaseLayout>

<style>
	.beta-page {
		max-width: 40rem;
		margin-inline: auto;
	}
	.beta-page h1 {
		font-size: var(--text-3xl);
	}
	.beta-page h2 {
		font-size: var(--text-xl);
	}
	.lead,
	.muted {
		color: var(--gray-300);
	}
	.card {
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gray-999_40);
	}
	.notice {
		border-color: var(--accent-regular);
	}
	.download {
		display: inline-block;
		padding: 0.9rem 1.4rem;
		border-radius: 999px;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		font-weight: 600;
		text-decoration: none;
		text-align: center;
	}
	.download:hover,
	.download:focus-visible {
		background: var(--accent-dark);
	}
	.sha code {
		overflow-wrap: anywhere;
		font-size: var(--text-sm);
	}
	ol,
	ul {
		padding-inline-start: 1.25rem;
	}
	li + li {
		margin-top: 0.4rem;
	}
</style>
