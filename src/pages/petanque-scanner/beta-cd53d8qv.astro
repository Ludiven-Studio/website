---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Unlisted: noindex, out of the sitemap and of the offline precache (astro.config.mjs).
// The 1.2.13 store build under the .beta id. Over 50 MB, so the APK is a GitHub prerelease asset.
const BETA = {
	version: '1.2.13',
	date: '2026-11-06',
	size: 102982288,
	android: '7.1',
	sha256: '5adfb29622149a279aa244ec3642e6bfb6a60e3ebf51348cb2c525d5ecab78bc',
	url: 'https://github.com/Ludiven-Studio/website/releases/download/petanque-scanner-beta/petanque-scan-beta-1.2.13.apk',
};
const date = new Date(BETA.date).toLocaleDateString('fr-FR', { dateStyle: 'medium' });
const size = `${(BETA.size / 1e6).toFixed(1).replace('.', ',')} Mo`;
---

<BaseLayout
	title="Pétanque Scan β — version 1.2.13 | Ludiven Studio"
	description="Version bêta Android de Pétanque Scan 1.2.13, pour les testeurs."
	noindex
>
	<div class="wrapper beta-page stack gap-6">
		<header class="stack gap-2">
			<h1>Pétanque Scan&nbsp;β</h1>
			<p class="lead">
				La version {BETA.version} telle qu'elle part sur les stores, à tester une dernière fois avant sa sortie. Elle s'appelle
				« Pétanque Scan β » et s'installe à côté de l'appli du Play Store, sans toucher à ses données.
			</p>
		</header>

		<section class="card notice stack gap-3">
			<h2>À savoir avant d'installer</h2>
			<ul>
				<li>
					<strong>Pas de Premium.</strong> Google Play ne connaît pas la β : on ne peut ni acheter Premium ni le restaurer, et
					« Restaurer » répond que la boutique n'est pas prête. Un Premium acheté dans l'appli du store ne passe pas dans la β.
				</li>
				<li>
					<strong>Pas de vraies pubs.</strong> La β n'en affiche jamais : la fenêtre des pubs s'ouvre comme dans l'appli du store, mais
					quelle que soit ta réponse, ce sont notre bannière et notre vidéo pour Pétanque Meet qui s'affichent.
				</li>
				<li>
					<strong>Ses propres données.</strong> Elle démarre comme une première installation, avec ses 10 scans gratuits par jour.
				</li>
				<li>
					<strong>Pas de mise à jour par le Play Store.</strong> Une nouvelle bêta se télécharge sur cette page.
				</li>
			</ul>
			<p class="muted">
				Le reste marche comme dans l'appli du store : le scan 3D, le mode photo et les mesures. Sur un téléphone sans ARCore, l'appli
				passe en mode photo.
			</p>
		</section>

		<section class="card stack gap-3">
			<a class="download" href={BETA.url}>Télécharger Pétanque Scan β {BETA.version}</a>
			<p class="muted">{date} · {size} · Android {BETA.android} ou plus récent, 64 bits</p>
			<p class="muted sha">SHA-256 : <code>{BETA.sha256}</code></p>
		</section>

		<section class="stack gap-2">
			<h2>Installer sur Android</h2>
			<ol>
				<li>Ouvre cette page sur le téléphone et touche « Télécharger ».</li>
				<li>
					Ouvre le fichier téléchargé. Si Android bloque, autorise ton navigateur à installer des applis inconnues, puis réessaie.
					Play Protect peut aussi prévenir que l'appli lui est inconnue : choisis de l'installer quand même.
				</li>
				<li>L'icône « Pétanque Scan β » apparaît à côté de celle de Pétanque Scan.</li>
			</ol>
			<p class="muted">Pour l'enlever : appui long sur « Pétanque Scan β », puis Désinstaller. L'appli du store reste telle quelle.</p>
		</section>
	</div>
</BaseLayout>

<style>
	.beta-page {
		max-width: 40rem;
		margin-inline: auto;
	}
	.beta-page h1 {
		font-size: var(--text-3xl);
	}
	.beta-page h2 {
		font-size: var(--text-xl);
	}
	.lead,
	.muted {
		color: var(--gray-300);
	}
	.card {
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gray-999_40);
	}
	.notice {
		border-color: var(--accent-regular);
	}
	.download {
		display: inline-block;
		padding: 0.9rem 1.4rem;
		border-radius: 999px;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		font-weight: 600;
		text-decoration: none;
		text-align: center;
	}
	.download:hover,
	.download:focus-visible {
		background: var(--accent-dark);
	}
	.sha code {
		overflow-wrap: anywhere;
		font-size: var(--text-sm);
	}
	ol,
	ul {
		padding-inline-start: 1.25rem;
	}
	li + li {
		margin-top: 0.4rem;
	}
</style>
