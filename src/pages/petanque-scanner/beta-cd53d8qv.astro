---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Unlisted: noindex, out of the sitemap and of the offline precache (astro.config.mjs).
// The next store build, from main (dcf85e1), under the .beta id. Over 50 MB, so the APK is a GitHub prerelease asset
// (the earlier builds' APKs stay there).
const BETA = {
	version: '1.2.15',
	label: 'n°5',
	date: '2026-11-21',
	size: 110081419,
	android: '7.1',
	sha256: 'b5920cadd78dddaf264b2bb64cfd27fa30edd08d8e6e1d6876e18e2be2338c47',
	url: 'https://github.com/Ludiven-Studio/website/releases/download/petanque-scanner-beta/petanque-scan-beta-1.2.15-n5.apk',
};
const date = new Date(BETA.date).toLocaleDateString('fr-FR', { dateStyle: 'medium' });
const size = `${(BETA.size / 1e6).toFixed(1).replace('.', ',')} Mo`;
---

<BaseLayout
	title="Pétanque Scan β — version 1.2.15 | Ludiven Studio"
	description="Version bêta Android de Pétanque Scan 1.2.15, pour les testeurs."
	noindex
>
	<div class="wrapper beta-page stack gap-6">
		<header class="stack gap-2">
			<h1>Pétanque Scan&nbsp;β</h1>
			<p class="lead">
				La version {BETA.version}, la prochaine de l'appli du store, à tester avant sa sortie. Elle s'appelle
				« Pétanque Scan β » et s'installe à côté de l'appli du Play Store, sans toucher à ses données.
			</p>
		</header>

		<section class="card stack gap-3">
			<a class="download" href={BETA.url}>Télécharger Pétanque Scan β {BETA.version} {BETA.label}</a>
			<p class="muted">{date} · {size} · Android {BETA.android} ou plus récent, 64 bits</p>
			<p class="muted sha">SHA-256 : <code>{BETA.sha256}</code></p>
		</section>

		<section class="card stack gap-3">
			<h2>Bêta 1.2.15 n°5</h2>
			<p>
				Bêta n°5 de Pétanque Scan. Elle contient les corrections de la nuit&nbsp;: achats Premium, pubs récompensées, compteur
				de scans, pubs maison, et une nouvelle fenêtre d'attente pendant que le store répond.
			</p>
			<p class="muted">
				Rappel&nbsp;: dans la bêta, l'achat Premium ne peut pas aboutir, car Google Play ne connaît pas cette appli. Il n'y a
				pas non plus de vraie pub, seulement celles de Pétanque Meet.
			</p>
			<h3>À vérifier dans la fenêtre d'attente</h3>
			<ol>
				<li>
					Ouvrez Premium (quand les scans gratuits sont épuisés, ou depuis l'accueil) et touchez «&nbsp;Acheter&nbsp;».
					<ul>
						<li>
							Un voile sombre couvre tout l'écran, avec «&nbsp;Connexion…&nbsp;», un anneau doré qui tourne et un bouton
							«&nbsp;Annuler&nbsp;».
						</li>
						<li>Rien derrière ne doit réagir au doigt.</li>
					</ul>
				</li>
				<li>
					Touchez «&nbsp;Annuler&nbsp;»&nbsp;: la fenêtre se ferme et rien d'autre ne s'ouvre ensuite. Refaites l'essai avec la
					touche retour du téléphone&nbsp;: même résultat.
				</li>
				<li>
					Retouchez «&nbsp;Acheter&nbsp;» et attendez 20 secondes sans rien toucher.
					<ul>
						<li>Le texte passe à «&nbsp;pas de réponse&nbsp;», avec «&nbsp;Réessayer&nbsp;» et «&nbsp;Annuler&nbsp;».</li>
						<li>«&nbsp;Réessayer&nbsp;» relance l'anneau.</li>
					</ul>
				</li>
				<li>
					Faites «&nbsp;Restaurer mes achats&nbsp;» depuis Premium, puis depuis les Réglages&nbsp;: la même fenêtre s'ouvre,
					puis se ferme avec un message.
				</li>
				<li>
					Coupez le réseau (mode avion) et refaites 1 à 4. La fenêtre ne doit jamais rester bloquée&nbsp;: «&nbsp;Annuler&nbsp;»
					ou la touche retour la ferment toujours.
				</li>
				<li>
					Dites-nous si un texte dépasse ou est mal traduit (5 langues), et si la fenêtre apparaît alors qu'il n'y avait rien à
					attendre.
				</li>
			</ol>
		</section>

		<section class="card notice stack gap-3">
			<h2>À savoir avant d'installer</h2>
			<ul>
				<li>
					<strong>Pas de Premium.</strong> Google Play ne connaît pas la β : on ne peut ni acheter Premium ni le restaurer, et
					« Restaurer » répond que la boutique n'est pas prête. Un Premium acheté dans l'appli du store ne passe pas dans la β.
				</li>
				<li>
					<strong>Pas de vraies pubs.</strong> La β n'en affiche jamais : la fenêtre des pubs s'ouvre comme dans l'appli du store, mais
					quelle que soit ta réponse, ce sont nos bannières et nos vidéos pour les autres jeux du studio qui s'affichent.
				</li>
				<li>
					<strong>Ses propres données.</strong> Elle démarre comme une première installation, avec ses 10 scans gratuits par jour.
				</li>
				<li>
					<strong>Pas de mise à jour par le Play Store.</strong> Une nouvelle bêta se télécharge sur cette page.
				</li>
			</ul>
			<p class="muted">
				Le reste marche comme dans l'appli du store : le scan 3D, le mode photo et les mesures. Sur un téléphone sans ARCore, l'appli
				passe en mode photo.
			</p>
		</section>

		<section class="stack gap-2">
			<h2>Installer sur Android</h2>
			<ol>
				<li>Ouvre cette page sur le téléphone et touche « Télécharger ».</li>
				<li>
					Ouvre le fichier téléchargé. Si Android bloque, autorise ton navigateur à installer des applis inconnues, puis réessaie.
					Play Protect peut aussi prévenir que l'appli lui est inconnue : choisis de l'installer quand même.
				</li>
				<li>L'icône « Pétanque Scan β » apparaît à côté de celle de Pétanque Scan.</li>
			</ol>
			<p class="muted">Pour l'enlever : appui long sur « Pétanque Scan β », puis Désinstaller. L'appli du store reste telle quelle.</p>
		</section>
	</div>
</BaseLayout>

<style>
	.beta-page {
		max-width: 40rem;
		margin-inline: auto;
	}
	.beta-page h1 {
		font-size: var(--text-3xl);
	}
	.beta-page h2 {
		font-size: var(--text-xl);
	}
	.beta-page h3 {
		font-size: var(--text-lg);
	}
	.lead,
	.muted {
		color: var(--gray-300);
	}
	.card {
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gray-999_40);
	}
	.notice {
		border-color: var(--accent-regular);
	}
	.download {
		display: inline-block;
		padding: 0.9rem 1.4rem;
		border-radius: 999px;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		font-weight: 600;
		text-decoration: none;
		text-align: center;
	}
	.download:hover,
	.download:focus-visible {
		background: var(--accent-dark);
	}
	.sha code {
		overflow-wrap: anywhere;
		font-size: var(--text-sm);
	}
	ol,
	ul {
		padding-inline-start: 1.25rem;
	}
	li + li {
		margin-top: 0.4rem;
	}
</style>
