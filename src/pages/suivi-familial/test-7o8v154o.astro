---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SUPABASE_URL } from '../../data/site';

// Unlisted test page (noindex, out of the sitemap and of sw.js). Written by SuiviFamilial's
// tools/publish_test_build.py; no-cache, so a new build shows up on the next visit.
// The installer itself lives in a GitHub prerelease (over 50 MB).
const LATEST = `${SUPABASE_URL}/storage/v1/object/public/builds/suivifamilial/latest.json`;
---

<BaseLayout
	title="Cap Étoile — version de test | Ludiven Studio"
	description="Version de test Windows du logiciel Cap Étoile."
	noindex
>
	<div class="wrapper test-page stack gap-6">
		<header class="brand">
			<img src="/suivi-familial/cap-etoile.png" width="72" height="72" alt="" />
			<div class="stack gap-2">
				<h1>Cap Étoile — version de test</h1>
				<p class="lead">Suivi des enfants et des familles. Logiciel Windows en cours de développement. Cette page n'est pas publique : ne la partagez pas.</p>
			</div>
		</header>

		<section class="card stack gap-4" id="build" data-latest={LATEST}>
			<p class="muted" data-state="loading">Chargement de la dernière version…</p>
			<div class="stack gap-3" data-state="ready" hidden>
				<a class="download" data-field="url" href="#">Télécharger pour Windows (version <span data-field="version"></span>)</a>
				<p class="muted">Mise en ligne le <span data-field="date"></span> · <span data-field="size"></span></p>
			</div>
			<p class="muted" data-state="error" hidden>Aucune version de test n'est publiée pour l'instant.</p>
		</section>

		<section class="stack gap-2">
			<h2>Installer sur Windows 10 ou 11</h2>
			<ol>
				<li>Touchez « Télécharger », puis ouvrez le fichier <code>SuiviFamilial-Setup-…exe</code>.</li>
				<li>
					Windows peut afficher une fenêtre bleue « Windows a protégé votre ordinateur ». C'est normal : le logiciel est encore peu connu de Windows. Deux clics suffisent :
					<div class="ss-steps" aria-hidden="true">
						<figure class="ss">
							<div class="ss-box">
								<p class="ss-title">Windows a protégé votre ordinateur</p>
								<p class="ss-text">Le filtre a empêché le démarrage d'une application non reconnue…</p>
								<p class="ss-link ss-hot">Informations complémentaires</p>
								<p class="ss-btns"><span class="ss-btn">Ne pas exécuter</span></p>
							</div>
							<figcaption>1. Cliquez sur « Informations complémentaires ».</figcaption>
						</figure>
						<figure class="ss">
							<div class="ss-box">
								<p class="ss-title">Windows a protégé votre ordinateur</p>
								<p class="ss-text">Application : SuiviFamilial-Setup-….exe<br />Éditeur : Éditeur inconnu</p>
								<p class="ss-btns"><span class="ss-btn ss-hot">Exécuter quand même</span><span class="ss-btn">Ne pas exécuter</span></p>
							</div>
							<figcaption>2. Cliquez sur « Exécuter quand même ».</figcaption>
						</figure>
					</div>
					<p class="muted small">Dessin simplifié : la fenêtre réelle peut être un peu différente. Vous ne le ferez qu'une fois : les mises à jour s'installent ensuite sans cette fenêtre.</p>
				</li>
				<li>L'installation se fait pour votre compte Windows seulement, sans mot de passe administrateur, et crée un raccourci « Cap Étoile » sur le bureau.</li>
				<li>Au premier lancement, choisissez votre phrase secrète.</li>
				<li>Le logiciel ouvre ensuite Paramètres › Licence : saisissez la clé de licence qui vous a été envoyée, puis cliquez sur « Vérifier ma clé ». Sans clé valide, vous pouvez consulter, mais pas créer ni modifier.</li>
			</ol>
			<p class="muted">Pour une nouvelle version, refaites la même chose : elle s'installe par-dessus et garde vos dossiers. Désinstaller le logiciel (Paramètres Windows › Applications) ne supprime pas les dossiers.</p>
		</section>

		<section class="stack gap-2">
			<h2>Pendant les tests</h2>
			<ul>
				<li>Utilisez uniquement des familles et des dossiers inventés, jamais de vraies données.</li>
				<li>Une clé de licence de test est nécessaire : demandez-la à Ludiven Studio. Elle vaut 30 jours, sur 2 ordinateurs au plus. Pour la vérifier, seuls la clé, le numéro de version et un numéro tiré au hasard pour l'ordinateur sont envoyés ; aucun contenu de vos dossiers ne quitte l'ordinateur.</li>
				<li>Les mises à jour automatiques arriveront plus tard : revenez sur cette page pour une nouvelle version.</li>
			</ul>
		</section>

		<details class="tech" data-state="ready" hidden>
			<summary>Détails techniques</summary>
			<div class="stack gap-3">
				<p class="muted small">Commit <code data-field="commit"></code> · empreinte SHA-256 : <code data-field="sha256"></code></p>
				<div>
					<h3>Dernières modifications</h3>
					<ul class="small" data-field="notes"></ul>
				</div>
			</div>
		</details>
	</div>
</BaseLayout>

<script>
	const box = document.getElementById('build');
	const page = document.querySelector('.test-page');
	const show = (state: string) => {
		page?.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => {
			el.hidden = el.dataset.state !== state;
		});
	};
	const field = (name: string) => page?.querySelector<HTMLElement>(`[data-field="${name}"]`);

	async function load() {
		try {
			const res = await fetch(`${box?.dataset.latest}?t=${Date.now()}`, { cache: 'no-store' });
			if (!res.ok) throw new Error(String(res.status));
			const b = await res.json();
			const link = field('url') as HTMLAnchorElement | null;
			if (link) link.href = b.url;
			field('version')!.textContent = b.version;
			field('date')!.textContent = new Date(b.date).toLocaleString('fr-FR', { dateStyle: 'medium', timeStyle: 'short' });
			field('size')!.textContent = `${(b.size / 1e6).toFixed(1)} Mo`;
			field('commit')!.textContent = b.commit;
			field('sha256')!.textContent = b.sha256 ?? '';
			const notes = field('notes');
			if (notes) {
				notes.replaceChildren(...(b.notes as string[]).map((n) => {
					const li = document.createElement('li');
					li.textContent = n;
					return li;
				}));
			}
			show('ready');
		} catch {
			show('error');
		}
	}
	load();
</script>

<style>
	.test-page {
		max-width: 40rem;
		margin-inline: auto;
	}
	.ss-steps {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1rem;
		margin-block: 0.8rem;
	}
	.ss {
		margin: 0;
	}
	.ss-box {
		padding: 1rem;
		border-radius: 0.4rem;
		background: #1f5fa8;
		color: #fff;
		font-size: var(--text-sm);
		line-height: 1.4;
	}
	.ss-box p {
		margin: 0 0 0.6rem;
	}
	.ss-title {
		font-size: var(--text-base);
		font-weight: 600;
	}
	.ss-link {
		text-decoration: underline;
		display: inline-block;
	}
	.ss-btns {
		display: flex;
		justify-content: flex-end;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.ss-btn {
		padding: 0.3rem 0.8rem;
		border: 1px solid #fff;
	}
	.ss-hot {
		outline: 3px solid #ffcf3f;
		outline-offset: 3px;
		border-radius: 0.2rem;
	}
	.ss figcaption {
		margin-top: 0.5rem;
		font-weight: 600;
	}
	.brand {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
	}
	.brand img {
		flex: none;
		border-radius: 1rem;
	}
	.test-page [hidden] {
		display: none !important;
	}
	.test-page h1 {
		font-size: var(--text-3xl);
	}
	.test-page h2 {
		font-size: var(--text-xl);
	}
	.lead,
	.muted {
		color: var(--gray-300);
	}
	.small {
		font-size: var(--text-sm);
		overflow-wrap: anywhere;
	}
	.tech {
		padding-top: 1rem;
		margin-bottom: 2rem;
		border-top: 1px solid var(--gray-800);
	}
	.tech summary {
		cursor: pointer;
		color: var(--gray-300);
	}
	.tech h3 {
		margin-top: 1rem;
		font-size: var(--text-base);
	}
	.card {
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gray-999_40);
	}
	.download {
		display: inline-block;
		padding: 0.9rem 1.4rem;
		border-radius: 999px;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		font-weight: 600;
		text-decoration: none;
		text-align: center;
	}
	.download:hover,
	.download:focus-visible {
		background: var(--accent-dark);
	}
	ol,
	ul {
		padding-inline-start: 1.25rem;
	}
	li + li {
		margin-top: 0.4rem;
	}
</style>
