---
import MainHead from '../../components/MainHead.astro';
---

<html lang="fr">
	<head>
		<MainHead title="Rayou — prototype | Ludiven Studio" description="Prototype jouable." noindex />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
	</head>
	<body>
		<div id="stage"><canvas id="view"></canvas></div>
		<div id="fade"></div>

		<div class="hud">
			<button id="btn-menu" class="chip-btn" aria-label="Menu">☰</button>
			<button id="objective" class="chip" hidden><span id="obj-text"></span><span id="obj-more"></span></button>
			<button id="counters" class="chip" aria-label="Ouvrir le sac">
				<span class="bag-ico" aria-hidden="true">🎒</span>
				<span class="ico jar" aria-hidden="true"></span><b id="jar-count">0/4</b>
				<span class="ico gold" aria-hidden="true"></span><b id="gold-count">0/24</b>
			</button>
			<div id="arrow" hidden><span></span></div>
			<p id="hint" hidden></p>
			<div id="toasts"></div>

			<div id="tuto" hidden>
				<div class="tuto-head"><span id="tuto-step"></span><b id="tuto-title"></b><span class="tuto-ok">✓ Bravo !</span></div>
				<p id="tuto-text"></p>
				<div id="tuto-bar"><span></span></div>
				<button id="tuto-skip">Passer le tutoriel</button>
			</div>

			<div id="joy"><div id="joy-knob"></div></div>
			<button id="btn-jump" class="touch-btn" aria-label="Sauter">⤒<small>Sauter</small></button>
			<button id="btn-roll" class="touch-btn" aria-label="Rouler">⟳<small>Rouler</small></button>
			<button id="btn-action" class="touch-btn"><span id="action-label"></span></button>

			<div id="dialog" hidden>
				<span id="dlg-name"></span>
				<p id="dlg-text"></p>
				<span class="dlg-next">▶</span>
			</div>

			<section id="intro" class="card-screen">
				<div class="card">
					<p class="kicker">Prototype · chapitre 1</p>
					<h1>Rayou</h1>
					<p class="sub">et la Fête des Lumières</p>
					<p class="prologue">
						Par une nuit pleine d’étoiles, un bébé tigre est arrivé seul dans la vallée. Les animaux l’ont recueilli et l’ont appelé Rayou.
						Ce matin, c’est le jour de la Fête des Lumières…
					</p>
					<ul class="keys">
						<li class="desk"><b>ZQSD</b> ou flèches : bouger · <b>Espace</b> : sauter · <b>Maj</b> : rouler</li>
						<li class="desk"><b>E</b> : agir · <b>Échap</b> : menu · glisser la souris : caméra</li>
						<li class="mob">Pouce gauche : bouger · glisser à droite : caméra</li>
					</ul>
					<div class="row">
						<button id="continue" hidden>Continuer</button>
						<button id="play">Nouvelle partie</button>
					</div>
				</div>
			</section>

			<section id="menu" class="card-screen" hidden>
				<div class="card wide">
					<div class="tabs" role="tablist">
						<button class="tab" data-tab="bag">Sac</button>
						<button class="tab on" data-tab="quests">Objectifs</button>
						<button class="tab" data-tab="controls">Commandes</button>
						<button class="tab" data-tab="map">Carte</button>
						<button class="tab" data-tab="memories">Souvenirs</button>
						<button class="tab" data-tab="options">Options</button>
					</div>
					<div class="pane" data-pane="bag" hidden><ul id="bag"></ul></div>
					<div class="pane" data-pane="quests"><ul id="quest-list"></ul></div>
					<div class="pane" data-pane="controls" hidden>
						<ul class="controls desk">
							<li><span><kbd>Z</kbd><kbd>Q</kbd><kbd>S</kbd><kbd>D</kbd> / flèches</span>Courir</li>
							<li><span><kbd>Espace</kbd></span>Sauter (garder enfoncé : plus haut)</li>
							<li><span><kbd>Maj</kbd> ou <kbd>C</kbd></span>Rouler en boule : passer sous les obstacles bas, casser ce qui est fendu</li>
							<li><span><kbd>Maj</kbd> puis <kbd>Espace</kbd></span>Saut roulé : sauter bien plus loin</li>
							<li><span><kbd>E</kbd> ou <kbd>Entrée</kbd></span>Parler, ramasser, grimper</li>
							<li><span>Glisser la souris</span>Tourner la caméra</li>
							<li><span><kbd>Tab</kbd></span>Changer d’objectif suivi</li>
							<li><span><kbd>Échap</kbd></span>Menu</li>
						</ul>
						<ul class="controls mob">
							<li><span>Pouce à gauche</span>Courir</li>
							<li><span>Doigt à droite</span>Tourner la caméra</li>
							<li><span><b class="ico-btn">⤒</b></span>Sauter (garder appuyé : plus haut)</li>
							<li><span><b class="ico-btn">⟳</b></span>Rouler en boule : passer sous les obstacles bas, casser ce qui est fendu</li>
							<li><span><b class="ico-btn">⟳</b> puis <b class="ico-btn">⤒</b></span>Saut roulé : sauter bien plus loin</li>
							<li><span><b class="ico-btn yellow">Parler</b></span>Le bouton jaune : parler, ramasser, grimper</li>
							<li><span>Bandeau ★</span>Toucher pour changer d’objectif suivi</li>
						</ul>
						<p class="note">Pas de bobo : une grosse chute se termine en roulade, et un plongeon ramène Rayou au bord.</p>
					</div>
					<div class="pane" data-pane="map" hidden><canvas id="map" width="336" height="268"></canvas></div>
					<div class="pane" data-pane="memories" hidden><ul id="memories"></ul></div>
					<div class="pane" data-pane="options" hidden>
						<div class="opts">
							<button id="opt-tuto">Revoir le tutoriel</button>
							<button id="opt-unstuck">Débloquer Rayou</button>
							<button id="opt-full">Plein écran</button>
							<button id="opt-sfx">Sons : oui</button>
							<button id="opt-music">Musique : oui</button>
							<button id="opt-reset" class="danger">Recommencer du début</button>
						</div>
					</div>
					<button id="resume" class="primary">Reprendre</button>
				</div>
			</section>

			<section id="end" class="card-screen" hidden>
				<div class="card">
					<p class="kicker">Fin du chapitre 1</p>
					<h1>À suivre…</h1>
					<p>La lanterne brille sur le Pic, et quelqu’un, de l’autre côté des montagnes, y a répondu.</p>
					<ul class="stats">
						<li>Temps de jeu : <b id="end-time"></b></li>
						<li>Noisettes dorées : <b id="end-gold"></b></li>
						<li>Souvenirs : <b id="end-mem"></b></li>
					</ul>
					<div class="row">
						<button id="end-explore">Continuer à explorer</button>
					</div>
				</div>
			</section>

			<div id="rotate"><div><span class="phone">📱</span><p>Tourne ton téléphone<br />pour jouer en paysage</p></div></div>
		</div>

		<script>
			import { start } from '../../prototypes/rayou/main';
			start();
		</script>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		height: 100%;
		overflow: hidden;
		overscroll-behavior: none;
		background: #f2dcc0;
		-webkit-user-select: none;
		user-select: none;
		-webkit-touch-callout: none;
		-webkit-tap-highlight-color: transparent;
	}

	#stage {
		position: fixed;
		inset: 0;
		touch-action: none;
	}

	#view {
		display: block;
		width: 100%;
		height: 100%;
	}

	#fade {
		position: fixed;
		inset: 0;
		background: #fff8ec;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s;
	}

	.hud {
		position: fixed;
		inset: 0;
		pointer-events: none;
		font-family: var(--font-body, system-ui, sans-serif);
		color: #3a2a1c;
	}

	.hud > * {
		pointer-events: auto;
	}

	.chip,
	.chip-btn {
		position: absolute;
		border: none;
		background: rgba(255, 250, 240, 0.92);
		box-shadow: 0 4px 14px rgba(80, 50, 20, 0.18);
		color: inherit;
		font: inherit;
		font-weight: 700;
	}

	#btn-menu {
		top: max(12px, env(safe-area-inset-top));
		left: max(12px, env(safe-area-inset-left));
		width: 42px;
		height: 42px;
		border-radius: 50%;
		font-size: 1.2rem;
		cursor: pointer;
	}

	#objective {
		top: max(12px, env(safe-area-inset-top));
		left: 50%;
		transform: translateX(-50%);
		max-width: min(60%, 520px);
		padding: 0.55rem 1rem;
		border-radius: 999px;
		font-size: 0.92rem;
		text-align: center;
		cursor: pointer;
	}

	#objective::before {
		content: '★ ';
		color: #f0a020;
	}

	#obj-more {
		margin-left: 0.4rem;
		color: #a0835f;
		font-size: 0.8em;
	}

	#counters {
		top: max(12px, env(safe-area-inset-top));
		right: max(12px, env(safe-area-inset-right));
		display: flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.45rem 0.8rem;
		border-radius: 999px;
		font-size: 0.9rem;
		cursor: pointer;
	}

	.bag-ico {
		margin-right: 0.15rem;
		font-size: 1.05rem;
		line-height: 1;
	}

	#counters b + .ico {
		margin-left: 0.5rem;
	}

	.ico {
		display: inline-block;
		width: 16px;
		height: 18px;
	}

	.ico.jar {
		border-radius: 4px 4px 6px 6px;
		background: radial-gradient(circle at 50% 60%, #fff3a0 0 25%, #ffcf3a 45%, rgba(255, 207, 58, 0.25) 75%);
		box-shadow: inset 0 0 0 2px rgba(120, 90, 40, 0.45);
	}

	.ico.gold {
		border-radius: 50% 50% 45% 45%;
		background: radial-gradient(circle at 35% 35%, #fff3b0, #e6a91c 60%, #a8700e);
	}

	#arrow {
		position: absolute;
		width: 34px;
		height: 34px;
		margin: -17px 0 0 -17px;
		pointer-events: none;
	}

	#arrow span {
		display: block;
		width: 100%;
		height: 100%;
		background: #ffd23f;
		clip-path: polygon(50% 0, 100% 75%, 50% 55%, 0 75%);
		filter: drop-shadow(0 2px 3px rgba(80, 50, 20, 0.5));
	}

	#hint {
		position: absolute;
		bottom: 22%;
		left: 50%;
		transform: translateX(-50%);
		margin: 0;
		padding: 0.4rem 0.9rem;
		border-radius: 0.6rem;
		background: rgba(58, 42, 28, 0.85);
		color: #fff;
		font-weight: 700;
		pointer-events: none;
		white-space: nowrap;
	}

	#toasts {
		position: absolute;
		top: 64px;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		pointer-events: none;
	}

	.toast {
		padding: 0.45rem 1rem;
		border-radius: 999px;
		background: rgba(58, 42, 28, 0.88);
		color: #fff;
		font-weight: 700;
		font-size: 0.9rem;
		animation: toast 3s ease forwards;
		white-space: nowrap;
	}

	.toast.big {
		background: #ffd23f;
		color: #3a2a1c;
		font-size: 1.05rem;
	}

	@keyframes toast {
		0% {
			opacity: 0;
			transform: translateY(-8px) scale(0.9);
		}
		10%,
		80% {
			opacity: 1;
			transform: none;
		}
		100% {
			opacity: 0;
		}
	}

	#tuto {
		position: absolute;
		top: calc(max(12px, env(safe-area-inset-top)) + 54px);
		left: max(12px, env(safe-area-inset-left));
		width: min(320px, calc(100% - 24px));
		box-sizing: border-box;
		padding: 0.75rem 0.9rem 0.6rem;
		border-radius: 1rem;
		background: rgba(255, 250, 240, 0.95);
		box-shadow: 0 6px 20px rgba(80, 50, 20, 0.25);
		border: 2px solid #ffd23f;
		transition: border-color 0.2s, background 0.2s;
	}

	#tuto[hidden] {
		display: none;
	}

	#tuto.done {
		border-color: #4f9e45;
		background: rgba(236, 248, 228, 0.97);
	}

	.tuto-head {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	#tuto-step {
		padding: 0.05rem 0.45rem;
		border-radius: 999px;
		background: #ee8a2c;
		color: #fff;
		font-size: 0.72rem;
		font-weight: 800;
	}

	#tuto-title {
		font-size: 1rem;
	}

	.tuto-ok {
		display: none;
		margin-left: auto;
		color: #3f8a36;
		font-weight: 800;
		font-size: 0.85rem;
	}

	#tuto.done .tuto-ok {
		display: inline;
	}

	#tuto-text {
		margin: 0.4rem 0 0.5rem;
		font-size: 0.88rem;
		line-height: 1.5;
	}

	#tuto-bar {
		height: 6px;
		border-radius: 3px;
		background: #efe0c8;
		overflow: hidden;
	}

	#tuto-bar span {
		display: block;
		height: 100%;
		width: 0;
		background: #4f9e45;
		transition: width 0.2s;
	}

	#tuto-skip {
		margin-top: 0.4rem;
		padding: 0;
		border: none;
		background: none;
		color: #a0835f;
		font: inherit;
		font-size: 0.75rem;
		text-decoration: underline;
		cursor: pointer;
	}

	kbd {
		display: inline-block;
		min-width: 1.3em;
		margin: 0 0.1em;
		padding: 0.05em 0.35em;
		border-radius: 0.3em;
		border: 1px solid #c9b79c;
		box-shadow: 0 2px 0 #c9b79c;
		background: #fff;
		font: inherit;
		font-size: 0.85em;
		font-weight: 800;
		text-align: center;
	}

	.ico-btn {
		display: inline-grid;
		place-items: center;
		min-width: 1.7em;
		height: 1.7em;
		padding: 0 0.2em;
		border-radius: 999px;
		background: #fff;
		box-shadow: 0 1px 4px rgba(80, 50, 20, 0.3);
		font-size: 0.9em;
	}

	.ico-btn.yellow {
		background: #ffd23f;
		padding: 0 0.6em;
	}

	@media (pointer: coarse) and (max-height: 500px) {
		#tuto {
			width: min(280px, 40%);
			padding: 0.55rem 0.75rem 0.45rem;
		}
		#tuto-text {
			font-size: 0.8rem;
			margin: 0.3rem 0 0.4rem;
		}
	}

	#joy {
		position: absolute;
		width: 112px;
		height: 112px;
		margin: -56px 0 0 -56px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.22);
		border: 2px solid rgba(255, 255, 255, 0.6);
		opacity: 0;
		transition: opacity 0.15s;
		pointer-events: none;
	}

	#joy-knob {
		position: absolute;
		left: 28px;
		top: 28px;
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.85);
	}

	.touch-btn {
		position: absolute;
		display: none;
		border: none;
		border-radius: 50%;
		font: inherit;
		font-weight: 800;
		color: #3a2a1c;
		background: rgba(255, 250, 240, 0.88);
		box-shadow: 0 4px 14px rgba(80, 50, 20, 0.25);
		touch-action: none;
	}

	.touch-btn small {
		position: absolute;
		left: 50%;
		bottom: -1.3em;
		transform: translateX(-50%);
		font-size: 0.62rem;
		color: #fff;
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
		white-space: nowrap;
	}

	.touch-btn.pulse {
		animation: pulse 1.1s ease-in-out infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(255, 210, 63, 0.95), 0 4px 14px rgba(80, 50, 20, 0.25);
		}
		50% {
			box-shadow: 0 0 0 14px rgba(255, 210, 63, 0), 0 4px 14px rgba(80, 50, 20, 0.25);
		}
	}

	.touch-btn.down {
		transform: scale(0.92);
		background: #fff;
	}

	/* Jump and roll are twins: same size, same row. */
	#btn-jump,
	#btn-roll {
		bottom: calc(26px + env(safe-area-inset-bottom));
		width: 72px;
		height: 72px;
		font-size: 1.7rem;
		line-height: 1;
	}

	#btn-jump {
		right: calc(22px + env(safe-area-inset-right));
	}

	#btn-roll {
		right: calc(110px + env(safe-area-inset-right));
	}

	#btn-action {
		right: calc(40px + env(safe-area-inset-right));
		bottom: calc(112px + env(safe-area-inset-bottom));
		width: 76px;
		height: 76px;
		font-size: 0.8rem;
		opacity: 0.3;
		transform: scale(0.85);
		transition: transform 0.15s, opacity 0.15s, background 0.15s;
	}

	#btn-action.on {
		opacity: 1;
		transform: scale(1);
		background: #ffd23f;
	}

	@media (pointer: coarse) {
		.touch-btn {
			display: block;
		}
		#objective {
			font-size: 0.8rem;
			padding: 0.45rem 0.8rem;
		}
		#hint,
		.desk {
			display: none !important;
		}
	}

	@media (pointer: fine) {
		.mob {
			display: none;
		}
	}

	/* The game decides touch or mouse once; these win over the media queries. */
	body.is-mouse .mob,
	body.is-touch .desk {
		display: none !important;
	}

	body.is-mouse .desk,
	body.is-touch .mob {
		display: revert !important;
	}

	body.is-mouse ul.controls.desk,
	body.is-touch ul.controls.mob {
		display: flex !important;
	}

	#dialog {
		position: absolute;
		left: 50%;
		bottom: calc(24px + env(safe-area-inset-bottom));
		transform: translateX(-50%);
		width: min(600px, calc(100% - 32px));
		box-sizing: border-box;
		padding: 1.3rem 1.2rem 0.9rem;
		border-radius: 1.1rem;
		background: #fffaf0;
		box-shadow: 0 8px 30px rgba(80, 50, 20, 0.3);
		cursor: pointer;
	}

	@media (pointer: coarse) {
		#dialog {
			width: min(560px, calc(100% - 260px));
			left: calc(50% - 40px);
			bottom: calc(12px + env(safe-area-inset-bottom));
			padding: 1.1rem 1rem 0.7rem;
		}
	}

	#dlg-name {
		position: absolute;
		top: -0.8rem;
		left: 1rem;
		padding: 0.2rem 0.8rem;
		border-radius: 999px;
		background: #c0682f;
		color: #fff;
		font-weight: 800;
		font-size: 0.9rem;
	}

	#dlg-text {
		margin: 0;
		min-height: 2.8em;
		font-size: 1.05rem;
		line-height: 1.4;
	}

	@media (pointer: coarse) and (max-height: 500px) {
		#dlg-text {
			font-size: 0.92rem;
			min-height: 2.6em;
		}
	}

	.dlg-next {
		position: absolute;
		right: 1rem;
		bottom: 0.5rem;
		font-size: 0.8rem;
		color: #c0682f;
		animation: nudge 1s ease-in-out infinite;
	}

	@keyframes nudge {
		50% {
			transform: translateX(3px);
		}
	}

	/* Flex + auto margins: centred, yet scrollable from the top when taller than the screen. */
	.card-screen {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		padding: 16px;
		box-sizing: border-box;
		background: linear-gradient(180deg, rgba(255, 236, 205, 0.15), rgba(80, 45, 15, 0.45));
		overflow-y: auto;
	}

	.card-screen[hidden],
	#dialog[hidden],
	#objective[hidden],
	#hint[hidden],
	#arrow[hidden],
	.pane[hidden],
	button[hidden] {
		display: none;
	}

	.card {
		margin: auto;
		width: min(440px, 100%);
		box-sizing: border-box;
		padding: 1.6rem 1.5rem;
		border-radius: 1.4rem;
		background: #fffaf0;
		box-shadow: 0 12px 40px rgba(80, 50, 20, 0.35);
		text-align: center;
	}

	.card.wide {
		width: min(560px, 100%);
	}

	.card h1 {
		margin: 0;
		font-size: 2.6rem;
		color: #e2761c;
	}

	.card .sub {
		margin: 0 0 0.8rem;
		font-weight: 800;
		color: #a0835f;
	}

	.card p {
		margin: 0 0 1rem;
		line-height: 1.45;
	}

	.prologue {
		font-size: 0.95rem;
		font-style: italic;
	}

	.kicker {
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.75rem;
		font-weight: 800;
