---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Unlisted: noindex, out of the sitemap and of the offline precache (BaseLayout, astro.config.mjs's /beta- rules).
// The next version, built from DragonsGemsSwipe's main (3484537) as com.ludivenstudio.dragonsgems.beta
// (Profile_Android_Beta, APP_BETA), signed with the dev key, ARM64 only, on a prerelease of this repo.
const APK = {
	url: 'https://github.com/Ludiven-Studio/website/releases/download/dragons-gems-beta/dragons-gems-1.1.8-beta2.apk',
	version: '1.1.8',
	code: 101008,
	size: 76655387,
	sha256: '55841d462d6ab729ba8350be482085c5a3a39f0933b8d0cc11053c0b1b05d7dc',
	commit: '3484537',
	label: 'beta2',
};
---

<BaseLayout
	title="Dragon Gems Swipe — bêta 1.1.8 | Ludiven Studio"
	description="La version 1.1.8 de Dragon Gems Swipe, à essayer avant son envoi aux stores."
	noindex
>
	<div class="wrapper beta-page stack gap-6">
		<header class="stack gap-2">
			<h1>Dragon Gems Swipe — bêta 1.1.8</h1>
			<p class="lead">La prochaine version, à essayer avant son envoi aux stores. Elle s'installe à côté de l'appli du Play Store, sous le nom « Dragon Gems β », avec sa propre partie.</p>
		</header>

		<section class="card stack gap-3">
			<a class="download" href={APK.url}>Télécharger la bêta {APK.version}</a>
			<p class="muted">{(APK.size / 1e6).toFixed(1).replace('.', ',')} Mo · version {APK.version} {APK.label} (code {APK.code}) · commit <code>{APK.commit}</code></p>
			<p class="muted sha">SHA-256 : <code>{APK.sha256}</code></p>
		</section>

		<section class="card stack gap-3">
			<h2>Quoi de neuf à tester</h2>
			<p><strong>Nouveau dans la 1.1.8 beta2 :</strong></p>
			<ul>
				<li>Tous les petits textes sont plus grands (15 pt au minimum) et plus lisibles, en 5 langues ; les boutons grisés sont plus foncés.</li>
				<li>Boutique : les lignes de fragments du bonus tiennent dans toutes les langues ; le titre peut passer sur 2 lignes et le prix reste dans son bouton.</li>
				<li>L'écran ne se met plus en veille pendant un niveau (les menus gardent le réglage du téléphone).</li>
				<li>Réglages : nouveau lien « Conditions d'utilisation » sous « Confidentialité ».</li>
				<li>Vidéos de nos jeux : un lien « Signaler cette vidéo » ouvre un e-mail au studio.</li>
				<li>L'heure du téléphone ne compte plus pour le cadeau du jour, l'objectif du jour, les vidéos du jour, le défi du jour, les cœurs et l'invite de mise à jour : reculer ou avancer l'horloge ne donne rien en double et ne bloque rien.</li>
				<li>Connexion : « Annuler » abandonne vraiment la connexion, même si Google ou Apple répond oui juste après ; un double tap ne demande plus deux fois.</li>
				<li>Les cartes qui arrivent en retard (restauration, suppression du compte, cadeau du jour) attendent l'accueil au lieu de s'ouvrir sur le plateau ; la proposition de compte attend la fin d'une restauration.</li>
				<li>« Jouer » ou « Défi du jour » tapés deux fois n'ouvrent qu'une partie.</li>
				<li>Partie en ligne : une copie de secours ou un changement de compte ne fait plus revenir des pièces dépensées ni compter un coffre deux fois.</li>
				<li>Nombreuses petites corrections.</li>
			</ul>
			<p><strong>À tester en priorité :</strong></p>
			<ul>
				<li>la boutique (bonus, fragments) en espagnol et en allemand ;</li>
				<li>laisser le téléphone sans le toucher pendant un niveau (l'écran reste allumé ; sur l'accueil il s'éteint comme d'habitude) ;</li>
				<li>changer l'heure du téléphone en arrière puis en avant (le cadeau du jour et les cœurs ne bougent pas).</li>
			</ul>
			<p><strong>Inchangé :</strong> pas d'achats, aucune pub réseau, pas d'invite de mise à jour, ARM64 seulement.</p>
			<p><strong>Dans la 1.1.8 beta1 :</strong></p>
			<ul>
				<li>Connexion au compte, suppression du compte et restauration des achats : une fenêtre d'attente avec « Annuler » s'affiche pendant l'échange avec le serveur.</li>
				<li>Votre progression est mieux protégée : une sauvegarde abîmée est reprise de la copie de secours au lieu de repartir de zéro, et la synchronisation entre téléphones ne compte plus deux fois les mêmes pièces.</li>
				<li>Un achat fait pendant le changement de compte reste bien au compte connecté.</li>
				<li>Une partie payée n'est plus perdue quand on joue un autre niveau ou le défi du jour, ni quand on utilise un bonus juste avant que l'appli soit fermée.</li>
				<li>Un double tap sur un bouton de fenêtre, sur la vidéo du cœur ou sur la relance ne lance plus deux fois l'action ni deux vidéos.</li>
				<li>Les scores ne partent plus en double au classement ; une connexion qui réussit ne s'affiche plus en échec.</li>
			</ul>
			<p><strong>À vérifier sur votre téléphone :</strong> regardez une vidéo maison jusqu'au bout pour un cœur ou une relance. La récompense doit tomber une seule fois, et un double tap ne doit lancer qu'une seule vidéo. Si vous avez deux téléphones sur le même compte, jouez sur les deux et vérifiez que vos pièces restent justes.</p>
			<p><strong>Dans la 1.1.7 :</strong></p>
			<ul>
				<li>Une partie où vous avez payé une relance ou un souffle reprend là où elle en était si l'appli se ferme.</li>
				<li>Une victoire est enregistrée dès le coup gagnant.</li>
				<li>La récompense d'une vidéo arrivée en retard est bien créditée.</li>
				<li>Le cadeau du jour s'affiche aussi quand minuit passe sur l'accueil.</li>
				<li>Le défi du jour commencé juste avant minuit compte pour son jour, et votre score est gardé si le réseau coupe.</li>
				<li>Bouton Retour plus sûr pendant les transitions ; la proposition de mise à jour n'apparaît plus en pleine partie.</li>
				<li>Nombreuses petites corrections.</li>
			</ul>
			<p><strong>Depuis les bêtas précédentes :</strong></p>
			<ul>
				<li><strong>La partie en ligne</strong> : jouée sur deux téléphones (ou la bêta et l'appli du store) avec le même compte, les pièces gagnées et dépensées de chaque côté s'additionnent. Aucun pack payé n'est perdu, rien de dépensé ne revient.</li>
				<li><strong>Glisser et tenir</strong> : les blocs se penchent d'un quart de case, dans une seule direction à la fois. Un rond apparaît là où ton doigt a touché : ramène le doigt dedans pour annuler le coup, rien ne bouge.</li>
				<li><strong>Le souffle de Perle</strong> : avant la fusion, Perle souffle un nuage de glace qui cristallise tout le plateau, puis la glace craque.</li>
				<li><strong>Tout débloquer (test)</strong>, dans Réglages › Jeu : ouvre tous les niveaux de la carte, des profondeurs et de la nuit, pour tout essayer tout de suite. Tu joues alors une copie de ta partie ; ta vraie partie revient telle quelle quand tu l'éteins.</li>
				<li><strong>Les clés</strong> (dès le 2e pays) : un coffre cadenassé ne s'ouvre qu'avec une clé. Fais exploser des gemmes à côté d'une clé pour la ramasser : elle file dans ta réserve, puis va tourner dans le cadenas. Bijou montre comment la première fois.</li>
				<li><strong>Les coffres de couleur</strong> (à partir du niveau 61) : ils ne s'ouvrent qu'avec une explosion de leur couleur juste à côté. Les boules de feu, les comètes et les bonus ouvrent tous les coffres.</li>
				<li><strong>La 3e étoile</strong> se gagne plus rarement : elle récompense une vraie bonne partie.</li>
				<li><strong>Garder le doigt appuyé</strong> à la fin d'un glissement montre en doré les coffres que le coup ouvre, et les gemmes qui vont entrer, juste au bord de la grille, du côté où elles arrivent.</li>
				<li><strong>L'Ouvre-tout</strong> : le bonus clé change de nom. Il ouvre n'importe quel coffre, même cadenassé, gelé ou de couleur.</li>
				<li><strong>Les thèmes</strong> (Améthyste, Saphir, Émeraude, Rubis, Turquoise) et le mode sombre colorent maintenant toute l'appli : à choisir dans les options.</li>
				<li><strong>Les pièces</strong> : moins de pièces gagnées, et continuer une partie coûte plus cher à chaque fois (500, 1000, puis 2000).</li>
				<li>Les classements montrent chaque pseudo une seule fois, à son meilleur score.</li>
			</ul>
			<p class="muted">Les clés et les coffres de couleur arrivent plus loin dans la carte : connecte-toi au compte Google de l'appli du store pour reprendre ta partie, ou active « Tout débloquer (test) ».</p>
		</section>

		<section class="card warn stack gap-3">
			<h2>Ce qui ne marche pas dans la bêta</h2>
			<ul>
				<li><strong>Les achats</strong> : Google Play ne connaît pas cette appli. Les boutons de la boutique restent grisés.</li>
				<li><strong>Les pubs</strong> : la bêta n'en montre aucune, même après « Accepter ». Chaque vidéo proposée est une vidéo de nos jeux et applis.</li>
				<li><strong>L'invite de mise à jour</strong> ne s'affiche pas.</li>
				<li><strong>Les anciens téléphones 32 bits</strong> : la bêta est faite pour les téléphones 64 bits (ARM64) seulement.</li>
			</ul>
			<h2>Ce qui compte pour de vrai</h2>
			<ul>
				<li>Tes scores du défi du jour et du mode infini entrent dans le classement, celui du site.</li>
				<li>Connectée au même compte Google que l'appli du store, la bêta partage sa partie en ligne : ce que tu y fais compte aussi dans l'autre, sauf pendant « Tout débloquer (test) ».</li>
			</ul>
		</section>

		<section class="stack gap-2">
			<h2>Installer sur Android</h2>
			<ol>
				<li>Ouvre cette page sur le téléphone et touche « Télécharger ».</li>
				<li>Ouvre le fichier téléchargé. Si Android bloque, autorise ton navigateur à installer des applis inconnues, puis réessaie.</li>
				<li>« Dragon Gems β » apparaît à côté de l'autre appli. Sa partie est à part : elle commence au niveau 1, sauf si tu te connectes à ton compte Google.</li>
				<li>Après le test, pour l'enlever : appui long sur son icône, puis « Désinstaller ».</li>
			</ol>
		</section>
	</div>
</BaseLayout>

<style>
	.beta-page {
		max-width: 40rem;
		margin-inline: auto;
	}
	.beta-page h1 {
		font-size: var(--text-3xl);
	}
	.beta-page h2 {
		font-size: var(--text-xl);
	}
	.lead,
	.muted {
		color: var(--gray-300);
	}
	.card {
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gray-999_40);
	}
	.warn {
		border-color: var(--accent-regular);
	}
	.download {
		display: inline-block;
		padding: 0.9rem 1.4rem;
		border-radius: 999px;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		font-weight: 600;
		text-decoration: none;
		text-align: center;
	}
	.download:hover,
	.download:focus-visible {
		background: var(--accent-dark);
	}
	.sha code {
		overflow-wrap: anywhere;
	}
	ol,
	ul {
		padding-inline-start: 1.25rem;
	}
	li + li {
		margin-top: 0.4rem;
	}
</style>
