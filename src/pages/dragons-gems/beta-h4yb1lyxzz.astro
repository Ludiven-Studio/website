---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Unlisted: noindex, out of the sitemap and of the offline precache (BaseLayout, astro.config.mjs's /beta- rules).
// The next version, built from DragonsGemsSwipe's main (3c989b9) as com.ludivenstudio.dragonsgems.beta
// (Profile_Android_Beta, APP_BETA), signed with the dev key, ARM64 only, on a prerelease of this repo.
const APK = {
	url: 'https://github.com/Ludiven-Studio/website/releases/download/dragons-gems-beta/dragonsgems-beta-v1.1.5.apk',
	version: '1.1.5',
	code: 101005,
	size: 76560879,
	sha256: '8e24cf261b95ed4a2e4486f4e358b5056e4c2f30230ef2be5d69b63b7cdd5687',
	commit: '3c989b9',
};
---

<BaseLayout
	title="Dragon Gems Swipe — bêta 1.1.5 | Ludiven Studio"
	description="La version 1.1.5 de Dragon Gems Swipe, à essayer avant son envoi aux stores."
	noindex
>
	<div class="wrapper beta-page stack gap-6">
		<header class="stack gap-2">
			<h1>Dragon Gems Swipe — bêta 1.1.5</h1>
			<p class="lead">La prochaine version, à essayer avant son envoi aux stores. Elle s'installe à côté de l'appli du Play Store, sous le nom « Dragon Gems β », avec sa propre partie.</p>
		</header>

		<section class="card stack gap-3">
			<h2>Quoi de neuf à tester</h2>
			<ul>
				<li><strong>Glisser et tenir</strong> : les blocs se penchent d'un quart de case, dans une seule direction à la fois. Un rond apparaît là où ton doigt a touché : ramène le doigt dedans pour annuler le coup, rien ne bouge.</li>
				<li><strong>Le souffle de Perle</strong> : avant la fusion, Perle souffle un nuage de glace qui cristallise tout le plateau, puis la glace craque.</li>
				<li><strong>Tout débloquer (test)</strong>, dans Réglages › Jeu : ouvre tous les niveaux de la carte, des profondeurs et de la nuit, pour tout essayer tout de suite. Tu joues alors une copie de ta partie ; ta vraie partie revient telle quelle quand tu l'éteins.</li>
				<li><strong>Les clés</strong> (dès le 2e pays) : un coffre cadenassé ne s'ouvre qu'avec une clé. Fais exploser des gemmes à côté d'une clé pour la ramasser : elle file dans ta réserve, puis va tourner dans le cadenas. Bijou montre comment la première fois.</li>
				<li><strong>Les coffres de couleur</strong> (à partir du niveau 61) : ils ne s'ouvrent qu'avec une explosion de leur couleur juste à côté. Les boules de feu, les comètes et les bonus ouvrent tous les coffres.</li>
				<li><strong>La 3e étoile</strong> se gagne plus rarement : elle récompense une vraie bonne partie.</li>
				<li><strong>Garder le doigt appuyé</strong> à la fin d'un glissement montre en doré les coffres que le coup ouvre, et les gemmes qui vont entrer, juste au bord de la grille, du côté où elles arrivent.</li>
				<li><strong>L'Ouvre-tout</strong> : le bonus clé change de nom. Il ouvre n'importe quel coffre, même cadenassé, gelé ou de couleur.</li>
				<li><strong>Les thèmes</strong> (Améthyste, Saphir, Émeraude, Rubis, Turquoise) et le mode sombre colorent maintenant toute l'appli : à choisir dans les options.</li>
				<li><strong>Les pièces</strong> : moins de pièces gagnées, et continuer une partie coûte plus cher à chaque fois (500, 1000, puis 2000).</li>
				<li>Les classements montrent chaque pseudo une seule fois, à son meilleur score.</li>
			</ul>
			<p class="muted">Les clés et les coffres de couleur arrivent plus loin dans la carte : connecte-toi au compte Google de l'appli du store pour reprendre ta partie, ou active « Tout débloquer (test) ».</p>
		</section>

		<section class="card warn stack gap-3">
			<h2>Ce qui ne marche pas dans la bêta</h2>
			<ul>
				<li><strong>Les achats</strong> : Google Play ne connaît pas cette appli. Les boutons de la boutique restent grisés.</li>
				<li><strong>Les pubs</strong> : la bêta n'en montre aucune, même après « Accepter ». Chaque vidéo proposée est une vidéo de nos jeux et applis.</li>
				<li><strong>L'invite de mise à jour</strong> ne s'affiche pas.</li>
				<li><strong>Les anciens téléphones 32 bits</strong> : la bêta est faite pour les téléphones 64 bits (ARM64) seulement.</li>
			</ul>
			<h2>Ce qui compte pour de vrai</h2>
			<ul>
				<li>Tes scores du défi du jour et du mode infini entrent dans le classement, celui du site.</li>
				<li>Connectée au même compte Google que l'appli du store, la bêta partage sa partie en ligne : ce que tu y fais compte aussi dans l'autre, sauf pendant « Tout débloquer (test) ».</li>
			</ul>
		</section>

		<section class="card stack gap-3">
			<a class="download" href={APK.url}>Télécharger la bêta {APK.version}</a>
			<p class="muted">{(APK.size / 1e6).toFixed(1).replace('.', ',')} Mo · version {APK.version} (code {APK.code}) · commit <code>{APK.commit}</code></p>
			<p class="muted sha">SHA-256 : <code>{APK.sha256}</code></p>
		</section>

		<section class="stack gap-2">
			<h2>Installer sur Android</h2>
			<ol>
				<li>Ouvre cette page sur le téléphone et touche « Télécharger ».</li>
				<li>Ouvre le fichier téléchargé. Si Android bloque, autorise ton navigateur à installer des applis inconnues, puis réessaie.</li>
				<li>« Dragon Gems β » apparaît à côté de l'autre appli. Sa partie est à part : elle commence au niveau 1, sauf si tu te connectes à ton compte Google.</li>
				<li>Après le test, pour l'enlever : appui long sur son icône, puis « Désinstaller ».</li>
			</ol>
		</section>
	</div>
</BaseLayout>

<style>
	.beta-page {
		max-width: 40rem;
		margin-inline: auto;
	}
	.beta-page h1 {
		font-size: var(--text-3xl);
	}
	.beta-page h2 {
		font-size: var(--text-xl);
	}
	.lead,
	.muted {
		color: var(--gray-300);
	}
	.card {
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gray-999_40);
	}
	.warn {
		border-color: var(--accent-regular);
	}
	.download {
		display: inline-block;
		padding: 0.9rem 1.4rem;
		border-radius: 999px;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		font-weight: 600;
		text-decoration: none;
		text-align: center;
	}
	.download:hover,
	.download:focus-visible {
		background: var(--accent-dark);
	}
	.sha code {
		overflow-wrap: anywhere;
	}
	ol,
	ul {
		padding-inline-start: 1.25rem;
	}
	li + li {
		margin-top: 0.4rem;
	}
</style>
