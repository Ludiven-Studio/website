---
import BaseLayout from '../../layouts/BaseLayout.astro';

// The store build's last test before submission, as com.ludivenstudio.dragonsgems.beta (DragonsGemsSwipe's
// Profile_Android_Beta, APP_BETA). Unlisted: linked from nowhere; BaseLayout and astro.config keep /beta- paths
// out of search engines, the sitemap and the precache.
const APK = {
	url: 'https://github.com/Ludiven-Studio/website/releases/download/dragons-gems-beta/dragonsgems-beta-v1.0.1.apk',
	version: '1.0.1',
	code: 100001,
	size: 119544876,
	sha256: '8b05c9564463803ad14f3bcfe09a3ee2e1019c16c714ecaf2ff2b55112e0a924',
	commit: '08c25fd',
};
---

<BaseLayout
	title="Dragon Gems Swipe — bêta 1.0.1 | Ludiven Studio"
	description="La version 1.0.1 de Dragon Gems Swipe, à essayer avant son envoi aux stores."
	noindex
>
	<div class="wrapper beta-page stack gap-6">
		<header class="stack gap-2">
			<h1>Dragon Gems Swipe — bêta 1.0.1</h1>
			<p class="lead">La version qui part sur les stores, à essayer une dernière fois avant l'envoi. Elle s'installe à côté de l'appli du Play Store, sous le nom « Dragon Gems β », avec sa propre partie.</p>
		</header>

		<section class="card warn stack gap-3">
			<h2>Ce qui ne marche pas dans la bêta</h2>
			<ul>
				<li><strong>Les achats</strong> : Google Play ne connaît pas cette appli. Les boutons de la boutique restent grisés.</li>
				<li><strong>Les pubs</strong> : la bêta n'en montre aucune, même après « Accepter ». Chaque vidéo proposée est une vidéo de nos jeux et applis.</li>
				<li><strong>L'invite de mise à jour</strong> ne s'affiche pas.</li>
			</ul>
			<h2>Ce qui compte pour de vrai</h2>
			<ul>
				<li>Tes scores du défi du jour et du mode infini entrent dans le classement, celui du site.</li>
				<li>Connectée au même compte Google que l'appli du store, la bêta partage sa partie en ligne : ce que tu y fais compte aussi dans l'autre.</li>
			</ul>
		</section>

		<section class="card stack gap-3">
			<a class="download" href={APK.url}>Télécharger la bêta {APK.version}</a>
			<p class="muted">{(APK.size / 1e6).toFixed(1).replace('.', ',')} Mo · version {APK.version} (code {APK.code}) · commit <code>{APK.commit}</code></p>
			<p class="muted sha">SHA-256 : <code>{APK.sha256}</code></p>
		</section>

		<section class="stack gap-2">
			<h2>Installer sur Android</h2>
			<ol>
				<li>Ouvre cette page sur le téléphone et touche « Télécharger ».</li>
				<li>Ouvre le fichier téléchargé. Si Android bloque, autorise ton navigateur à installer des applis inconnues, puis réessaie.</li>
				<li>« Dragon Gems β » apparaît à côté de l'autre appli. Sa partie est à part : elle commence au niveau 1, sauf si tu te connectes à ton compte Google.</li>
				<li>Après le test, pour l'enlever : appui long sur son icône, puis « Désinstaller ».</li>
			</ol>
		</section>
	</div>
</BaseLayout>

<style>
	.beta-page {
		max-width: 40rem;
		margin-inline: auto;
	}
	.beta-page h1 {
		font-size: var(--text-3xl);
	}
	.beta-page h2 {
		font-size: var(--text-xl);
	}
	.lead,
	.muted {
		color: var(--gray-300);
	}
	.card {
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gray-999_40);
	}
	.warn {
		border-color: var(--accent-regular);
	}
	.download {
		display: inline-block;
		padding: 0.9rem 1.4rem;
		border-radius: 999px;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		font-weight: 600;
		text-decoration: none;
		text-align: center;
	}
	.download:hover,
	.download:focus-visible {
		background: var(--accent-dark);
	}
	.sha code {
		overflow-wrap: anywhere;
	}
	ol,
	ul {
		padding-inline-start: 1.25rem;
	}
	li + li {
		margin-top: 0.4rem;
	}
</style>
