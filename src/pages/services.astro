---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import LangSwitch from '../components/LangSwitch.astro';
import type { iconPaths } from '../components/IconPaths';

// Two tiers: the offers a client actually buys, then the finer work that comes with them.
const services: { icon: keyof typeof iconPaths; title: string; body: string }[] = [
	{ icon: 'code', title: 'Développement Unity', body: 'De l\'idée au produit livré : applications et jeux sous Unity — mobile, desktop et WebGL — avec un code pensé pour durer.' },
	{ icon: 'mobile', title: 'Applications mobiles iOS & Android', body: 'Vos applications développées sous Unity avec un vrai accès aux fonctions natives (capteurs, notifications, hors-ligne), puis publiées sur l\'App Store et Google Play : builds signés, certificats, fiches store et règles de validation.' },
	{ icon: 'virtual-reality', title: 'Réalité virtuelle / XR', body: 'Des expériences immersives VR/XR pour la formation, la simulation ou le jeu, sur casque comme sur mobile.' },
	{ icon: 'strategy', title: 'Multijoueur temps réel', body: 'Du temps réel qui tient la route : synchronisation, netcode, serveurs headless, avec Photon ou Netcode for GameObjects — du prototype à la production.' },
	{ icon: 'scales', title: 'Audit, reprise & optimisation', body: 'Audit, correction de bugs, montée de version et déblocage des problèmes tenaces. Puis les perfs : plus de fluidité, moins de mémoire, un build plus léger.' },
	{ icon: 'pencil-line', title: 'Formation & accompagnement', body: 'Sessions sur-mesure sur Unity et C#, encadrement technique, revues de code et suivi d\'alternants ou de développeurs juniors.' },
];

// Finer work, usually bundled with a prestation above rather than sold on its own.
const focused: { title: string; body: string }[] = [
	{ title: 'Structuration de projet', body: 'Architecture, organisation du code et bonnes pratiques pour un projet Unity qui reste sain.' },
	{ title: 'Gameplays & moteur physique', body: 'Des mécaniques originales conçues selon votre idée, collisions et simulations réglées finement.' },
	{ title: 'Interfaces & menus in-game', body: 'Des écrans clairs, réactifs et agréables à utiliser.' },
	{ title: 'AssetBundles & Addressables', body: 'Chargement et gestion des ressources à la demande, proprement.' },
	{ title: 'Outils internes & debug', body: 'Une boîte à outils maison et des raccourcis de test pour accélérer le développement et la QA.' },
	{ title: 'Localisation multilingue', body: 'Des textes prêts à être traduits et affichés en plusieurs langues.' },
	{ title: 'Sons & musiques', body: 'Intégration audio : SFX, musiques et réglages de volume.' },
];

const title = 'Services — Développement Unity, mobile, VR & multijoueur | Ludiven Studio';
const description = 'Prestations de développement Unity : applications mobiles, jeux, expériences VR/XR et multijoueur temps réel, de la conception à la mise en production. Développeur Unity depuis 2010, en France et à distance.';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Ludiven Studio',
	url: 'https://www.ludiven-studio.fr/services/',
	description,
	areaServed: { '@type': 'Country', name: 'France' },
	provider: { '@type': 'Organization', name: 'Ludiven Studio', url: 'https://www.ludiven-studio.fr/' },
	serviceType: [...services, ...focused].map((s) => s.title),
};
---

<BaseLayout title={title} description={description} altLang="/en/services/">
	<div class="stack gap-20">
		<main class="wrapper stack gap-12">
			<div class="stack gap-8">
				<LangSwitch lang="fr" href="/en/services/" />
				<Hero
					title="Services"
					tagline="Développeur Unity depuis 2010, je vous accompagne de la conception à la mise en production : applications, jeux et expériences immersives — en France comme à distance."
					align="start"
				/>
			</div>

			<section class="stack gap-4">
				<h2 class="section-title">Prestations</h2>
				<div class="box services">
					{services.map((s) => (
						<div class="stack gap-2 lg:gap-4">
							<Icon icon={s.icon} color="var(--accent-regular)" size="2.5rem" gradient />
							<h3>{s.title}</h3>
							<p>{s.body}</p>
						</div>
					))}
				</div>
			</section>

			<section class="stack gap-4">
				<h2 class="section-title">Interventions ciblées</h2>
				<div class="box focused">
					{focused.map((s) => (
						<div>
							<h3>{s.title}</h3>
							<p>{s.body}</p>
						</div>
					))}
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>

	<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
	.box {
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		padding: 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	.section-title {
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.services {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
	}

	.services h3 {
		font-size: var(--text-lg);
	}

	.focused {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.focused h3 {
		font-size: var(--text-md);
		color: var(--gray-0);
	}

	.services p,
	.focused p {
		color: var(--gray-400);
	}

	@media (min-width: 50em) {
		.box {
			border-radius: 1.5rem;
			padding: 2.5rem;
		}

		.services {
			grid-template-columns: repeat(2, 1fr);
			gap: 3rem 5rem;
		}

		.focused {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.75rem 5rem;
		}
	}
</style>
