---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

// The whole hub. Adding a service = adding one entry here.
// Not "Services": /services is the Unity B2B offer, and two "Services…" tabs
// side by side in the nav would be unreadable.
const tools: { emoji: string; title: string; pitch: string; href: string; note: string }[] = [
	{
		emoji: '🛒',
		title: 'Mes courses',
		pitch: "Une liste de courses partagée entre plusieurs téléphones, rangée par rayon. Elle se met à jour en direct pendant que l'autre fait les courses.",
		href: '/courses',
		note: 'Sans inscription · lien à partager',
	},
	{
		emoji: '🎯',
		title: 'Rencontres pétanque',
		pitch: "La carte des parties de pétanque autour de toi. Vois qui joue, quand, et combien il manque de joueurs — ou pose la tienne en deux minutes.",
		href: '/rencontres',
		note: 'Sans inscription · Isère et alentours',
	},
];

const title = 'Outils en ligne gratuits, sans inscription | Ludiven Studio';
const description = "Des petits services web gratuits et utilisables sans compte : liste de courses partagée, carte des parties de pétanque près de chez vous.";
---

<BaseLayout title={title} description={description}>
	<div class="stack gap-20">
		<main class="wrapper stack gap-12">
			<Hero
				title="Outils"
				tagline="Des petits services en ligne, gratuits et sans inscription. Tu ouvres le lien, tu t'en sers, c'est tout."
				align="start"
			/>

			<div class="tools">
				{tools.map((t) => (
					<a class="tool" href={t.href}>
						<span class="tool-emoji" aria-hidden="true">{t.emoji}</span>
						<h2>{t.title}</h2>
						<p>{t.pitch}</p>
						<span class="tool-note">{t.note}</span>
					</a>
				))}
			</div>

			<p class="tools-more">
				D'autres outils arriveront ici au fil de l'eau. Une idée&nbsp;?
				<a href="/about#contact">Dis-la-moi</a>.
			</p>
		</main>
	</div>
</BaseLayout>

<style>
	.tools {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: 1fr;
	}

	.tool {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.75rem;
		border-radius: 0.9rem;
		background: var(--gray-999_40);
		border: 1px solid var(--gray-800);
		box-shadow: var(--shadow-sm);
		color: var(--gray-300);
		text-decoration: none;
		transition:
			border-color var(--theme-transition),
			box-shadow var(--theme-transition),
			transform var(--theme-transition);
	}

	.tool:hover,
	.tool:focus-visible {
		border-color: var(--accent-regular);
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
	}

	.tool-emoji {
		font-size: 2.25rem;
		line-height: 1;
	}

	.tool h2 {
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.tool p {
		margin: 0;
		line-height: 1.5;
	}

	.tool-note {
		margin-top: auto;
		padding-top: 0.5rem;
		font-size: var(--text-sm);
		color: var(--accent-regular);
	}

	.tools-more {
		color: var(--gray-400);
		font-size: var(--text-sm);
	}

	@media (min-width: 50em) {
		.tools {
			grid-template-columns: repeat(2, 1fr);
			gap: 2rem;
		}
	}
</style>
