---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoursesApp from '../components/courses/CoursesApp';
---

<BaseLayout
	title="Liste de courses"
	description="Liste de courses partagée."
	noindex
>
	<div class="wrapper">
		<CoursesApp client:only="react" />
	</div>
</BaseLayout>

<style is:global>
	.co-root {
		max-width: 640px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.co-intro,
	.co-empty,
	.co-error {
		color: var(--gray-300);
		line-height: 1.5;
	}
	.co-empty { text-align: center; padding: 2rem 0; }
	.co-error {
		color: #ffb4b4;
		background: rgba(255, 80, 80, 0.12);
		border-radius: 0.6rem;
		padding: 0.6rem 0.9rem;
		cursor: pointer;
	}

	/* ---- Buttons & inputs ---- */
	.co-btn {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		color: var(--gray-100);
		background: var(--gray-800, #232739);
		border: 1px solid var(--gray-700, #343a52);
		border-radius: 0.6rem;
		padding: 0.5rem 0.85rem;
		cursor: pointer;
		white-space: nowrap;
	}
	.co-btn:hover:not(:disabled),
	.co-btn:focus-visible {
		border-color: var(--accent-regular);
		color: var(--accent-regular);
	}
	.co-btn:disabled { opacity: 0.45; cursor: default; }
	.co-btn-primary {
		background: var(--accent-regular);
		border-color: var(--accent-regular);
		color: var(--accent-text-over, #fff);
		font-weight: 600;
	}
	.co-btn-primary:hover:not(:disabled) { color: var(--accent-text-over, #fff); filter: brightness(1.08); }
	.co-icon { padding: 0.5rem 0.7rem; font-size: 1.1rem; line-height: 1; }
	.co-big { align-self: center; font-size: var(--text-lg); padding: 0.8rem 1.6rem; }

	.co-in {
		font-family: var(--font-body);
		font-size: 1rem; /* >=16px so iOS Safari doesn't zoom on focus */
		color: var(--gray-100);
		background: var(--gray-999, #13151f);
		border: 1px solid var(--gray-700, #343a52);
		border-radius: 0.6rem;
		padding: 0.65rem 0.8rem;
	}
	.co-in:focus-visible { outline: none; border-color: var(--accent-regular); }

	/* ---- Header ---- */
	.co-head {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-wrap: wrap;
	}
	.co-head h1 { font-size: var(--text-2xl); margin: 0; }
	.co-title-row { display: flex; align-items: center; gap: 0.6rem; flex: 1; }
	.co-tools { display: flex; gap: 0.4rem; margin-left: auto; }
	.co-peer {
		font-size: var(--text-sm);
		color: #7ee0a0;
		font-family: var(--font-brand);
	}

	/* ---- Add row ---- */
	.co-add { display: flex; gap: 0.5rem; }
	.co-in-label { flex: 1; min-width: 0; }
	.co-in-qty { width: 4.5rem; text-align: center; }

	/* ---- Item list ---- */
	.co-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.35rem; }
	.co-row {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.6rem 0.7rem;
		background: var(--gray-999, #13151f);
		border: 1px solid var(--gray-800, #232739);
		border-radius: 0.6rem;
	}
	.co-row-static { padding-left: 0.9rem; }
	.co-label { flex: 1; min-width: 0; color: var(--gray-100); word-break: break-word; }
	.co-qty {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		color: var(--gray-300);
		background: var(--gray-800, #232739);
		border-radius: 0.4rem;
		padding: 0.15rem 0.5rem;
	}
	.co-row-done .co-label { text-decoration: line-through; color: var(--gray-400, #6a7290); }
	.co-row-done { opacity: 0.7; }

	.co-check { position: relative; display: inline-flex; cursor: pointer; }
	.co-check input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
	.co-box {
		width: 1.5rem; height: 1.5rem;
		border: 2px solid var(--gray-600, #4a5170);
		border-radius: 0.45rem;
		display: inline-block;
		transition: background 0.12s, border-color 0.12s;
	}
	.co-check input:checked + .co-box {
		background: var(--accent-regular);
		border-color: var(--accent-regular);
	}
	.co-check input:checked + .co-box::after {
		content: '✓';
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		font-size: 1rem;
		font-weight: 700;
	}
	.co-del {
		background: none;
		border: none;
		color: var(--gray-500, #565e7d);
		font-size: 1.4rem;
		line-height: 1;
		cursor: pointer;
		padding: 0 0.2rem;
	}
	.co-del:hover { color: #ff8080; }

	/* ---- Sections (aisles) ---- */
	.co-sections { display: flex; flex-direction: column; gap: 0.9rem; }
	.co-sec { display: flex; flex-direction: column; gap: 0.35rem; }
	.co-sec-head {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--gray-200);
		background: none;
		border: none;
		border-bottom: 1px solid var(--gray-800, #232739);
		padding: 0.2rem 0.1rem 0.4rem;
		/* Empty aisles keep their header so nothing jumps when a drag starts,
		   and so the header stays a big enough drop target. */
		min-height: 2.2rem;
		cursor: pointer;
		text-align: left;
	}
	.co-sec-static { cursor: default; }
	.co-sec-head:hover:not(.co-sec-static) { color: var(--accent-regular); }
	.co-caret { color: var(--gray-400, #6a7290); font-size: 0.8rem; width: 0.8rem; }
	.co-sec-name { flex: 1; }
	.co-sec-count { color: var(--gray-400, #6a7290); font-weight: 400; }
	.co-sec-collapsed { opacity: 0.65; }
	/* Dashed while dragging: shows where you can drop without moving anything. */
	.co-sec-drop { border-bottom-style: dashed; border-bottom-color: var(--accent-regular); }

	/* ---- Empty aisles, as a compact strip of drop targets ---- */
	.co-shelf { display: flex; flex-direction: column; gap: 0.4rem; }
	.co-shelf-title {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		color: var(--gray-400, #6a7290);
	}
	.co-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
	.co-chip {
		font-size: var(--text-sm);
		color: var(--gray-300);
		background: var(--gray-999, #13151f);
		border: 1px solid var(--gray-800, #232739);
		border-radius: 999px;
		padding: 0.35rem 0.7rem;
	}
	.co-shelf-active .co-shelf-title { color: var(--accent-regular); }
	.co-shelf-active .co-chip { border-style: dashed; border-color: var(--accent-regular); }

	/* ---- Drag handle ---- */
	.co-grip {
		color: var(--gray-500, #565e7d);
		font-size: 1.1rem;
		line-height: 1;
		cursor: grab;
		padding: 0.35rem 0.15rem;
		/* Required by usePointerDrag: without it iOS scrolls the page instead. */
		touch-action: none;
		user-select: none;
	}
	.co-grip:active { cursor: grabbing; }
	.co-dragging {
		border-color: var(--accent-regular);
		box-shadow: 0 6px 18px rgb(0 0 0 / 0.18);
		opacity: 0.9;
	}
	.co-label-btn {
		background: none;
		border: none;
		font: inherit;
		text-align: left;
		cursor: pointer;
		padding: 0;
	}
	.co-label-btn:hover { color: var(--accent-regular); }

	/* The whole middle of a row opens the editor: a label-sized tap target is
	   too easy to miss on a phone. */
	.co-main {
		flex: 1;
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.2rem 0;
	}
	.co-main .co-label { flex: 1; }
	.co-qty-empty { color: var(--gray-500, #565e7d); background: none; padding-left: 0; }
	.co-pencil { color: var(--gray-500, #565e7d); font-size: 0.9rem; }
	.co-main:hover .co-pencil,
	.co-main:focus-visible .co-pencil { color: var(--accent-regular); }

	/* ---- Modal sheet ---- */
	.co-modal {
		position: fixed;
		inset: 0;
		background: rgb(0 0 0 / 0.45);
		display: flex;
		align-items: flex-end;
		justify-content: center;
		z-index: 50;
		padding: 1rem;
	}
	.co-sheet {
		background: var(--gray-999, #13151f);
		border: 1px solid var(--gray-700, #343a52);
		border-radius: 0.9rem;
		padding: 1.1rem;
		width: 100%;
		max-width: 420px;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-bottom: env(safe-area-inset-bottom, 0);
	}
	.co-sheet h2 { font-size: var(--text-lg); margin: 0; }
	.co-field { display: flex; flex-direction: column; gap: 0.25rem; }
	.co-field > span { font-size: var(--text-sm); color: var(--gray-300); }
	.co-sheet-actions { display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.2rem; }
	.co-note { font-size: var(--text-sm); color: var(--gray-400, #6a7290); line-height: 1.4; margin: 0; }

	@media (min-width: 40em) {
		.co-modal { align-items: center; }
	}

	/* ---- Footer ---- */
	.co-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		flex-wrap: wrap;
		border-top: 1px solid var(--gray-800, #232739);
		padding-top: 0.9rem;
	}
	.co-count { color: var(--gray-300); font-size: var(--text-sm); }
	.co-foot-actions { display: flex; gap: 0.4rem; margin-left: auto; }

	/* ---- Recents / history ---- */
	.co-recents { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 1rem; }
	.co-recents h2 { font-size: var(--text-md); color: var(--gray-200); }
	.co-recent, .co-hrow {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		padding: 0.7rem 0.9rem;
		background: var(--gray-999, #13151f);
		border: 1px solid var(--gray-800, #232739);
		border-radius: 0.6rem;
		text-decoration: none;
		color: var(--gray-100);
		cursor: pointer;
	}
	.co-recent:hover, .co-hrow:hover { border-color: var(--accent-regular); }
	.co-recent small, .co-hrow small { color: var(--gray-400, #6a7290); }
	.co-hmain { display: flex; flex-direction: column; gap: 0.15rem; }
	.co-hlabel { color: var(--gray-100); }
	.co-hcount { color: var(--gray-300); font-size: var(--text-sm); white-space: nowrap; }
</style>
