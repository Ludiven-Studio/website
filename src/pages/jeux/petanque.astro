---
import GamePage from '../../layouts/GamePage.astro';
import PetanqueGame from '../../games/petanque/PetanqueGame.tsx';
---

<GamePage
	title="Pétanque | Jeux Ludiven Studio"
	description="Pétanque 3D en tête-à-tête, 13 points : pose le doigt sur la planche d'envol pour choisir ton angle, glisse pour doser, et compose avec le relief et les graviers du terrain."
	heading="Pétanque"
	tagline="Pose le doigt à la hauteur de l'angle, glisse pour doser — premier à 13"
	gameId="petanque"
	fullscreen="auto"
>
	<PetanqueGame client:only="react" gameId="petanque" />
	<p class="pe-scanner">
		<span data-pe-lang="scanner-pre">Vous jouez pour de vrai ?</span> <a href="/petanque-scanner/">Pétanque Scanner</a>
		<span data-pe-lang="scanner-post">mesure vos points au téléphone.</span>
	</p>
</GamePage>

<script>
	// The page around the island follows the language picked in the game (see lib/gameLang).
	const TEXT: Record<string, Record<string, string>> = {
		fr: {
			'scanner-pre': 'Vous jouez pour de vrai ?',
			'scanner-post': 'mesure vos points au téléphone.',
			tagline: 'Pose le doigt à la hauteur de l’angle, glisse pour doser — premier à 13',
		},
		en: {
			'scanner-pre': 'Playing for real?',
			'scanner-post': 'measures your points with your phone.',
			tagline: 'Put your finger at the height of the angle, slide to set the power — first to 13',
		},
		es: {
			'scanner-pre': '¿Juegas de verdad?',
			'scanner-post': 'mide tus puntos con el móvil.',
			tagline: 'Pon el dedo a la altura del ángulo y desliza para dosificar — gana quien llega a 13',
		},
	};
	const apply = (lang: string): void => {
		const t = TEXT[lang] ?? TEXT.fr;
		document.querySelectorAll<HTMLElement>('[data-pe-lang]').forEach((el) => {
			el.textContent = t[el.dataset.peLang ?? ''] ?? el.textContent;
		});
		const pitch = document.querySelector<HTMLElement>('.game-pitch');
		if (pitch) pitch.textContent = t.tagline;
	};
	document.addEventListener('ludiven:lang', (e) => apply((e as CustomEvent<string>).detail));
	if (document.documentElement.lang !== 'fr') apply(document.documentElement.lang);
</script>

<style>
	.pe-scanner {
		margin: 1.4rem auto 0;
		text-align: center;
		font-size: 0.9rem;
		opacity: 0.7;
	}
	/* Fullscreen only hides .game-head and .game-foot, so this one has to opt out itself. */
	:global(.game-page.gf-full) .pe-scanner {
		display: none;
	}
	/* The leaderboard pill is pinned bottom-right by LeaderboardCorner, which is the corner the
	   launch board now owns — a hit test over the board found it stealing presses there. Lifted
	   clear of the board and sent to the other side, because the action row already took the right.
	   Global because the pill is not in this template, but this stylesheet only ships on this page. */
	:global(.game-page.gf-full .lbc-root.lbc-side) {
		right: auto;
		left: max(12px, env(safe-area-inset-left));
		align-items: flex-start;
		bottom: calc(max(12px, env(safe-area-inset-bottom)) + clamp(110px, 30vh, 200px) + 40px);
	}
</style>
