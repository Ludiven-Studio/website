---
// Throwaway diagnostic page: the fullscreen overlay vanishes on iOS and no desktop engine
// reproduces it, so measure it on the device instead. Lives under /jeux/ on purpose — that is
// what makes BaseLayout inject the real GameFullscreen component, so this tests the shipped
// mechanism, not a copy of it. This page is the CONTROL: bare markup, no island, no key art.
// The same panel rides on every real game page behind ?diag. Delete once the iOS bug is understood.
import BaseLayout from '../../layouts/BaseLayout.astro';
import FullscreenDiag from '../../components/FullscreenDiag.astro';
---

<BaseLayout title="Diagnostic plein écran" description="Page de test interne." noindex={true}>
	<FullscreenDiag always={true} />

	<div class="wrapper game-page stack gap-4">
		<header class="game-head">
			<h1>Diagnostic</h1>
		</header>
		<div class="dg-fake">
			<p>ZONE DE JEU</p>
			<p>Si tu lis ceci en plein écran, le calque fonctionne.</p>
		</div>
		<footer class="game-foot stack gap-3">
			<p>pied de page</p>
		</footer>
	</div>
</BaseLayout>

<style>
	.dg-fake {
		background: #7c3aed;
		color: #fff;
		font-weight: 700;
		padding: 2rem 1rem;
		border-radius: 12px;
		width: 100%;
		text-align: center;
	}
</style>
