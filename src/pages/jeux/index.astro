---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import GameFold from '../../components/GameFold.astro';
import GameSearch from '../../components/GameSearch.astro';
import GameFavorites from '../../components/GameFavorites.astro';
import GameTileSize from '../../components/GameTileSize.astro';
import SuggestionForm from '../../components/SuggestionForm.astro';
import CocoinBar from '../../components/CocoinBar';
import CocoinToast from '../../components/CocoinToast';
import { games, type GameTile } from '../../data/games';
import { fetchPlayRows, rankPlayed } from '../../lib/popular';

const NUM_FR = ['zéro', 'un', 'deux', 'trois', 'quatre', 'cinq', 'six', 'sept', 'huit', 'neuf', 'dix', 'onze', 'douze', 'treize', 'quatorze', 'quinze', 'seize'];
const playable = games.filter((g) => g.status === 'play').length;
const playableLabel = NUM_FR[playable]
	? NUM_FR[playable].charAt(0).toUpperCase() + NUM_FR[playable].slice(1)
	: String(playable);

// Collapsible category sections — fold ids/state shared with /jeux/defi.
const CATEGORIES = [
	// Story games, first: they are played over several sessions, not one grid.
	{ id: 'aventure', title: '🗺️ Aventures' },
	{ id: 'maths', title: '🧮 Jeux mathématiques' },
	{ id: 'grilles', title: '🔲 Jeux de grilles' },
	{ id: 'logique', title: '🧩 Jeux de logique' },
	{ id: 'mots', title: '🔤 Jeux de mots' },
	{ id: 'adresse', title: "🎯 Jeux d'adresse" },
	{ id: 'illusions', title: "👁️ Illusions d'optique" },
	{ id: 'multi', title: '⚽ Jeux multis' },
] as const;
// Sections whose tiles carry no daily-challenge pips.
const NO_DAILY: string[] = ['illusions', 'multi'];
const byCategory = CATEGORIES.map((c) => ({
	...c,
	games: games.filter((g) => (g.category ?? 'logique') === c.id),
})).filter((c) => c.games.length > 0);
const card = (g: GameTile) => ({
	id: g.id,
	title: g.title,
	pitch: g.pitch,
	icon: g.icon,
	href: g.href,
	status: g.status,
	image: g.image,
	daily: !NO_DAILY.includes(g.category ?? 'logique'),
	favorite: true,
	art: true,
});

// Shortcut sections, above the categories that still hold every game.
const live = games.filter((g) => g.status === 'play');
const SHORTLIST = 5;
const fresh = [...live].sort((a, b) => b.added.localeCompare(a.added)).slice(0, SHORTLIST);
// Most played over the last 30 days, read at build time: it moves with each deploy.
const POPULAR_DAYS = 30;
const playRows = await fetchPlayRows(POPULAR_DAYS);
if (!playRows) console.warn('[jeux] game_scores unreachable: no « Top 5 » in this build');
const byId = new Map(live.map((g) => [g.id, g]));
const top = rankPlayed(playRows ?? [], [...byId.keys()])
	.slice(0, SHORTLIST)
	.map((id) => byId.get(id)!);
---

<BaseLayout
	title="Mini-jeux | Ludiven Studio"
	description="Une collection de mini-jeux de logique et d'adresse à entraîner chaque jour, signés Ludiven Studio."
>
	<div class="wrapper stack gap-8 lg:gap-20">
		<header class="games-hero stack gap-2 lg:gap-4">
			<h1>Mini-jeux</h1>
			<p>
				Des mini-jeux pensés pour aiguiser ta logique ou tes réflexes en quelques minutes.
				{playableLabel} à découvrir — et d'autres arrivent.
			</p>
			<ul class="games-promise" aria-label="Nos engagements">
				<li>🆓 Gratuit</li>
				<li>🚫 Sans publicité</li>
				<li>🔓 Sans inscription</li>
			</ul>
			<a class="games-defi-cta" href="/jeux/defi/">🏆 Défis du jour</a>
				<p class="games-streak" id="games-streak" hidden></p>
		</header>

			<div class="games-wallet"><CocoinBar client:load /></div>
			<CocoinToast client:idle />

		<div class="games-sections stack gap-4" data-tiles="grid">
			<div class="games-tools">
				<GameSearch total={games.length} />
				<GameTileSize />
			</div>
			<GameFold id="nouveautes" title="🆕 Nouveautés" count={fresh.length} extra>
				<ul class="games-grid short">
					{fresh.map((g) => <li><GameCard {...card(g)} /></li>)}
				</ul>
			</GameFold>
			{
				top.length > 0 && (
					<GameFold id="top" title={`🔥 Top ${top.length}`} count={top.length} meta={`les plus joués sur ${POPULAR_DAYS} jours`} extra>
						<ol class="games-grid short ranked">
							{top.map((g) => <li><GameCard {...card(g)} /></li>)}
						</ol>
					</GameFold>
				)
			}
			<GameFold id="favoris" title="⭐ Favoris" count={0} hidden extra>
				<ul class="games-grid" data-fav-grid></ul>
			</GameFold>
			<GameFavorites />
			{
				byCategory.map((c) => (
					<GameFold id={c.id} title={c.title} count={c.games.length}>
						<ul class="games-grid">
							{c.games.map((g) => <li><GameCard {...card(g)} /></li>)}
						</ul>
					</GameFold>
				))
			}
		</div>

		<SuggestionForm />

		<p class="games-note">
			Des mini-jeux de logique développés par Ludiven Studio, librement inspirés de grands
			classiques du genre. Sans affiliation avec leurs éditeurs respectifs.
		</p>
	</div>
</BaseLayout>

<style>
	.games-note {
		text-align: center;
		max-width: 60ch;
		margin-inline: auto;
		color: var(--gray-400);
		font-size: var(--text-sm);
	}

	.games-hero {
		text-align: center;
		max-width: 50ch;
		margin-inline: auto;
		color: var(--gray-300);
		font-size: var(--text-md);
	}

	.games-hero h1 {
		font-size: var(--text-3xl);
	}

	.games-promise {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		justify-content: center;
		padding: 0;
		margin: 0.25rem 0 0;
	}
	.games-promise li {
		background: var(--gray-999);
		border: 1px solid var(--gray-800);
		border-radius: 999px;
		padding: 5px 13px;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--gray-100);
	}
	.games-defi-cta {
		align-self: center;
		margin-top: 0.5rem;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		font-family: var(--font-brand);
		font-weight: 700;
		font-size: var(--text-md);
		text-decoration: none;
		border-radius: 999px;
		padding: 10px 22px;
		box-shadow: var(--shadow-md);
		transition: filter var(--theme-transition);
	}
	.games-defi-cta:hover,
	.games-defi-cta:focus-visible {
		filter: brightness(1.06);
	}

	.games-streak {
		align-self: center;
		margin-top: 0.6rem;
		font-weight: 800;
		font-size: var(--text-md);
		color: var(--gray-0);
		background: rgba(245, 166, 35, 0.14);
		border: 1px solid rgba(245, 166, 35, 0.5);
		border-radius: 999px;
		padding: 7px 18px;
	}
	.games-streak .games-streak-note {
		font-weight: 600;
		color: var(--gray-200);
	}

	.games-wallet {
		display: flex;
		justify-content: center;
	}

	.games-tools {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: center;
		gap: 0.75rem;
	}

	.games-tools > :global(.game-search) {
		margin-inline: 0;
	}

	.games-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	/* Four icons a row on a phone, like its home screen: five cut the names. */
	[data-tiles='icon'] .games-grid {
		grid-template-columns: repeat(auto-fill, minmax(4.5rem, 1fr));
		gap: 0.9rem 0.6rem;
	}

	[data-tiles='list'] .games-grid {
		grid-template-columns: 1fr;
		gap: 0.6rem;
	}

	/* The Top's rank, on the tile's corner whatever its size. */
	.games-grid.ranked {
		counter-reset: rank;
	}
	.games-grid.ranked > li {
		position: relative;
		counter-increment: rank;
	}
	.games-grid.ranked > li::before {
		content: counter(rank);
		position: absolute;
		top: -0.4rem;
		left: -0.4rem;
		z-index: 2;
		display: grid;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 999px;
		background: var(--accent-regular);
		color: var(--accent-text-over);
		font-family: var(--font-brand);
		font-weight: 800;
		font-size: 0.85rem;
		box-shadow: var(--shadow-sm);
		pointer-events: none;
	}

	@media (min-width: 50em) {
		.games-hero {
			font-size: var(--text-lg);
		}

		.games-hero h1 {
			font-size: var(--text-4xl);
		}

		.games-grid {
			grid-template-columns: repeat(4, 1fr);
			gap: 1rem;
		}

		/* The five of a shortcut on one row, instead of four and a lone one. */
		[data-tiles='grid'] .games-grid.short {
			grid-template-columns: repeat(5, 1fr);
		}

		[data-tiles='icon'] .games-grid {
			grid-template-columns: repeat(auto-fill, minmax(5.75rem, 1fr));
			gap: 1.1rem 0.9rem;
		}

		[data-tiles='list'] .games-grid {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
	}
</style>

<script>
	import { activityStreak } from '../../lib/streak';

	const el = document.getElementById('games-streak');
	const refresh = () => {
		if (!el) return;
		el.hidden = false;
		const s = activityStreak();
		if (s.count > 0) {
			const note = s.atRisk ? ' <span class="games-streak-note">· joue aujourd\'hui pour la garder</span>' : '';
			el.innerHTML = `🔥 ${s.count} jour${s.count > 1 ? 's' : ''} d'affilée${note}`;
		} else {
			el.innerHTML = `🔥 <span class="games-streak-note">Joue un jeu aujourd'hui pour lancer ta série</span>`;
		}
	};
	refresh();
	document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
	window.addEventListener('pageshow', refresh);
</script>
