---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import GameFold from '../../components/GameFold.astro';
import GameTools from '../../components/GameTools.astro';
import GameFavorites from '../../components/GameFavorites.astro';
import Icon from '../../components/Icon.astro';
import CocoinBar from '../../components/CocoinBar';
import CocoinToast from '../../components/CocoinToast';
import { games, newest, type GameTile } from '../../data/games';
import { POPULAR_DAYS, topPlayed } from '../../lib/popular';

// Every playable game now has a daily challenge (Pong & Foot race the AI to 3), so the
// hub lists them all — same count as the /jeux catalogue.
const dailyGames = games.filter((g) => g.status === 'play');

// Collapsible category sections (42 games is too long for one flat grid).
const CATEGORIES = [
	{ id: 'maths', title: '🧮 Maths' },
	{ id: 'grilles', title: '🔲 Grilles' },
	{ id: 'logique', title: '🧩 Logique' },
	{ id: 'mots', title: '🔤 Mots' },
	{ id: 'adresse', title: '🎯 Adresse' },
	{ id: 'multi', title: '⚽ Duels' },
] as const;
const byCategory = CATEGORIES.map((c) => ({
	...c,
	games: dailyGames.filter((g) => (g.category ?? 'logique') === c.id),
})).filter((c) => c.games.length > 0);
const card = (g: GameTile) => ({ id: g.id, title: g.title, pitch: g.pitch, icon: g.icon, href: `${g.href}?defi`, status: g.status, compact: true });

// Shortcut sections, from the challenges this page lists: copies, every game stays in its category.
const listed = byCategory.flatMap((c) => c.games);
const SHORTLIST = 5;
const fresh = newest(listed, SHORTLIST);
const byId = new Map(listed.map((g) => [g.id, g]));
const top = (await topPlayed([...byId.keys()], SHORTLIST, POPULAR_DAYS)).map((id) => byId.get(id)!);
---

<BaseLayout
	title="Défis du jour | Jeux Ludiven Studio"
	description="Le défi du jour : chaque jour, le même niveau pour tout le monde. Fais ton meilleur score, compare-toi au classement et partage. Gratuit, sans pub, sans inscription."
>
	<div class="wrapper stack gap-8">
		<header class="defi-hero stack gap-3">
			<a class="back" href="/jeux/">
				<Icon icon="arrow-left" size="1em" /> Tous les jeux
			</a>
			<h1>🏆 Défis du jour</h1>
			<p>
				Chaque jour, le <strong>même niveau pour tout le monde</strong>. Fais ton meilleur score,
				compare-toi au classement et <strong>partage-le</strong> — le lien ouvre directement le défi.
				Ton <strong>record du jour</strong> s'affiche sur chaque jeu.
			</p>
			<ul class="games-promise" aria-label="Nos engagements">
				<li>🆓 Gratuit</li>
				<li>🚫 Sans publicité</li>
				<li>🔓 Sans inscription</li>
			</ul>
			<p class="defi-streak" id="defi-streak" hidden></p>
			<p class="defi-count" id="defi-count" aria-live="polite"></p>
			<CocoinBar client:load />
		</header>
		<CocoinToast client:idle />

		<div class="defi-sections stack gap-4" data-tiles="grid">
			<GameTools total={listed.length} />
			<GameFold id="nouveautes" title="🆕 Nouveautés" count={fresh.length} extra>
				<ul class="defi-grid">
					{fresh.map((g) => <li><GameCard {...card(g)} /></li>)}
				</ul>
			</GameFold>
			{
				top.length > 0 && (
					<GameFold id="top" title={`🔥 Top ${top.length}`} count={top.length} meta={`les plus joués sur ${POPULAR_DAYS} jours`} extra>
						<ol class="defi-grid ranked">
							{top.map((g) => <li><GameCard {...card(g)} /></li>)}
						</ol>
					</GameFold>
				)
			}
			<GameFold id="favoris" title="⭐ Favoris" count={0} hidden extra>
				<ul class="defi-grid" data-fav-grid></ul>
			</GameFold>
			<GameFavorites />
			{
				byCategory.map((c) => (
					<GameFold id={c.id} title={c.title} count={c.games.length}>
						<ul class="defi-grid">
							{c.games.map((g) => <li><GameCard {...card(g)} /></li>)}
						</ul>
					</GameFold>
				))
			}
		</div>
	</div>
</BaseLayout>

<style>
	/* The page's head: a night card, as the homepage's stage. */
	.defi-hero {
		align-items: center;
		width: 100%;
		max-width: 73rem;
		margin-inline: auto;
		padding: 1.75rem 1.25rem 2rem;
		border-radius: 1.75rem;
		background: var(--sc-night-surface);
		color: var(--sc-night-muted);
		font-size: var(--text-md);
		text-align: center;
	}
	.defi-hero > p {
		max-width: 54ch;
	}
	.defi-hero h1 {
		font-size: var(--text-3xl);
		color: #fff;
	}
	.defi-hero strong {
		color: var(--sc-night-ink);
	}
	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--sc-night-link);
		text-decoration: none;
		font-family: var(--font-brand);
		font-weight: 500;
		font-size: var(--text-sm);
	}
	.back:hover,
	.back:focus-visible {
		color: var(--sc-night-ink);
	}
	.games-promise li {
		background: var(--sc-night-surface-2);
		border: 1px solid var(--sc-night-line);
		border-radius: 999px;
		padding: 5px 13px;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--sc-night-ink);
	}
	.defi-count {
		font-weight: 700;
		color: var(--sc-gold);
		font-size: var(--text-md);
		margin-top: 0.35rem;
	}
	.defi-streak {
		align-self: center;
		font-weight: 800;
		font-size: var(--text-md);
		color: var(--sc-night-ink);
		background: rgb(255 201 77 / 0.14);
		border: 1px solid rgb(255 201 77 / 0.5);
		border-radius: 999px;
		padding: 6px 16px;
		margin-top: 0.35rem;
	}
	@media (min-width: 50em) {
		.defi-hero {
			padding: 2.25rem 2rem 2.5rem;
		}
	}

	.back:hover,
	.back:focus-visible {
		color: var(--sc-accent);
	}
	.games-promise {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		justify-content: center;
		padding: 0;
		margin: 0.25rem 0 0;
	}
	.defi-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(158px, 1fr));
		gap: 0.85rem;
	}

	/* Four icons a row on a phone, like its home screen. */
	[data-tiles='icon'] .defi-grid {
		grid-template-columns: repeat(auto-fill, minmax(4.5rem, 1fr));
		gap: 0.9rem 0.6rem;
	}

	[data-tiles='list'] .defi-grid {
		grid-template-columns: 1fr;
		gap: 0.6rem;
	}

	@media (min-width: 50em) {
		[data-tiles='icon'] .defi-grid {
			grid-template-columns: repeat(auto-fill, minmax(5.75rem, 1fr));
			gap: 1.1rem 0.9rem;
		}
	}

	.defi-streak .defi-streak-note {
		font-weight: 600;
		color: var(--sc-ink-2);
	}
</style>

<script>
	import { globalStreak } from '../../lib/streak';
	import { challengeDay } from '../../lib/day';

	const grids = Array.from(document.querySelectorAll<HTMLElement>('.defi-grid'));
	const counter = document.getElementById('defi-count');
	const streakEl = document.getElementById('defi-streak');

	const refreshStreak = () => {
		if (!streakEl) return;
		const s = globalStreak();
		if (s.count > 0) {
			streakEl.hidden = false;
			const note = s.atRisk ? ' <span class="defi-streak-note">· joue aujourd\'hui pour la garder</span>' : '';
			streakEl.innerHTML = `🔥 ${s.count} jour${s.count > 1 ? 's' : ''} d'affilée${note}`;
		} else {
			streakEl.hidden = true;
		}
	};

	const refresh = () => {
		refreshStreak();
		const day = challengeDay();
		let done = 0, total = 0;
		for (const grid of grids) {
			const lis = Array.from(grid.children) as HTMLElement[];
			let sectionDone = 0;
			const items = lis.map((li, i) => {
				const id = li.querySelector('[data-game-id]')?.getAttribute('data-game-id');
				let s = 0; // 0 = à faire, 1 = en cours, 2 = fait
				try {
					const raw = id ? localStorage.getItem(`ludiven-dailyrun-${id}-${day}`) : null;
					if (raw) s = JSON.parse(raw)?.done === true ? 2 : 1;
				} catch { /* ignore */ }
				li.classList.toggle('is-done', s === 2);
				li.classList.toggle('is-progress', s === 1);
				if (s === 2) sectionDone++;
				return { li, s, i };
			});
			// à faire → en cours → fait (stable within a group); the Top keeps its rank order.
			if (!grid.classList.contains('ranked')) {
				items.sort((a, b) => a.s - b.s || a.i - b.i);
				for (const { li } of items) grid.appendChild(li);
			}
			// The shortcut sections hold copies of games already counted in their category.
			if (!grid.closest('[data-fold-extra]')) {
				done += sectionDone;
				total += lis.length;
			}
			// Per-section progress in the fold header ("3/12 faits").
			const meta = grid.closest('.game-fold')?.querySelector('[data-fold-meta]');
			if (meta) meta.textContent = sectionDone === lis.length
				? '✓ tout fait'
				: `${sectionDone}/${lis.length} fait${sectionDone > 1 ? 's' : ''}`;
		}
		const todo = total - done;
		if (counter) counter.textContent = todo === 0
			? '🎉 Tous les défis du jour sont faits !'
			: `${todo} défi${todo > 1 ? 's' : ''} à faire aujourd'hui · ${done}/${total} fait${done > 1 ? 's' : ''}`;
	};

	refresh();
	document.addEventListener('favorites-applied', refresh); // the favorites fold was refilled
	document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
	window.addEventListener('pageshow', refresh);
</script>
