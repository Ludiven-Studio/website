---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout
	title="Mentions légales | Ludiven Studio"
	description="Mentions légales du site Ludiven Studio : éditeur, hébergeur, propriété intellectuelle et licences des composants tiers."
	noindex
